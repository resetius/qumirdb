(query
  (select
    (select-list
      (item
        ca_zip
      )
    )
    (from
      (table customer_address)
    )
    (where
      (block
        (var __qdb_sql_in = (call substr ca_zip 1 5))
        (|| (== __qdb_sql_in (: (cast "89436" <named StringView>) <named StringView>))
          (== __qdb_sql_in (: (cast "30868" <named StringView>) <named StringView>))))
    )
  )
)
