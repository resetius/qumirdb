(rel project
  (rel aggregate
    (rel project (rel source "t") (v v) (arg_0 (* v v)) (__group__ 1))
    (keys __group__)
    (agg sum_0 sum v)
    (agg sum_1 sum arg_0)
    (agg count_2 count v))
  (s (if
      (< count_2 2)
      (call qdb_sql_null)
      (call qdb_sqrt (/ (- sum_1 (/ (* sum_0 sum_0) (cast count_2 f64))) (- (cast count_2 f64) 1))))))
