(rel project
  (rel aggregate
    (rel filter
      (rel join
        (rel join
          (rel join
            (rel join
              (rel join (rel source "customer") (rel source "orders") () (inner))
              (rel source "lineitem")
              ()
              (inner))
            (rel source "supplier")
            ()
            (inner))
          (rel source "nation")
          ()
          (inner))
        (rel source "region")
        ()
        (inner))
      (&& (&& (&& (&& (&& (&& (&& (&& (== c_custkey o_custkey) (== l_orderkey o_orderkey)) (== l_suppkey s_suppkey))
                  (== c_nationkey s_nationkey))
                (== s_nationkey n_nationkey))
              (== n_regionkey r_regionkey))
            (== r_name "MIDDLE EAST"))
          (>= o_orderdate (call qdb_sql_date "1995-01-01")))
        (< o_orderdate (+ (call qdb_sql_date "1995-01-01") (call qdb_sql_interval "1" "year")))))
    (keys n_name)
    (agg sum_0 sum (* l_extendedprice (- 1 l_discount))))
  (n_name n_name)
  (revenue sum_0))
