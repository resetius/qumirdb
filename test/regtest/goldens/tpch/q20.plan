(rel project
  (rel filter
    (rel join
      (rel join (rel source "supplier") (rel source "nation") () (inner))
      (rel project
        (rel filter
          (rel join
            (rel join
              (rel source "partsupp")
              (rel project
                (rel filter (rel source "part") (call qdb_string_view_sql_like p_name "thistle%"))
                (p_partkey p_partkey))
              ()
              (left_semi)
              (== ps_partkey p_partkey))
            (rel project
              (rel aggregate
                (rel project
                  (rel filter
                    (rel source "lineitem")
                    (&& (&& (&& (== l_partkey ps_partkey) (== l_suppkey ps_suppkey))
                        (>= l_shipdate (call qdb_sql_date "1995-01-01")))
                      (< l_shipdate (+ (call qdb_sql_date "1995-01-01") (call qdb_sql_interval "1" "year")))))
                  (l_quantity l_quantity)
                  (__group__ 1))
                (keys __group__)
                (agg sum_0 sum l_quantity))
              (__scalar_0__ (* 0.5 sum_0)))
            ()
            (inner))
          (> ps_availqty __scalar_0__))
        (ps_suppkey ps_suppkey))
      ()
      (left_semi)
      (== s_suppkey ps_suppkey))
    (&& (== s_nationkey n_nationkey) (== n_name "PERU")))
  (s_name s_name)
  (s_address s_address))
