(rel project
  (rel aggregate
    (rel project
      (rel filter
        (rel join (rel source "lineitem") (rel source "part") () (inner))
        (|| (|| (&& (&& (&& (&& (&& (&& (&& (== p_partkey l_partkey) (== p_brand "Brand#35"))
                        (|| (|| (|| (== p_container "SM CASE") (== p_container "SM BOX")) (== p_container "SM PACK"))
                          (== p_container "SM PKG")))
                      (>= l_quantity 10))
                    (<= l_quantity (+ 10 10)))
                  (&& (<= 1 p_size) (<= p_size 5)))
                (|| (== l_shipmode "AIR") (== l_shipmode "AIR REG")))
              (== l_shipinstruct "DELIVER IN PERSON"))
            (&& (&& (&& (&& (&& (&& (&& (== p_partkey l_partkey) (== p_brand "Brand#34"))
                        (|| (|| (|| (== p_container "MED BAG") (== p_container "MED BOX")) (== p_container "MED PKG"))
                          (== p_container "MED PACK")))
                      (>= l_quantity 18))
                    (<= l_quantity (+ 18 10)))
                  (&& (<= 1 p_size) (<= p_size 10)))
                (|| (== l_shipmode "AIR") (== l_shipmode "AIR REG")))
              (== l_shipinstruct "DELIVER IN PERSON")))
          (&& (&& (&& (&& (&& (&& (&& (== p_partkey l_partkey) (== p_brand "Brand#23"))
                      (|| (|| (|| (== p_container "LG CASE") (== p_container "LG BOX")) (== p_container "LG PACK"))
                        (== p_container "LG PKG")))
                    (>= l_quantity 24))
                  (<= l_quantity (+ 24 10)))
                (&& (<= 1 p_size) (<= p_size 15)))
              (|| (== l_shipmode "AIR") (== l_shipmode "AIR REG")))
            (== l_shipinstruct "DELIVER IN PERSON"))))
      (arg_0 (* l_extendedprice (- 1 l_discount)))
      (__group__ 1))
    (keys __group__)
    (agg sum_0 sum arg_0))
  (revenue sum_0))
