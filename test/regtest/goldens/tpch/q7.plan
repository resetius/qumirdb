(rel sort
  (rel project
    (rel aggregate
      (rel project
        (rel filter
          (rel join
            (rel join
              (rel join
                (rel join
                  (rel join (rel source "supplier") (rel source "lineitem") () (inner))
                  (rel source "orders")
                  ()
                  (inner))
                (rel source "customer")
                ()
                (inner))
              (rel source "nation" "n1")
              ()
              (inner))
            (rel source "nation" "n2")
            ()
            (inner))
          (&& (&& (&& (&& (&& (&& (&& (== s_suppkey l_suppkey) (== o_orderkey l_orderkey)) (== c_custkey o_custkey))
                    (== s_nationkey |n1.n_nationkey|))
                  (== c_nationkey |n2.n_nationkey|))
                (|| (&& (== |n1.n_name| "FRANCE") (== |n2.n_name| "UNITED KINGDOM"))
                  (&& (== |n1.n_name| "UNITED KINGDOM") (== |n2.n_name| "FRANCE"))))
              (<= (call qdb_sql_date "1995-01-01") l_shipdate))
            (<= l_shipdate (call qdb_sql_date "1996-12-31"))))
        (supp_nation |n1.n_name|)
        (cust_nation |n2.n_name|)
        (l_year (call qdb_date_year l_shipdate))
        (volume (* l_extendedprice (- 1 l_discount))))
      (keys supp_nation cust_nation l_year)
      (agg sum_0 sum volume))
    (supp_nation supp_nation)
    (cust_nation cust_nation)
    (l_year l_year)
    (revenue sum_0))
  (supp_nation asc nulls-default)
  (cust_nation asc nulls-default)
  (l_year asc nulls-default))
