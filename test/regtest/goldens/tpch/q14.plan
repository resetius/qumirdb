(rel project
  (rel aggregate
    (rel project
      (rel filter
        (rel join (rel source "lineitem") (rel source "part") () (inner))
        (&& (&& (== l_partkey p_partkey) (>= l_shipdate (: 8460 i32))) (< l_shipdate (+ (: 8460 i32) (: 30 i32)))))
      (arg_0 (if
          (call
            qdb_is_true
            (call qdb_string_view_sql_like p_type (: (cast "PROMO%" <named StringView>) <named StringView>)))
          (* l_extendedprice (- 1 l_discount))
          0))
      (arg_1 (* l_extendedprice (- 1 l_discount)))
      (__group__ 1))
    (keys __group__)
    (agg sum_0 sum arg_0)
    (agg sum_1 sum arg_1))
  (promo_revenue (/ (* 100 sum_0) sum_1)))
