(rel sort
  (rel project
    (rel aggregate
      (rel project
        (rel filter
          (rel join (rel source "orders") (rel source "lineitem") () (inner))
          (&& (&& (&& (&& (&& (== o_orderkey l_orderkey)
                    (call
                      qdb_in_list
                      l_shipmode
                      (: (cast "TRUCK" <named StringView>) <named StringView>)
                      (: (cast "AIR" <named StringView>) <named StringView>)))
                  (< l_commitdate l_receiptdate))
                (< l_shipdate l_commitdate))
              (>= l_receiptdate (: 8401 i32)))
            (< l_receiptdate (+ (: 8401 i32) (: 365 i32)))))
        (l_shipmode l_shipmode)
        (arg_0 (if
            (call
              qdb_is_true
              (|| (== o_orderpriority (: (cast "1-URGENT" <named StringView>) <named StringView>))
                (== o_orderpriority (: (cast "2-HIGH" <named StringView>) <named StringView>))))
            1
            0))
        (arg_1 (if
            (call
              qdb_is_true
              (&& (!= o_orderpriority (: (cast "1-URGENT" <named StringView>) <named StringView>))
                (!= o_orderpriority (: (cast "2-HIGH" <named StringView>) <named StringView>))))
            1
            0)))
      (keys l_shipmode)
      (agg sum_0 sum arg_0)
      (agg sum_1 sum arg_1))
    (l_shipmode l_shipmode)
    (high_line_count sum_0)
    (low_line_count sum_1))
  (l_shipmode asc nulls-default))
