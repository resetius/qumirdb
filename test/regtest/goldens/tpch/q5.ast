(query
  (select
    (select-list
      (item
        n_name
      )
      (item as revenue
        (call sum (* l_extendedprice (- 1 l_discount)))
      )
    )
    (from
      (table customer)
      (table orders)
      (table lineitem)
      (table supplier)
      (table nation)
      (table region)
    )
    (where
      (&& (&& (&& (&& (&& (&& (&& (&& (== c_custkey o_custkey) (== l_orderkey o_orderkey)) (== l_suppkey s_suppkey))
                  (== c_nationkey s_nationkey))
                (== s_nationkey n_nationkey))
              (== n_regionkey r_regionkey))
            (== r_name (cast "MIDDLE EAST" <named StringView>)))
          (>= o_orderdate (: 9131 i32)))
        (< o_orderdate (+ (: 9131 i32) (: 365 i32))))
    )
    (group-by
      n_name
    )
  )
  (order-by
    (order desc
      revenue
    )
  )
)
