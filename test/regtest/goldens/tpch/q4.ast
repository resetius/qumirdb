(query
  (select
    (select-list
      (item
        o_orderpriority
      )
      (item as order_count
        (call count *)
      )
    )
    (from
      (table orders)
    )
    (where
      (&& (&& (>= o_orderdate (: 9465 i32)) (< o_orderdate (+ (: 9465 i32) (: 90 i32))))
        (subquery exists (query
        (select
          (select-list
            (star *)
          )
          (from
            (table lineitem)
          )
          (where
            (&& (== l_orderkey o_orderkey) (< l_commitdate l_receiptdate))
          )
        )
      )
      ))
    )
    (group-by
      o_orderpriority
    )
  )
  (order-by
    (order asc
      o_orderpriority
    )
  )
)
