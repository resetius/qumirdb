(query
  (select
    (select-list
      (item
        l_shipmode
      )
      (item as high_line_count
        (call sum (if (|| (== o_orderpriority "1-URGENT") (== o_orderpriority "2-HIGH")) 1 0))
      )
      (item as low_line_count
        (call sum (if (&& (!= o_orderpriority "1-URGENT") (!= o_orderpriority "2-HIGH")) 1 0))
      )
    )
    (from
      (table orders)
      (table lineitem)
    )
    (where
      (&& (&& (&& (&& (&& (== o_orderkey l_orderkey) (|| (== l_shipmode "TRUCK") (== l_shipmode "AIR")))
              (< l_commitdate l_receiptdate))
            (< l_shipdate l_commitdate))
          (>= l_receiptdate (: 8401 i32)))
        (< l_receiptdate (+ (: 8401 i32) (: 365 i32))))
    )
    (group-by
      l_shipmode
    )
  )
  (order-by
    (order asc
      l_shipmode
    )
  )
)
