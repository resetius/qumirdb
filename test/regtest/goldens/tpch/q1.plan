(rel sort
  (rel project
    (rel aggregate
      (rel project
        (rel filter (rel source "lineitem") (<= l_shipdate (- (: 10561 i32) (: 81 i32))))
        (l_returnflag l_returnflag)
        (l_linestatus l_linestatus)
        (l_quantity l_quantity)
        (l_extendedprice l_extendedprice)
        (arg_0 (* l_extendedprice (- 1 l_discount)))
        (arg_1 (* (* l_extendedprice (- 1 l_discount)) (+ 1 l_tax)))
        (l_discount l_discount))
      (keys l_returnflag l_linestatus)
      (agg sum_0 sum l_quantity)
      (agg sum_1 sum l_extendedprice)
      (agg sum_2 sum arg_0)
      (agg sum_3 sum arg_1)
      (agg sum_4 sum l_quantity)
      (agg count_5 count l_quantity)
      (agg sum_6 sum l_extendedprice)
      (agg count_7 count l_extendedprice)
      (agg sum_8 sum l_discount)
      (agg count_9 count l_discount)
      (agg count_10 count))
    (l_returnflag l_returnflag)
    (l_linestatus l_linestatus)
    (sum_qty sum_0)
    (sum_base_price sum_1)
    (sum_disc_price sum_2)
    (sum_charge sum_3)
    (avg_qty (/ sum_4 (cast count_5 f64)))
    (avg_price (/ sum_6 (cast count_7 f64)))
    (avg_disc (/ sum_8 (cast count_9 f64)))
    (count_order count_10))
  (l_returnflag asc nulls-default)
  (l_linestatus asc nulls-default))
