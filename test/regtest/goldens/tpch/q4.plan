(rel sort
  (rel project
    (rel aggregate
      (rel filter
        (rel join
          (rel source "orders")
          (rel source "lineitem")
          ()
          (left_semi)
          (&& (== l_orderkey o_orderkey) (< l_commitdate l_receiptdate)))
        (&& (>= o_orderdate (call qdb_sql_date "1995-12-01"))
          (< o_orderdate (+ (call qdb_sql_date "1995-12-01") (call qdb_sql_interval "3" "month")))))
      (keys o_orderpriority)
      (agg count_0 count))
    (o_orderpriority o_orderpriority)
    (order_count count_0))
  (o_orderpriority asc nulls-default))
