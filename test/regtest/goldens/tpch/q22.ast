(query
  (select
    (select-list
      (item
        cntrycode
      )
      (item as numcust
        (call count *)
      )
      (item as totacctbal
        (call sum c_acctbal)
      )
    )
    (from
      (subquery-table as custsale
        (query
          (select
            (select-list
              (item as cntrycode
                (call qdb_substring c_phone (cast 1 i32) (cast 2 i32))
              )
              (item
                c_acctbal
              )
            )
            (from
              (table customer)
            )
            (where
              (&& (&& (|| (|| (|| (|| (|| (|| (== (call qdb_substring c_phone (cast 1 i32) (cast 2 i32)) "27")
                              (== (call qdb_substring c_phone (cast 1 i32) (cast 2 i32)) "20"))
                            (== (call qdb_substring c_phone (cast 1 i32) (cast 2 i32)) "22"))
                          (== (call qdb_substring c_phone (cast 1 i32) (cast 2 i32)) "34"))
                        (== (call qdb_substring c_phone (cast 1 i32) (cast 2 i32)) "29"))
                      (== (call qdb_substring c_phone (cast 1 i32) (cast 2 i32)) "23"))
                    (== (call qdb_substring c_phone (cast 1 i32) (cast 2 i32)) "17"))
                  (> c_acctbal
                    (subquery scalar (query
                (select
                  (select-list
                    (item
                      (call avg c_acctbal)
                    )
                  )
                  (from
                    (table customer)
                  )
                  (where
                    (&& (> c_acctbal 0)
                      (|| (|| (|| (|| (|| (|| (== (call qdb_substring c_phone (cast 1 i32) (cast 2 i32)) "27")
                                  (== (call qdb_substring c_phone (cast 1 i32) (cast 2 i32)) "20"))
                                (== (call qdb_substring c_phone (cast 1 i32) (cast 2 i32)) "22"))
                              (== (call qdb_substring c_phone (cast 1 i32) (cast 2 i32)) "34"))
                            (== (call qdb_substring c_phone (cast 1 i32) (cast 2 i32)) "29"))
                          (== (call qdb_substring c_phone (cast 1 i32) (cast 2 i32)) "23"))
                        (== (call qdb_substring c_phone (cast 1 i32) (cast 2 i32)) "17")))
                  )
                )
              )
              )))
                (! (subquery exists (query
                (select
                  (select-list
                    (star *)
                  )
                  (from
                    (table orders)
                  )
                  (where
                    (== o_custkey c_custkey)
                  )
                )
              )
              )))
            )
          )
        )
      )
    )
    (group-by
      cntrycode
    )
  )
  (order-by
    (order asc
      cntrycode
    )
  )
)
