(query
  (select
    (select-list
      (item
        p_brand
      )
      (item
        p_type
      )
      (item
        p_size
      )
      (item as supplier_cnt
        (call count (call distinct ps_suppkey))
      )
    )
    (from
      (table partsupp)
      (table part)
    )
    (where
      (&& (&& (&& (&& (== p_partkey ps_partkey) (!= p_brand (: (cast "Brand#54" <named StringView>) <named StringView>)))
            (! (call qdb_string_view_sql_like p_type (: (cast "PROMO ANODIZED%" <named StringView>) <named StringView>))))
          (call qdb_in_list p_size 24 47 25 36 22 26 49 40))
        (! (subquery in ps_suppkey (query
        (select
          (select-list
            (item
              s_suppkey
            )
          )
          (from
            (table supplier)
          )
          (where
            (call qdb_string_view_sql_like s_comment (: (cast "%Customer%Complaints%" <named StringView>) <named StringView>))
          )
        )
      )
      )))
    )
    (group-by
      p_brand
      p_type
      p_size
    )
  )
  (order-by
    (order desc
      supplier_cnt
    )
    (order asc
      p_brand
    )
    (order asc
      p_type
    )
    (order asc
      p_size
    )
  )
)
