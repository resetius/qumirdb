(query
  (select
    (select-list
      (item
        c_custkey
      )
      (item
        c_name
      )
      (item as revenue
        (call sum (* l_extendedprice (- 1 l_discount)))
      )
      (item
        c_acctbal
      )
      (item
        n_name
      )
      (item
        c_address
      )
      (item
        c_phone
      )
      (item
        c_comment
      )
    )
    (from
      (table customer)
      (table orders)
      (table lineitem)
      (table nation)
    )
    (where
      (&& (&& (&& (&& (&& (== c_custkey o_custkey) (== l_orderkey o_orderkey)) (>= o_orderdate (: 8917 i32)))
            (< o_orderdate (+ (: 8917 i32) (: 90 i32))))
          (== l_returnflag (cast "R" <named StringView>)))
        (== c_nationkey n_nationkey))
    )
    (group-by
      c_custkey
      c_name
      c_acctbal
      c_phone
      n_name
      c_address
      c_comment
    )
  )
  (order-by
    (order desc
      revenue
    )
  )
  (limit
    20
  )
)
