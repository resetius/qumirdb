(rel project
  (rel aggregate
    (rel project
      (rel filter
        (rel join
          (rel join (rel source "customer") (rel source "orders") () (inner))
          (rel source "lineitem")
          ()
          (inner))
        (&& (&& (&& (&& (== c_mktsegment "FURNITURE") (== c_custkey o_custkey)) (== l_orderkey o_orderkey))
            (< o_orderdate (call qdb_sql_date "1995-03-20")))
          (> l_shipdate (call qdb_sql_date "1995-03-20"))))
      (l_orderkey l_orderkey)
      (o_orderdate o_orderdate)
      (o_shippriority o_shippriority)
      (arg_0 (* l_extendedprice (- 1 l_discount))))
    (keys l_orderkey o_orderdate o_shippriority)
    (agg sum_0 sum arg_0))
  (l_orderkey l_orderkey)
  (revenue sum_0)
  (o_orderdate o_orderdate)
  (o_shippriority o_shippriority))
