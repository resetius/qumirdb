(query
  (select
    (select-list
      (item
        s_name
      )
      (item as numwait
        (call count *)
      )
    )
    (from
      (table supplier)
      (table lineitem as l1)
      (table orders)
      (table nation)
    )
    (where
      (&& (&& (&& (&& (&& (&& (&& (== s_suppkey |l1.l_suppkey|) (== o_orderkey |l1.l_orderkey|))
                  (== o_orderstatus (cast "F" <named StringView>)))
                (> |l1.l_receiptdate| |l1.l_commitdate|))
              (subquery exists (query
        (select
          (select-list
            (star *)
          )
          (from
            (table lineitem as l2)
          )
          (where
            (&& (== |l2.l_orderkey| |l1.l_orderkey|) (!= |l2.l_suppkey| |l1.l_suppkey|))
          )
        )
      )
      ))
            (! (subquery exists (query
        (select
          (select-list
            (star *)
          )
          (from
            (table lineitem as l3)
          )
          (where
            (&& (&& (== |l3.l_orderkey| |l1.l_orderkey|) (!= |l3.l_suppkey| |l1.l_suppkey|))
              (> |l3.l_receiptdate| |l3.l_commitdate|))
          )
        )
      )
      )))
          (== s_nationkey n_nationkey))
        (== n_name (cast "IRAQ" <named StringView>)))
    )
    (group-by
      s_name
    )
  )
  (order-by
    (order desc
      numwait
    )
    (order asc
      s_name
    )
  )
  (limit
    100
  )
)
