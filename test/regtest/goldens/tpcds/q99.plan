(rel limit
  (rel sort
    (rel project
      (rel aggregate
        (rel project
          (rel filter
            (rel join
              (rel join
                (rel join
                  (rel join (rel source "catalog_sales") (rel source "warehouse") () (inner))
                  (rel source "ship_mode")
                  ()
                  (inner))
                (rel source "call_center")
                ()
                (inner))
              (rel source "date_dim")
              ()
              (inner))
            (&& (&& (&& (&& (&& (<= 1212 d_month_seq) (<= d_month_seq (+ 1212 11))) (== cs_ship_date_sk d_date_sk))
                  (== cs_warehouse_sk w_warehouse_sk))
                (== cs_ship_mode_sk sm_ship_mode_sk))
              (== cs_call_center_sk cc_call_center_sk)))
          (gb_0 (call substr w_warehouse_name 1 20))
          (sm_type sm_type)
          (cc_name cc_name)
          (arg_0 (if (<= (- cs_ship_date_sk cs_sold_date_sk) 30) 1 0))
          (arg_1 (if (&& (> (- cs_ship_date_sk cs_sold_date_sk) 30) (<= (- cs_ship_date_sk cs_sold_date_sk) 60)) 1 0))
          (arg_2 (if (&& (> (- cs_ship_date_sk cs_sold_date_sk) 60) (<= (- cs_ship_date_sk cs_sold_date_sk) 90)) 1 0))
          (arg_3 (if (&& (> (- cs_ship_date_sk cs_sold_date_sk) 90) (<= (- cs_ship_date_sk cs_sold_date_sk) 120)) 1 0))
          (arg_4 (if (> (- cs_ship_date_sk cs_sold_date_sk) 120) 1 0)))
        (keys gb_0 sm_type cc_name)
        (agg sum_0 sum arg_0)
        (agg sum_1 sum arg_1)
        (agg sum_2 sum arg_2)
        (agg sum_3 sum arg_3)
        (agg sum_4 sum arg_4))
      (col0 gb_0)
      (sm_type sm_type)
      (cc_name cc_name)
      (|30 days| sum_0)
      (|31-60 days| sum_1)
      (|61-90 days| sum_2)
      (|91-120 days| sum_3)
      (|>120 days| sum_4))
    (col0 asc nulls-default)
    (sm_type asc nulls-default)
    (cc_name asc nulls-default))
  (limit 100))
