(rel limit
  (rel project
    (rel aggregate
      (rel project
        (rel join
          (rel project (rel cte-ref 0) (|ssci.customer_sk| customer_sk) (|ssci.item_sk| item_sk))
          (rel project (rel cte-ref 1) (|csci.customer_sk| customer_sk) (|csci.item_sk| item_sk))
          ()
          (full)
          (&& (== |ssci.customer_sk| |csci.customer_sk|) (== |ssci.item_sk| |csci.item_sk|)))
        (arg_0 (if
            (call qdb_is_true (&& (! (call qdb_is_null |ssci.customer_sk|)) (call qdb_is_null |csci.customer_sk|)))
            1
            0))
        (arg_1 (if
            (call qdb_is_true (&& (call qdb_is_null |ssci.customer_sk|) (! (call qdb_is_null |csci.customer_sk|))))
            1
            0))
        (arg_2 (if
            (call qdb_is_true (&& (! (call qdb_is_null |ssci.customer_sk|)) (! (call qdb_is_null |csci.customer_sk|))))
            1
            0))
        (__group__ 1))
      (keys __group__)
      (agg sum_0 sum arg_0)
      (agg sum_1 sum arg_1)
      (agg sum_2 sum arg_2))
    (store_only sum_0)
    (catalog_only sum_1)
    (store_and_catalog sum_2))
  (limit 100))
