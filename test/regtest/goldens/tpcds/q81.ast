(query
  (with
    (cte customer_total_return
      (query
        (select
          (select-list
            (item as ctr_customer_sk
              cr_returning_customer_sk
            )
            (item as ctr_state
              ca_state
            )
            (item as ctr_total_return
              (call sum cr_return_amt_inc_tax)
            )
          )
          (from
            (table catalog_returns)
            (table date_dim)
            (table customer_address)
          )
          (where
            (&& (&& (== cr_returned_date_sk d_date_sk) (== d_year 1998)) (== cr_returning_addr_sk ca_address_sk))
          )
          (group-by
            cr_returning_customer_sk
            ca_state
          )
        )
      )
    )
  )
  (select
    (select-list
      (item
        c_customer_id
      )
      (item
        c_salutation
      )
      (item
        c_first_name
      )
      (item
        c_last_name
      )
      (item
        ca_street_number
      )
      (item
        ca_street_name
      )
      (item
        ca_street_type
      )
      (item
        ca_suite_number
      )
      (item
        ca_city
      )
      (item
        ca_county
      )
      (item
        ca_state
      )
      (item
        ca_zip
      )
      (item
        ca_country
      )
      (item
        ca_gmt_offset
      )
      (item
        ca_location_type
      )
      (item
        ctr_total_return
      )
    )
    (from
      (table customer_total_return as ctr1)
      (table customer_address)
      (table customer)
    )
    (where
      (&& (&& (&& (> |ctr1.ctr_total_return|
              (subquery scalar (query
        (select
          (select-list
            (item
              (* (call avg ctr_total_return) 1.2)
            )
          )
          (from
            (table customer_total_return as ctr2)
          )
          (where
            (== |ctr1.ctr_state| |ctr2.ctr_state|)
          )
        )
      )
      ))
            (== ca_address_sk c_current_addr_sk))
          (== ca_state "IL"))
        (== |ctr1.ctr_customer_sk| c_customer_sk))
    )
  )
  (order-by
    (order asc
      c_customer_id
    )
    (order asc
      c_salutation
    )
    (order asc
      c_first_name
    )
    (order asc
      c_last_name
    )
    (order asc
      ca_street_number
    )
    (order asc
      ca_street_name
    )
    (order asc
      ca_street_type
    )
    (order asc
      ca_suite_number
    )
    (order asc
      ca_city
    )
    (order asc
      ca_county
    )
    (order asc
      ca_state
    )
    (order asc
      ca_zip
    )
    (order asc
      ca_country
    )
    (order asc
      ca_gmt_offset
    )
    (order asc
      ca_location_type
    )
    (order asc
      ctr_total_return
    )
  )
  (limit
    100
  )
)
