(query
  (with
    (cte frequent_ss_items
      (query
        (select
          (select-list
            (item as itemdesc
              (call substr i_item_desc 1 30)
            )
            (item as item_sk
              i_item_sk
            )
            (item as solddate
              d_date
            )
            (item as cnt
              (call count *)
            )
          )
          (from
            (table store_sales)
            (table date_dim)
            (table item)
          )
          (where
            (&& (&& (== ss_sold_date_sk d_date_sk) (== ss_item_sk i_item_sk))
              (call qdb_in_list d_year 1999 (+ 1999 1) (+ 1999 2) (+ 1999 3)))
          )
          (group-by
            (call substr i_item_desc 1 30)
            i_item_sk
            d_date
          )
          (having
            (> (call count *) 4)
          )
        )
      )
    )
    (cte max_store_sales
      (query
        (select
          (select-list
            (item as tpcds_cmax
              (call max csales)
            )
          )
          (from
            (subquery-table
              (query
                (select
                  (select-list
                    (item
                      c_customer_sk
                    )
                    (item as csales
                      (call sum (* ss_quantity ss_sales_price))
                    )
                  )
                  (from
                    (table store_sales)
                    (table customer)
                    (table date_dim)
                  )
                  (where
                    (&& (&& (== ss_customer_sk c_customer_sk) (== ss_sold_date_sk d_date_sk))
                      (call qdb_in_list d_year 1999 (+ 1999 1) (+ 1999 2) (+ 1999 3)))
                  )
                  (group-by
                    c_customer_sk
                  )
                )
              )
            )
          )
        )
      )
    )
    (cte best_ss_customer
      (query
        (select
          (select-list
            (item
              c_customer_sk
            )
            (item as ssales
              (call sum (* ss_quantity ss_sales_price))
            )
          )
          (from
            (table store_sales)
            (table customer)
          )
          (where
            (== ss_customer_sk c_customer_sk)
          )
          (group-by
            c_customer_sk
          )
          (having
            (> (call sum (* ss_quantity ss_sales_price))
              (* (/ 95 100)
                (subquery scalar (query
              (select
                (select-list
                  (star *)
                )
                (from
                  (table max_store_sales)
                )
              )
            )
            )))
          )
        )
      )
    )
  )
  (select
    (select-list
      (item
        (call sum sales)
      )
    )
    (from
      (subquery-table
        (query
          (union all
            (select
              (select-list
                (item as sales
                  (* cs_quantity cs_list_price)
                )
              )
              (from
                (table catalog_sales)
                (table date_dim)
              )
              (where
                (&& (&& (&& (&& (== d_year 1999) (== d_moy 1)) (== cs_sold_date_sk d_date_sk))
                    (subquery in cs_item_sk (query
                  (select
                    (select-list
                      (item
                        item_sk
                      )
                    )
                    (from
                      (table frequent_ss_items)
                    )
                  )
                )
                ))
                  (subquery in cs_bill_customer_sk (query
                  (select
                    (select-list
                      (item
                        c_customer_sk
                      )
                    )
                    (from
                      (table best_ss_customer)
                    )
                  )
                )
                ))
              )
            )
            (select
              (select-list
                (item as sales
                  (* ws_quantity ws_list_price)
                )
              )
              (from
                (table web_sales)
                (table date_dim)
              )
              (where
                (&& (&& (&& (&& (== d_year 1999) (== d_moy 1)) (== ws_sold_date_sk d_date_sk))
                    (subquery in ws_item_sk (query
                  (select
                    (select-list
                      (item
                        item_sk
                      )
                    )
                    (from
                      (table frequent_ss_items)
                    )
                  )
                )
                ))
                  (subquery in ws_bill_customer_sk (query
                  (select
                    (select-list
                      (item
                        c_customer_sk
                      )
                    )
                    (from
                      (table best_ss_customer)
                    )
                  )
                )
                ))
              )
            )
          )
        )
      )
    )
  )
  (limit
    100
  )
)
