(rel limit
  (rel sort
    (rel project
      (rel aggregate
        (rel filter
          (rel join
            (rel join
              (rel join
                (rel join
                  (rel join
                    (rel join
                      (rel join (rel source "store_sales") (rel source "store_returns") () (inner))
                      (rel source "catalog_sales")
                      ()
                      (inner))
                    (rel source "date_dim" "d1")
                    ()
                    (inner))
                  (rel source "date_dim" "d2")
                  ()
                  (inner))
                (rel source "date_dim" "d3")
                ()
                (inner))
              (rel source "store")
              ()
              (inner))
            (rel source "item")
            ()
            (inner))
          (&& (&& (&& (&& (&& (&& (&& (&& (&& (&& (&& (&& (&& (&& (&& (&& (&& (== |d1.d_moy| 4) (== |d1.d_year| 2000))
                                          (== |d1.d_date_sk| ss_sold_date_sk))
                                        (== i_item_sk ss_item_sk))
                                      (== s_store_sk ss_store_sk))
                                    (== ss_customer_sk sr_customer_sk))
                                  (== ss_item_sk sr_item_sk))
                                (== ss_ticket_number sr_ticket_number))
                              (== sr_returned_date_sk |d2.d_date_sk|))
                            (<= 4 |d2.d_moy|))
                          (<= |d2.d_moy| 10))
                        (== |d2.d_year| 2000))
                      (== sr_customer_sk cs_bill_customer_sk))
                    (== sr_item_sk cs_item_sk))
                  (== cs_sold_date_sk |d3.d_date_sk|))
                (<= 4 |d3.d_moy|))
              (<= |d3.d_moy| 10))
            (== |d3.d_year| 2000)))
        (keys i_item_id i_item_desc s_store_id s_store_name)
        (agg sum_0 sum ss_net_profit)
        (agg sum_1 sum sr_net_loss)
        (agg sum_2 sum cs_net_profit))
      (i_item_id i_item_id)
      (i_item_desc i_item_desc)
      (s_store_id s_store_id)
      (s_store_name s_store_name)
      (store_sales_profit sum_0)
      (store_returns_loss sum_1)
      (catalog_sales_profit sum_2))
    (i_item_id asc nulls-default)
    (i_item_desc asc nulls-default)
    (s_store_id asc nulls-default)
    (s_store_name asc nulls-default))
  (limit 100))
