(rel project
  (rel aggregate
    (rel project
      (rel filter
        (rel join
          (rel join
            (rel join
              (rel join (rel source "store_sales") (rel source "store") () (inner))
              (rel source "customer_demographics")
              ()
              (inner))
            (rel source "customer_address")
            ()
            (inner))
          (rel source "date_dim")
          ()
          (inner))
        (&& (&& (&& (&& (== s_store_sk ss_store_sk) (== ss_sold_date_sk d_date_sk)) (== d_year 1998))
            (|| (|| (&& (&& (&& (== cd_demo_sk ss_cdemo_sk) (== cd_marital_status (cast "M" <named StringView>)))
                    (== cd_education_status (cast "4 yr Degree" <named StringView>)))
                  (&& (<= 100 ss_sales_price) (<= ss_sales_price 150)))
                (&& (&& (&& (== cd_demo_sk ss_cdemo_sk) (== cd_marital_status (cast "D" <named StringView>)))
                    (== cd_education_status (cast "Primary" <named StringView>)))
                  (&& (<= 50 ss_sales_price) (<= ss_sales_price 100))))
              (&& (&& (&& (== cd_demo_sk ss_cdemo_sk) (== cd_marital_status (cast "U" <named StringView>)))
                  (== cd_education_status (cast "Advanced Degree" <named StringView>)))
                (&& (<= 150 ss_sales_price) (<= ss_sales_price 200)))))
          (|| (|| (&& (&& (&& (== ss_addr_sk ca_address_sk) (== ca_country (cast "United States" <named StringView>)))
                  (call
                    qdb_in_list
                    ca_state
                    (cast "KY" <named StringView>)
                    (cast "GA" <named StringView>)
                    (cast "NM" <named StringView>)))
                (&& (<= 0 ss_net_profit) (<= ss_net_profit 2000)))
              (&& (&& (&& (== ss_addr_sk ca_address_sk) (== ca_country (cast "United States" <named StringView>)))
                  (call
                    qdb_in_list
                    ca_state
                    (cast "MT" <named StringView>)
                    (cast "OR" <named StringView>)
                    (cast "IN" <named StringView>)))
                (&& (<= 150 ss_net_profit) (<= ss_net_profit 3000))))
            (&& (&& (&& (== ss_addr_sk ca_address_sk) (== ca_country (cast "United States" <named StringView>)))
                (call
                  qdb_in_list
                  ca_state
                  (cast "WI" <named StringView>)
                  (cast "MO" <named StringView>)
                  (cast "WV" <named StringView>)))
              (&& (<= 50 ss_net_profit) (<= ss_net_profit 25000))))))
      (ss_quantity ss_quantity)
      (__group__ 1))
    (keys __group__)
    (agg sum_0 sum ss_quantity))
  (col0 sum_0))
