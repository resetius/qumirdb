(query
  (select
    (select-list
      (item
        i_product_name
      )
      (item
        i_brand
      )
      (item
        i_class
      )
      (item
        i_category
      )
      (item as qoh
        (call avg inv_quantity_on_hand)
      )
    )
    (from
      (table inventory)
      (table date_dim)
      (table item)
    )
    (where
      (&& (&& (== inv_date_sk d_date_sk) (== inv_item_sk i_item_sk)) (&& (<= 1212 d_month_seq) (<= d_month_seq (+ 1212 11))))
    )
    (group-by
      (rollup
        (block
          i_product_name
          i_brand
          i_class
          i_category)
      )
    )
  )
  (order-by
    (order asc
      qoh
    )
    (order asc
      i_product_name
    )
    (order asc
      i_brand
    )
    (order asc
      i_class
    )
    (order asc
      i_category
    )
  )
  (limit
    100
  )
)
