(query
  (with
    (cte ssr
      (query
        (select
          (select-list
            (item
              s_store_id
            )
            (item as sales
              (call sum sales_price)
            )
            (item as profit
              (call sum profit)
            )
            (item as returns
              (call sum return_amt)
            )
            (item as profit_loss
              (call sum net_loss)
            )
          )
          (from
            (subquery-table as salesreturns
              (query
                (union all
                  (select
                    (select-list
                      (item as store_sk
                        ss_store_sk
                      )
                      (item as date_sk
                        ss_sold_date_sk
                      )
                      (item as sales_price
                        ss_ext_sales_price
                      )
                      (item as profit
                        ss_net_profit
                      )
                      (item as return_amt
                        (: (cast 0 <named DECIMAL [7 2]>) <named DECIMAL [7 2]>)
                      )
                      (item as net_loss
                        (: (cast 0 <named DECIMAL [7 2]>) <named DECIMAL [7 2]>)
                      )
                    )
                    (from
                      (table store_sales)
                    )
                  )
                  (select
                    (select-list
                      (item as store_sk
                        sr_store_sk
                      )
                      (item as date_sk
                        sr_returned_date_sk
                      )
                      (item as sales_price
                        (: (cast 0 <named DECIMAL [7 2]>) <named DECIMAL [7 2]>)
                      )
                      (item as profit
                        (: (cast 0 <named DECIMAL [7 2]>) <named DECIMAL [7 2]>)
                      )
                      (item as return_amt
                        sr_return_amt
                      )
                      (item as net_loss
                        sr_net_loss
                      )
                    )
                    (from
                      (table store_returns)
                    )
                  )
                )
              )
            )
            (table date_dim)
            (table store)
          )
          (where
            (&& (&& (== date_sk d_date_sk)
                (&& (<= (: (cast (: (cast "1998-08-04" <named StringView>) <named StringView>) <named DATE>) <named DATE>) d_date)
                  (<= d_date
                    (+ (: (cast (: (cast "1998-08-04" <named StringView>) <named StringView>) <named DATE>) <named DATE>)
                      (: 14 i32)))))
              (== store_sk s_store_sk))
          )
          (group-by
            s_store_id
          )
        )
      )
    )
    (cte csr
      (query
        (select
          (select-list
            (item
              cp_catalog_page_id
            )
            (item as sales
              (call sum sales_price)
            )
            (item as profit
              (call sum profit)
            )
            (item as returns
              (call sum return_amt)
            )
            (item as profit_loss
              (call sum net_loss)
            )
          )
          (from
            (subquery-table as salesreturns
              (query
                (union all
                  (select
                    (select-list
                      (item as page_sk
                        cs_catalog_page_sk
                      )
                      (item as date_sk
                        cs_sold_date_sk
                      )
                      (item as sales_price
                        cs_ext_sales_price
                      )
                      (item as profit
                        cs_net_profit
                      )
                      (item as return_amt
                        (: (cast 0 <named DECIMAL [7 2]>) <named DECIMAL [7 2]>)
                      )
                      (item as net_loss
                        (: (cast 0 <named DECIMAL [7 2]>) <named DECIMAL [7 2]>)
                      )
                    )
                    (from
                      (table catalog_sales)
                    )
                  )
                  (select
                    (select-list
                      (item as page_sk
                        cr_catalog_page_sk
                      )
                      (item as date_sk
                        cr_returned_date_sk
                      )
                      (item as sales_price
                        (: (cast 0 <named DECIMAL [7 2]>) <named DECIMAL [7 2]>)
                      )
                      (item as profit
                        (: (cast 0 <named DECIMAL [7 2]>) <named DECIMAL [7 2]>)
                      )
                      (item as return_amt
                        cr_return_amount
                      )
                      (item as net_loss
                        cr_net_loss
                      )
                    )
                    (from
                      (table catalog_returns)
                    )
                  )
                )
              )
            )
            (table date_dim)
            (table catalog_page)
          )
          (where
            (&& (&& (== date_sk d_date_sk)
                (&& (<= (: (cast (: (cast "1998-08-04" <named StringView>) <named StringView>) <named DATE>) <named DATE>) d_date)
                  (<= d_date
                    (+ (: (cast (: (cast "1998-08-04" <named StringView>) <named StringView>) <named DATE>) <named DATE>)
                      (: 14 i32)))))
              (== page_sk cp_catalog_page_sk))
          )
          (group-by
            cp_catalog_page_id
          )
        )
      )
    )
    (cte wsr
      (query
        (select
          (select-list
            (item
              web_site_id
            )
            (item as sales
              (call sum sales_price)
            )
            (item as profit
              (call sum profit)
            )
            (item as returns
              (call sum return_amt)
            )
            (item as profit_loss
              (call sum net_loss)
            )
          )
          (from
            (subquery-table as salesreturns
              (query
                (union all
                  (select
                    (select-list
                      (item as wsr_web_site_sk
                        ws_web_site_sk
                      )
                      (item as date_sk
                        ws_sold_date_sk
                      )
                      (item as sales_price
                        ws_ext_sales_price
                      )
                      (item as profit
                        ws_net_profit
                      )
                      (item as return_amt
                        (: (cast 0 <named DECIMAL [7 2]>) <named DECIMAL [7 2]>)
                      )
                      (item as net_loss
                        (: (cast 0 <named DECIMAL [7 2]>) <named DECIMAL [7 2]>)
                      )
                    )
                    (from
                      (table web_sales)
                    )
                  )
                  (select
                    (select-list
                      (item as wsr_web_site_sk
                        ws_web_site_sk
                      )
                      (item as date_sk
                        wr_returned_date_sk
                      )
                      (item as sales_price
                        (: (cast 0 <named DECIMAL [7 2]>) <named DECIMAL [7 2]>)
                      )
                      (item as profit
                        (: (cast 0 <named DECIMAL [7 2]>) <named DECIMAL [7 2]>)
                      )
                      (item as return_amt
                        wr_return_amt
                      )
                      (item as net_loss
                        wr_net_loss
                      )
                    )
                    (from
                      (join left
                        (table web_returns)
                        (table web_sales)
                        (on
                          (&& (== wr_item_sk ws_item_sk) (== wr_order_number ws_order_number))
                        )
                      )
                    )
                  )
                )
              )
            )
            (table date_dim)
            (table web_site)
          )
          (where
            (&& (&& (== date_sk d_date_sk)
                (&& (<= (: (cast (: (cast "1998-08-04" <named StringView>) <named StringView>) <named DATE>) <named DATE>) d_date)
                  (<= d_date
                    (+ (: (cast (: (cast "1998-08-04" <named StringView>) <named StringView>) <named DATE>) <named DATE>)
                      (: 14 i32)))))
              (== wsr_web_site_sk web_site_sk))
          )
          (group-by
            web_site_id
          )
        )
      )
    )
  )
  (select
    (select-list
      (item
        channel
      )
      (item
        id
      )
      (item as sales
        (call sum sales)
      )
      (item as returns
        (call sum returns)
      )
      (item as profit
        (call sum profit)
      )
    )
    (from
      (subquery-table as x
        (query
          (union all
            (union all
              (select
                (select-list
                  (item as channel
                    (: (cast "store channel" <named StringView>) <named StringView>)
                  )
                  (item as id
                    (call strcat (: (cast "store" <named StringView>) <named StringView>) s_store_id)
                  )
                  (item
                    sales
                  )
                  (item
                    returns
                  )
                  (item as profit
                    (- profit profit_loss)
                  )
                )
                (from
                  (table ssr)
                )
              )
              (select
                (select-list
                  (item as channel
                    (: (cast "catalog channel" <named StringView>) <named StringView>)
                  )
                  (item as id
                    (call strcat (: (cast "catalog_page" <named StringView>) <named StringView>) cp_catalog_page_id)
                  )
                  (item
                    sales
                  )
                  (item
                    returns
                  )
                  (item as profit
                    (- profit profit_loss)
                  )
                )
                (from
                  (table csr)
                )
              )
            )
            (select
              (select-list
                (item as channel
                  (: (cast "web channel" <named StringView>) <named StringView>)
                )
                (item as id
                  (call strcat (: (cast "web_site" <named StringView>) <named StringView>) web_site_id)
                )
                (item
                  sales
                )
                (item
                  returns
                )
                (item as profit
                  (- profit profit_loss)
                )
              )
              (from
                (table wsr)
              )
            )
          )
        )
      )
    )
    (group-by
      (rollup
        (block
          channel
          id)
      )
    )
  )
  (order-by
    (order asc
      channel
    )
    (order asc
      id
    )
  )
  (limit
    100
  )
)
