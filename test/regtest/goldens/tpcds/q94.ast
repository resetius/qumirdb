(query
  (select
    (select-list
      (item as order count
        (call count (call distinct ws_order_number))
      )
      (item as total shipping cost
        (call sum ws_ext_ship_cost)
      )
      (item as total net profit
        (call sum ws_net_profit)
      )
    )
    (from
      (table web_sales as ws1)
      (table date_dim)
      (table customer_address)
      (table web_site)
    )
    (where
      (&& (&& (&& (&& (&& (&& (&& (&& (<= (cast "1999-5-01" <named StringView>) d_date)
                      (<= d_date (+ (cast (cast "1999-5-01" <named StringView>) <named DATE>) (: 60 i32))))
                    (== |ws1.ws_ship_date_sk| d_date_sk))
                  (== |ws1.ws_ship_addr_sk| ca_address_sk))
                (== ca_state (cast "TX" <named StringView>)))
              (== |ws1.ws_web_site_sk| web_site_sk))
            (== web_company_name (cast "pri" <named StringView>)))
          (subquery exists (query
        (select
          (select-list
            (star *)
          )
          (from
            (table web_sales as ws2)
          )
          (where
            (&& (== |ws1.ws_order_number| |ws2.ws_order_number|) (!= |ws1.ws_warehouse_sk| |ws2.ws_warehouse_sk|))
          )
        )
      )
      ))
        (! (subquery exists (query
        (select
          (select-list
            (star *)
          )
          (from
            (table web_returns as wr1)
          )
          (where
            (== |ws1.ws_order_number| |wr1.wr_order_number|)
          )
        )
      )
      )))
    )
  )
  (order-by
    (order asc
      (call count (call distinct ws_order_number))
    )
  )
  (limit
    100
  )
)
