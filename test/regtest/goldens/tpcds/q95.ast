(query
  (with
    (cte ws_wh
      (query
        (select
          (select-list
            (item
              |ws1.ws_order_number|
            )
            (item as wh1
              |ws1.ws_warehouse_sk|
            )
            (item as wh2
              |ws2.ws_warehouse_sk|
            )
          )
          (from
            (table web_sales as ws1)
            (table web_sales as ws2)
          )
          (where
            (&& (== |ws1.ws_order_number| |ws2.ws_order_number|) (!= |ws1.ws_warehouse_sk| |ws2.ws_warehouse_sk|))
          )
        )
      )
    )
  )
  (select
    (select-list
      (item as order count
        (call count (call distinct ws_order_number))
      )
      (item as total shipping cost
        (call sum ws_ext_ship_cost)
      )
      (item as total net profit
        (call sum ws_net_profit)
      )
    )
    (from
      (table web_sales as ws1)
      (table date_dim)
      (table customer_address)
      (table web_site)
    )
    (where
      (&& (&& (&& (&& (&& (&& (&& (&& (<= "1999-5-01" d_date) (<= d_date (+ (: (cast "1999-5-01" <named DATE>) <named DATE>) (: 60 i32))))
                    (== |ws1.ws_ship_date_sk| d_date_sk))
                  (== |ws1.ws_ship_addr_sk| ca_address_sk))
                (== ca_state "TX"))
              (== |ws1.ws_web_site_sk| web_site_sk))
            (== web_company_name "pri"))
          (subquery in |ws1.ws_order_number| (query
        (select
          (select-list
            (item
              ws_order_number
            )
          )
          (from
            (table ws_wh)
          )
        )
      )
      ))
        (subquery in |ws1.ws_order_number| (query
        (select
          (select-list
            (item
              wr_order_number
            )
          )
          (from
            (table web_returns)
            (table ws_wh)
          )
          (where
            (== wr_order_number |ws_wh.ws_order_number|)
          )
        )
      )
      ))
    )
  )
  (order-by
    (order asc
      (call count (call distinct ws_order_number))
    )
  )
  (limit
    100
  )
)
