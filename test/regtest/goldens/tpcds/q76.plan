(rel limit
  (rel sort
    (rel project
      (rel aggregate
        (rel union-all
          (rel project
            (rel filter
              (rel join
                (rel join (rel source "store_sales") (rel source "item") () (inner))
                (rel source "date_dim")
                ()
                (inner))
              (&& (&& (call qdb_sql_is_null ss_addr_sk) (== ss_sold_date_sk d_date_sk)) (== ss_item_sk i_item_sk)))
            (channel "store")
            (col_name "ss_addr_sk")
            (d_year d_year)
            (d_qoy d_qoy)
            (i_category i_category)
            (ext_sales_price ss_ext_sales_price))
          (rel project
            (rel filter
              (rel join
                (rel join (rel source "web_sales") (rel source "item") () (inner))
                (rel source "date_dim")
                ()
                (inner))
              (&& (&& (call qdb_sql_is_null ws_web_page_sk) (== ws_sold_date_sk d_date_sk)) (== ws_item_sk i_item_sk)))
            (channel "web")
            (col_name "ws_web_page_sk")
            (d_year d_year)
            (d_qoy d_qoy)
            (i_category i_category)
            (ext_sales_price ws_ext_sales_price))
          (rel project
            (rel filter
              (rel join
                (rel join (rel source "catalog_sales") (rel source "item") () (inner))
                (rel source "date_dim")
                ()
                (inner))
              (&& (&& (call qdb_sql_is_null cs_warehouse_sk) (== cs_sold_date_sk d_date_sk)) (== cs_item_sk i_item_sk)))
            (channel "catalog")
            (col_name "cs_warehouse_sk")
            (d_year d_year)
            (d_qoy d_qoy)
            (i_category i_category)
            (ext_sales_price cs_ext_sales_price)))
        (keys channel col_name d_year d_qoy i_category)
        (agg count_0 count)
        (agg sum_1 sum ext_sales_price))
      (channel channel)
      (col_name col_name)
      (d_year d_year)
      (d_qoy d_qoy)
      (i_category i_category)
      (sales_cnt count_0)
      (sales_amt sum_1))
    (channel asc nulls-default)
    (col_name asc nulls-default)
    (d_year asc nulls-default)
    (d_qoy asc nulls-default)
    (i_category asc nulls-default))
  (limit 100))
