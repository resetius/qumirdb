(rel limit
  (rel sort
    (rel project
      (rel aggregate (rel project (rel cte-ref 2) (|segments.segment| segment)) (keys segment) (agg count_0 count))
      (segment segment)
      (num_customers count_0)
      (segment_base (* segment 50)))
    (segment asc nulls-default)
    (num_customers asc nulls-default))
  (limit 100))
