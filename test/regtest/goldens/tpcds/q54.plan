(rel limit
  (rel sort
    (rel project
      (rel aggregate
        (rel project
          (rel project
            (rel aggregate
              (rel filter
                (rel join
                  (rel join
                    (rel join
                      (rel join
                        (rel join
                          (rel join
                            (rel project
                              (rel filter
                                (rel join
                                  (rel join
                                    (rel join
                                      (rel project
                                        (rel union-all
                                          (rel project
                                            (rel source "catalog_sales")
                                            (sold_date_sk cs_sold_date_sk)
                                            (customer_sk cs_bill_customer_sk)
                                            (item_sk cs_item_sk))
                                          (rel project
                                            (rel source "web_sales")
                                            (sold_date_sk ws_sold_date_sk)
                                            (customer_sk ws_bill_customer_sk)
                                            (item_sk ws_item_sk)))
                                        (|cs_or_ws_sales.sold_date_sk| sold_date_sk)
                                        (|cs_or_ws_sales.customer_sk| customer_sk)
                                        (|cs_or_ws_sales.item_sk| item_sk))
                                      (rel source "item")
                                      ()
                                      (inner))
                                    (rel source "date_dim")
                                    ()
                                    (inner))
                                  (rel source "customer")
                                  ()
                                  (inner))
                                (&& (&& (&& (&& (&& (&& (== sold_date_sk d_date_sk) (== item_sk i_item_sk))
                                          (== i_category "Jewelry"))
                                        (== i_class "consignment"))
                                      (== c_customer_sk |cs_or_ws_sales.customer_sk|))
                                    (== d_moy 3))
                                  (== d_year 1999)))
                              (c_customer_sk c_customer_sk)
                              (c_current_addr_sk c_current_addr_sk))
                            (rel source "store_sales")
                            ()
                            (inner))
                          (rel source "customer_address")
                          ()
                          (inner))
                        (rel source "store")
                        ()
                        (inner))
                      (rel source "date_dim")
                      ()
                      (inner))
                    (rel project
                      (rel filter (rel source "date_dim") (&& (== d_year 1999) (== d_moy 3)))
                      (__scalar_0__ (+ d_month_seq 1)))
                    ()
                    (inner))
                  (rel project
                    (rel filter (rel source "date_dim") (&& (== d_year 1999) (== d_moy 3)))
                    (__scalar_1__ (+ d_month_seq 3)))
                  ()
                  (inner))
                (&& (&& (&& (&& (&& (&& (== c_current_addr_sk ca_address_sk) (== ca_county s_county)) (== ca_state s_state))
                        (== ss_sold_date_sk d_date_sk))
                      (== c_customer_sk ss_customer_sk))
                    (<= __scalar_0__ d_month_seq))
                  (<= d_month_seq __scalar_1__)))
              (keys c_customer_sk)
              (agg sum_0 sum ss_ext_sales_price))
            (c_customer_sk c_customer_sk)
            (revenue sum_0))
          (segment (cast (/ revenue 50) i32)))
        (keys segment)
        (agg count_0 count))
      (segment segment)
      (num_customers count_0)
      (segment_base (* segment 50)))
    (segment asc nulls-default)
    (num_customers asc nulls-default))
  (limit 100))
