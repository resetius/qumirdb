(rel sort
  (rel project
    (rel filter
      (rel join
        (rel project
          (rel cte-ref 0)
          (|inv1.w_warehouse_name| w_warehouse_name)
          (|inv1.w_warehouse_sk| w_warehouse_sk)
          (|inv1.i_item_sk| i_item_sk)
          (|inv1.d_moy| d_moy)
          (|inv1.stdev| stdev)
          (|inv1.mean| mean)
          (|inv1.cov| cov))
        (rel project
          (rel cte-ref 0)
          (|inv2.w_warehouse_name| w_warehouse_name)
          (|inv2.w_warehouse_sk| w_warehouse_sk)
          (|inv2.i_item_sk| i_item_sk)
          (|inv2.d_moy| d_moy)
          (|inv2.stdev| stdev)
          (|inv2.mean| mean)
          (|inv2.cov| cov))
        ()
        (inner))
      (&& (&& (&& (== |inv1.i_item_sk| |inv2.i_item_sk|) (== |inv1.w_warehouse_sk| |inv2.w_warehouse_sk|))
          (== |inv1.d_moy| 4))
        (== |inv2.d_moy| (+ 4 1))))
    (w_warehouse_sk |inv1.w_warehouse_sk|)
    (i_item_sk |inv1.i_item_sk|)
    (d_moy |inv1.d_moy|)
    (mean |inv1.mean|)
    (cov |inv1.cov|)
    (w_warehouse_sk |inv2.w_warehouse_sk|)
    (i_item_sk |inv2.i_item_sk|)
    (d_moy |inv2.d_moy|)
    (mean |inv2.mean|)
    (cov |inv2.cov|))
  (w_warehouse_sk asc nulls-default)
  (i_item_sk asc nulls-default)
  (d_moy asc nulls-default)
  (mean asc nulls-default)
  (cov asc nulls-default)
  (d_moy asc nulls-default)
  (mean asc nulls-default)
  (cov asc nulls-default))
