(rel limit
  (rel sort
    (rel project
      (rel aggregate
        (rel filter
          (rel join
            (rel join
              (rel join
                (rel join
                  (rel join
                    (rel join
                      (rel join (rel source "web_sales") (rel source "web_returns") () (inner))
                      (rel source "web_page")
                      ()
                      (inner))
                    (rel source "customer_demographics" "cd1")
                    ()
                    (inner))
                  (rel source "customer_demographics" "cd2")
                  ()
                  (inner))
                (rel source "customer_address")
                ()
                (inner))
              (rel source "date_dim")
              ()
              (inner))
            (rel source "reason")
            ()
            (inner))
          (&& (&& (&& (&& (&& (&& (&& (&& (&& (&& (== ws_web_page_sk wp_web_page_sk) (== ws_item_sk wr_item_sk))
                            (== ws_order_number wr_order_number))
                          (== ws_sold_date_sk d_date_sk))
                        (== d_year 1998))
                      (== |cd1.cd_demo_sk| wr_refunded_cdemo_sk))
                    (== |cd2.cd_demo_sk| wr_returning_cdemo_sk))
                  (== ca_address_sk wr_refunded_addr_sk))
                (== r_reason_sk wr_reason_sk))
              (|| (|| (&& (&& (&& (&& (== |cd1.cd_marital_status| (: (cast "M" <named StringView>) <named StringView>))
                          (== |cd1.cd_marital_status| |cd2.cd_marital_status|))
                        (== |cd1.cd_education_status| (: (cast "4 yr Degree" <named StringView>) <named StringView>)))
                      (== |cd1.cd_education_status| |cd2.cd_education_status|))
                    (&& (<= 100 ws_sales_price) (<= ws_sales_price 150)))
                  (&& (&& (&& (&& (== |cd1.cd_marital_status| (: (cast "D" <named StringView>) <named StringView>))
                          (== |cd1.cd_marital_status| |cd2.cd_marital_status|))
                        (== |cd1.cd_education_status| (: (cast "Primary" <named StringView>) <named StringView>)))
                      (== |cd1.cd_education_status| |cd2.cd_education_status|))
                    (&& (<= 50 ws_sales_price) (<= ws_sales_price 100))))
                (&& (&& (&& (&& (== |cd1.cd_marital_status| (: (cast "U" <named StringView>) <named StringView>))
                        (== |cd1.cd_marital_status| |cd2.cd_marital_status|))
                      (== |cd1.cd_education_status| (: (cast "Advanced Degree" <named StringView>) <named StringView>)))
                    (== |cd1.cd_education_status| |cd2.cd_education_status|))
                  (&& (<= 150 ws_sales_price) (<= ws_sales_price 200)))))
            (|| (|| (&& (&& (== ca_country (: (cast "United States" <named StringView>) <named StringView>))
                    (call
                      qdb_in_list
                      ca_state
                      (: (cast "KY" <named StringView>) <named StringView>)
                      (: (cast "GA" <named StringView>) <named StringView>)
                      (: (cast "NM" <named StringView>) <named StringView>)))
                  (&& (<= 100 ws_net_profit) (<= ws_net_profit 200)))
                (&& (&& (== ca_country (: (cast "United States" <named StringView>) <named StringView>))
                    (call
                      qdb_in_list
                      ca_state
                      (: (cast "MT" <named StringView>) <named StringView>)
                      (: (cast "OR" <named StringView>) <named StringView>)
                      (: (cast "IN" <named StringView>) <named StringView>)))
                  (&& (<= 150 ws_net_profit) (<= ws_net_profit 300))))
              (&& (&& (== ca_country (: (cast "United States" <named StringView>) <named StringView>))
                  (call
                    qdb_in_list
                    ca_state
                    (: (cast "WI" <named StringView>) <named StringView>)
                    (: (cast "MO" <named StringView>) <named StringView>)
                    (: (cast "WV" <named StringView>) <named StringView>)))
                (&& (<= 50 ws_net_profit) (<= ws_net_profit 250))))))
        (keys r_reason_desc)
        (agg sum_0 sum ws_quantity)
        (agg count_1 count ws_quantity)
        (agg sum_2 sum wr_refunded_cash)
        (agg count_3 count wr_refunded_cash)
        (agg sum_4 sum wr_fee)
        (agg count_5 count wr_fee))
      (col0 (call substr r_reason_desc 1 20))
      (col1 (/ sum_0 (cast count_1 f64)))
      (col2 (/ sum_2 (cast count_3 f64)))
      (col3 (/ sum_4 (cast count_5 f64))))
    (col0 asc nulls-default)
    (col1 asc nulls-default)
    (col2 asc nulls-default)
    (col3 asc nulls-default))
  (limit 100))
