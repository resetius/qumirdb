(query
  (with
    (cte year_total
      (query
        (union all
          (union all
            (select
              (select-list
                (item as customer_id
                  c_customer_id
                )
                (item as customer_first_name
                  c_first_name
                )
                (item as customer_last_name
                  c_last_name
                )
                (item as customer_preferred_cust_flag
                  c_preferred_cust_flag
                )
                (item as customer_birth_country
                  c_birth_country
                )
                (item as customer_login
                  c_login
                )
                (item as customer_email_address
                  c_email_address
                )
                (item as dyear
                  d_year
                )
                (item as year_total
                  (call sum (/ (+ (- (- ss_ext_list_price ss_ext_wholesale_cost) ss_ext_discount_amt) ss_ext_sales_price) 2))
                )
                (item as sale_type
                  (cast "s" <named StringView>)
                )
              )
              (from
                (table customer)
                (table store_sales)
                (table date_dim)
              )
              (where
                (&& (== c_customer_sk ss_customer_sk) (== ss_sold_date_sk d_date_sk))
              )
              (group-by
                c_customer_id
                c_first_name
                c_last_name
                c_preferred_cust_flag
                c_birth_country
                c_login
                c_email_address
                d_year
              )
            )
            (select
              (select-list
                (item as customer_id
                  c_customer_id
                )
                (item as customer_first_name
                  c_first_name
                )
                (item as customer_last_name
                  c_last_name
                )
                (item as customer_preferred_cust_flag
                  c_preferred_cust_flag
                )
                (item as customer_birth_country
                  c_birth_country
                )
                (item as customer_login
                  c_login
                )
                (item as customer_email_address
                  c_email_address
                )
                (item as dyear
                  d_year
                )
                (item as year_total
                  (call sum (/ (+ (- (- cs_ext_list_price cs_ext_wholesale_cost) cs_ext_discount_amt) cs_ext_sales_price) 2))
                )
                (item as sale_type
                  (cast "c" <named StringView>)
                )
              )
              (from
                (table customer)
                (table catalog_sales)
                (table date_dim)
              )
              (where
                (&& (== c_customer_sk cs_bill_customer_sk) (== cs_sold_date_sk d_date_sk))
              )
              (group-by
                c_customer_id
                c_first_name
                c_last_name
                c_preferred_cust_flag
                c_birth_country
                c_login
                c_email_address
                d_year
              )
            )
          )
          (select
            (select-list
              (item as customer_id
                c_customer_id
              )
              (item as customer_first_name
                c_first_name
              )
              (item as customer_last_name
                c_last_name
              )
              (item as customer_preferred_cust_flag
                c_preferred_cust_flag
              )
              (item as customer_birth_country
                c_birth_country
              )
              (item as customer_login
                c_login
              )
              (item as customer_email_address
                c_email_address
              )
              (item as dyear
                d_year
              )
              (item as year_total
                (call sum (/ (+ (- (- ws_ext_list_price ws_ext_wholesale_cost) ws_ext_discount_amt) ws_ext_sales_price) 2))
              )
              (item as sale_type
                (cast "w" <named StringView>)
              )
            )
            (from
              (table customer)
              (table web_sales)
              (table date_dim)
            )
            (where
              (&& (== c_customer_sk ws_bill_customer_sk) (== ws_sold_date_sk d_date_sk))
            )
            (group-by
              c_customer_id
              c_first_name
              c_last_name
              c_preferred_cust_flag
              c_birth_country
              c_login
              c_email_address
              d_year
            )
          )
        )
      )
    )
  )
  (select
    (select-list
      (item
        |t_s_secyear.customer_id|
      )
      (item
        |t_s_secyear.customer_first_name|
      )
      (item
        |t_s_secyear.customer_last_name|
      )
      (item
        |t_s_secyear.customer_email_address|
      )
    )
    (from
      (table year_total as t_s_firstyear)
      (table year_total as t_s_secyear)
      (table year_total as t_c_firstyear)
      (table year_total as t_c_secyear)
      (table year_total as t_w_firstyear)
      (table year_total as t_w_secyear)
    )
    (where
      (&& (&& (&& (&& (&& (&& (&& (&& (&& (&& (&& (&& (&& (&& (&& (&& (&& (&& (&& (&& (&& (== |t_s_secyear.customer_id| |t_s_firstyear.customer_id|)
                                                (== |t_s_firstyear.customer_id| |t_c_secyear.customer_id|))
                                              (== |t_s_firstyear.customer_id| |t_c_firstyear.customer_id|))
                                            (== |t_s_firstyear.customer_id| |t_w_firstyear.customer_id|))
                                          (== |t_s_firstyear.customer_id| |t_w_secyear.customer_id|))
                                        (== |t_s_firstyear.sale_type| (cast "s" <named StringView>)))
                                      (== |t_c_firstyear.sale_type| (cast "c" <named StringView>)))
                                    (== |t_w_firstyear.sale_type| (cast "w" <named StringView>)))
                                  (== |t_s_secyear.sale_type| (cast "s" <named StringView>)))
                                (== |t_c_secyear.sale_type| (cast "c" <named StringView>)))
                              (== |t_w_secyear.sale_type| (cast "w" <named StringView>)))
                            (== |t_s_firstyear.dyear| 2001))
                          (== |t_s_secyear.dyear| (+ 2001 1)))
                        (== |t_c_firstyear.dyear| 2001))
                      (== |t_c_secyear.dyear| (+ 2001 1)))
                    (== |t_w_firstyear.dyear| 2001))
                  (== |t_w_secyear.dyear| (+ 2001 1)))
                (> |t_s_firstyear.year_total| 0))
              (> |t_c_firstyear.year_total| 0))
            (> |t_w_firstyear.year_total| 0))
          (> (if
              (call qdb_is_true (> |t_c_firstyear.year_total| 0))
              (/ |t_c_secyear.year_total| |t_c_firstyear.year_total|)
              (call qdb_sql_null))
            (if
              (call qdb_is_true (> |t_s_firstyear.year_total| 0))
              (/ |t_s_secyear.year_total| |t_s_firstyear.year_total|)
              (call qdb_sql_null))))
        (> (if
            (call qdb_is_true (> |t_c_firstyear.year_total| 0))
            (/ |t_c_secyear.year_total| |t_c_firstyear.year_total|)
            (call qdb_sql_null))
          (if
            (call qdb_is_true (> |t_w_firstyear.year_total| 0))
            (/ |t_w_secyear.year_total| |t_w_firstyear.year_total|)
            (call qdb_sql_null))))
    )
  )
  (order-by
    (order asc
      |t_s_secyear.customer_id|
    )
    (order asc
      |t_s_secyear.customer_first_name|
    )
    (order asc
      |t_s_secyear.customer_last_name|
    )
    (order asc
      |t_s_secyear.customer_email_address|
    )
  )
  (limit
    100
  )
)
