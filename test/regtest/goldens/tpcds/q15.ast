(query
  (select
    (select-list
      (item
        ca_zip
      )
      (item
        (call sum cs_sales_price)
      )
    )
    (from
      (table catalog_sales)
      (table customer)
      (table customer_address)
      (table date_dim)
    )
    (where
      (&& (&& (&& (&& (&& (== cs_bill_customer_sk c_customer_sk) (== c_current_addr_sk ca_address_sk))
              (|| (|| (block
                    (var __qdb_sql_in = (call substr ca_zip 1 5))
                    (|| (|| (|| (|| (|| (|| (|| (|| (== __qdb_sql_in (: (cast "85669" <named StringView>) <named StringView>))
                                    (== __qdb_sql_in (: (cast "86197" <named StringView>) <named StringView>)))
                                  (== __qdb_sql_in (: (cast "88274" <named StringView>) <named StringView>)))
                                (== __qdb_sql_in (: (cast "83405" <named StringView>) <named StringView>)))
                              (== __qdb_sql_in (: (cast "86475" <named StringView>) <named StringView>)))
                            (== __qdb_sql_in (: (cast "85392" <named StringView>) <named StringView>)))
                          (== __qdb_sql_in (: (cast "85460" <named StringView>) <named StringView>)))
                        (== __qdb_sql_in (: (cast "80348" <named StringView>) <named StringView>)))
                      (== __qdb_sql_in (: (cast "81792" <named StringView>) <named StringView>))))
                  (|| (|| (== ca_state (: (cast "CA" <named StringView>) <named StringView>))
                      (== ca_state (: (cast "WA" <named StringView>) <named StringView>)))
                    (== ca_state (: (cast "GA" <named StringView>) <named StringView>))))
                (> cs_sales_price 500)))
            (== cs_sold_date_sk d_date_sk))
          (== d_qoy 2))
        (== d_year 2000))
    )
    (group-by
      ca_zip
    )
  )
  (order-by
    (order asc
      ca_zip
    )
  )
  (limit
    100
  )
)
