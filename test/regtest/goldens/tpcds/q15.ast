(query
  (select
    (select-list
      (item
        ca_zip
      )
      (item
        (call sum cs_sales_price)
      )
    )
    (from
      (table catalog_sales)
      (table customer)
      (table customer_address)
      (table date_dim)
    )
    (where
      (&& (&& (&& (&& (&& (== cs_bill_customer_sk c_customer_sk) (== c_current_addr_sk ca_address_sk))
              (|| (|| (|| (|| (|| (|| (|| (|| (|| (|| (== (call substr ca_zip 1 5) "85669") (== (call substr ca_zip 1 5) "86197"))
                                (== (call substr ca_zip 1 5) "88274"))
                              (== (call substr ca_zip 1 5) "83405"))
                            (== (call substr ca_zip 1 5) "86475"))
                          (== (call substr ca_zip 1 5) "85392"))
                        (== (call substr ca_zip 1 5) "85460"))
                      (== (call substr ca_zip 1 5) "80348"))
                    (== (call substr ca_zip 1 5) "81792"))
                  (|| (|| (== ca_state "CA") (== ca_state "WA")) (== ca_state "GA")))
                (> cs_sales_price 500)))
            (== cs_sold_date_sk d_date_sk))
          (== d_qoy 2))
        (== d_year 2000))
    )
    (group-by
      ca_zip
    )
  )
  (order-by
    (order asc
      ca_zip
    )
  )
  (limit
    100
  )
)
