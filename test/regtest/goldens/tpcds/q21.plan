(rel limit
  (rel sort
    (rel project
      (rel filter
        (rel project
          (rel project
            (rel aggregate
              (rel project
                (rel filter
                  (rel join
                    (rel join
                      (rel join (rel source "inventory") (rel source "warehouse") () (inner))
                      (rel source "item")
                      ()
                      (inner))
                    (rel source "date_dim")
                    ()
                    (inner))
                  (&& (&& (&& (&& (&& (&& (<= 0.98999999999999999 i_current_price) (<= i_current_price 1.49))
                            (== i_item_sk inv_item_sk))
                          (== inv_warehouse_sk w_warehouse_sk))
                        (== inv_date_sk d_date_sk))
                      (<= (- (: (cast (: (cast "1998-04-08" <named StringView>) <named StringView>) <named DATE>)
                            <named DATE>)
                          (: 30 i32))
                        d_date))
                    (<= d_date
                      (+ (: (cast (: (cast "1998-04-08" <named StringView>) <named StringView>) <named DATE>)
                          <named DATE>)
                        (: 30 i32)))))
                (w_warehouse_name w_warehouse_name)
                (i_item_id i_item_id)
                (arg_0 (if
                    (call
                      qdb_is_true
                      (< (: (cast d_date <named DATE>) <named DATE>)
                        (: (cast (: (cast "1998-04-08" <named StringView>) <named StringView>) <named DATE>)
                          <named DATE>)))
                    inv_quantity_on_hand
                    0))
                (arg_1 (if
                    (call
                      qdb_is_true
                      (>= (: (cast d_date <named DATE>) <named DATE>)
                        (: (cast (: (cast "1998-04-08" <named StringView>) <named StringView>) <named DATE>)
                          <named DATE>)))
                    inv_quantity_on_hand
                    0)))
              (keys w_warehouse_name i_item_id)
              (agg sum_0 sum arg_0)
              (agg sum_1 sum arg_1))
            (w_warehouse_name w_warehouse_name)
            (i_item_id i_item_id)
            (inv_before sum_0)
            (inv_after sum_1))
          (|x.w_warehouse_name| w_warehouse_name)
          (|x.i_item_id| i_item_id)
          (|x.inv_before| inv_before)
          (|x.inv_after| inv_after))
        (&& (<= (/ 2 3) (if (call qdb_is_true (> inv_before 0)) (/ inv_after inv_before) (call qdb_sql_null)))
          (<= (if (call qdb_is_true (> inv_before 0)) (/ inv_after inv_before) (call qdb_sql_null)) (/ 3 2))))
      (w_warehouse_name |x.w_warehouse_name|)
      (i_item_id |x.i_item_id|)
      (inv_before |x.inv_before|)
      (inv_after |x.inv_after|))
    (w_warehouse_name asc nulls-default)
    (i_item_id asc nulls-default))
  (limit 100))
