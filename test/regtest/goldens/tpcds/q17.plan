(rel limit
  (rel sort
    (rel project
      (rel aggregate
        (rel filter
          (rel join
            (rel join
              (rel join
                (rel join
                  (rel join
                    (rel join
                      (rel join (rel source "store_sales") (rel source "store_returns") () (inner))
                      (rel source "catalog_sales")
                      ()
                      (inner))
                    (rel source "date_dim" "d1")
                    ()
                    (inner))
                  (rel source "date_dim" "d2")
                  ()
                  (inner))
                (rel source "date_dim" "d3")
                ()
                (inner))
              (rel source "store")
              ()
              (inner))
            (rel source "item")
            ()
            (inner))
          (&& (&& (&& (&& (&& (&& (&& (&& (&& (&& (&& (&& (== |d1.d_quarter_name| "1998Q1") (== |d1.d_date_sk| ss_sold_date_sk))
                                (== i_item_sk ss_item_sk))
                              (== s_store_sk ss_store_sk))
                            (== ss_customer_sk sr_customer_sk))
                          (== ss_item_sk sr_item_sk))
                        (== ss_ticket_number sr_ticket_number))
                      (== sr_returned_date_sk |d2.d_date_sk|))
                    (|| (|| (== |d2.d_quarter_name| "1998Q1") (== |d2.d_quarter_name| "1998Q2"))
                      (== |d2.d_quarter_name| "1998Q3")))
                  (== sr_customer_sk cs_bill_customer_sk))
                (== sr_item_sk cs_item_sk))
              (== cs_sold_date_sk |d3.d_date_sk|))
            (|| (|| (== |d3.d_quarter_name| "1998Q1") (== |d3.d_quarter_name| "1998Q2"))
              (== |d3.d_quarter_name| "1998Q3"))))
        (keys i_item_id i_item_desc s_state)
        (agg count_0 count ss_quantity)
        (agg sum_1 sum ss_quantity)
        (agg count_2 count)
        (agg sum_3 sum ss_quantity)
        (agg count_4 count)
        (agg count_5 count sr_return_quantity)
        (agg sum_6 sum sr_return_quantity)
        (agg count_7 count)
        (agg sum_8 sum sr_return_quantity)
        (agg count_9 count)
        (agg count_10 count cs_quantity)
        (agg sum_11 sum cs_quantity)
        (agg count_12 count)
        (agg sum_13 sum cs_quantity)
        (agg count_14 count))
      (i_item_id i_item_id)
      (i_item_desc i_item_desc)
      (s_state s_state)
      (store_sales_quantitycount count_0)
      (store_sales_quantityave (/ sum_1 (cast count_2 f64)))
      (store_sales_quantitystdev (call stddev_samp ss_quantity))
      (store_sales_quantitycov (/ (call stddev_samp ss_quantity) (/ sum_3 (cast count_4 f64))))
      (store_returns_quantitycount count_5)
      (store_returns_quantityave (/ sum_6 (cast count_7 f64)))
      (store_returns_quantitystdev (call stddev_samp sr_return_quantity))
      (store_returns_quantitycov (/ (call stddev_samp sr_return_quantity) (/ sum_8 (cast count_9 f64))))
      (catalog_sales_quantitycount count_10)
      (catalog_sales_quantityave (/ sum_11 (cast count_12 f64)))
      (catalog_sales_quantitystdev (call stddev_samp cs_quantity))
      (catalog_sales_quantitycov (/ (call stddev_samp cs_quantity) (/ sum_13 (cast count_14 f64)))))
    (i_item_id asc nulls-default)
    (i_item_desc asc nulls-default)
    (s_state asc nulls-default))
  (limit 100))
