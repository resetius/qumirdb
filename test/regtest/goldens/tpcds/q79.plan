(rel limit
  (rel sort
    (rel project
      (rel filter
        (rel join
          (rel project
            (rel project
              (rel aggregate
                (rel filter
                  (rel join
                    (rel join
                      (rel join (rel source "store_sales") (rel source "date_dim") () (inner))
                      (rel source "store")
                      ()
                      (inner))
                    (rel source "household_demographics")
                    ()
                    (inner))
                  (&& (&& (&& (&& (&& (&& (&& (== |store_sales.ss_sold_date_sk| |date_dim.d_date_sk|)
                                (== |store_sales.ss_store_sk| |store.s_store_sk|))
                              (== |store_sales.ss_hdemo_sk| |household_demographics.hd_demo_sk|))
                            (|| (== |household_demographics.hd_dep_count| 8)
                              (> |household_demographics.hd_vehicle_count| 0)))
                          (== |date_dim.d_dow| 1))
                        (|| (|| (== |date_dim.d_year| 1998) (== |date_dim.d_year| (+ 1998 1)))
                          (== |date_dim.d_year| (+ 1998 2))))
                      (<= 200 |store.s_number_employees|))
                    (<= |store.s_number_employees| 295)))
                (keys ss_ticket_number ss_customer_sk ss_addr_sk |store.s_city|)
                (agg sum_0 sum ss_coupon_amt)
                (agg sum_1 sum ss_net_profit))
              (ss_ticket_number ss_ticket_number)
              (ss_customer_sk ss_customer_sk)
              (s_city |store.s_city|)
              (amt sum_0)
              (profit sum_1))
            (|ms.ss_ticket_number| ss_ticket_number)
            (|ms.ss_customer_sk| ss_customer_sk)
            (|ms.s_city| s_city)
            (|ms.amt| amt)
            (|ms.profit| profit))
          (rel source "customer")
          ()
          (inner))
        (== ss_customer_sk c_customer_sk))
      (c_last_name c_last_name)
      (c_first_name c_first_name)
      (col2 (call substr s_city 1 30))
      (ss_ticket_number ss_ticket_number)
      (amt amt)
      (profit profit))
    (c_last_name asc nulls-default)
    (c_first_name asc nulls-default)
    (col2 asc nulls-default)
    (profit asc nulls-default))
  (limit 100))
