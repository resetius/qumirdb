(rel limit
  (rel sort
    (rel project
      (rel filter
        (rel join
          (rel project
            (rel cte-ref 0)
            (|curr_yr.d_year| d_year)
            (|curr_yr.i_brand_id| i_brand_id)
            (|curr_yr.i_class_id| i_class_id)
            (|curr_yr.i_category_id| i_category_id)
            (|curr_yr.i_manufact_id| i_manufact_id)
            (|curr_yr.sales_cnt| sales_cnt)
            (|curr_yr.sales_amt| sales_amt))
          (rel project
            (rel cte-ref 0)
            (|prev_yr.d_year| d_year)
            (|prev_yr.i_brand_id| i_brand_id)
            (|prev_yr.i_class_id| i_class_id)
            (|prev_yr.i_category_id| i_category_id)
            (|prev_yr.i_manufact_id| i_manufact_id)
            (|prev_yr.sales_cnt| sales_cnt)
            (|prev_yr.sales_amt| sales_amt))
          ()
          (inner))
        (&& (&& (&& (&& (&& (&& (== |curr_yr.i_brand_id| |prev_yr.i_brand_id|) (== |curr_yr.i_class_id| |prev_yr.i_class_id|))
                  (== |curr_yr.i_category_id| |prev_yr.i_category_id|))
                (== |curr_yr.i_manufact_id| |prev_yr.i_manufact_id|))
              (== |curr_yr.d_year| 2002))
            (== |prev_yr.d_year| (- 2002 1)))
          (< (/ (: (cast |curr_yr.sales_cnt| <named DECIMAL [17 2]>) <named DECIMAL [17 2]>)
              (: (cast |prev_yr.sales_cnt| <named DECIMAL [17 2]>) <named DECIMAL [17 2]>))
            0.90000000000000002)))
      (prev_year |prev_yr.d_year|)
      (year |curr_yr.d_year|)
      (i_brand_id |curr_yr.i_brand_id|)
      (i_class_id |curr_yr.i_class_id|)
      (i_category_id |curr_yr.i_category_id|)
      (i_manufact_id |curr_yr.i_manufact_id|)
      (prev_yr_cnt |prev_yr.sales_cnt|)
      (curr_yr_cnt |curr_yr.sales_cnt|)
      (sales_cnt_diff (- |curr_yr.sales_cnt| |prev_yr.sales_cnt|))
      (sales_amt_diff (- |curr_yr.sales_amt| |prev_yr.sales_amt|)))
    (sales_cnt_diff asc nulls-default)
    (sales_amt_diff asc nulls-default))
  (limit 100))
