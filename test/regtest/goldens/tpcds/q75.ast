(query
  (with
    (cte all_sales
      (query
        (select
          (select-list
            (item
              d_year
            )
            (item
              i_brand_id
            )
            (item
              i_class_id
            )
            (item
              i_category_id
            )
            (item
              i_manufact_id
            )
            (item as sales_cnt
              (call sum sales_cnt)
            )
            (item as sales_amt
              (call sum sales_amt)
            )
          )
          (from
            (subquery-table as sales_detail
              (query
                (union distinct
                  (union distinct
                    (select
                      (select-list
                        (item
                          d_year
                        )
                        (item
                          i_brand_id
                        )
                        (item
                          i_class_id
                        )
                        (item
                          i_category_id
                        )
                        (item
                          i_manufact_id
                        )
                        (item as sales_cnt
                          (- cs_quantity (call coalesce cr_return_quantity 0))
                        )
                        (item as sales_amt
                          (- cs_ext_sales_price (call coalesce cr_return_amount 0))
                        )
                      )
                      (from
                        (join left
                          (join inner
                            (join inner
                              (table catalog_sales)
                              (table item)
                              (on
                                (== i_item_sk cs_item_sk)
                              )
                            )
                            (table date_dim)
                            (on
                              (== d_date_sk cs_sold_date_sk)
                            )
                          )
                          (table catalog_returns)
                          (on
                            (&& (== cs_order_number cr_order_number) (== cs_item_sk cr_item_sk))
                          )
                        )
                      )
                      (where
                        (== i_category (cast "Sports" <named StringView>))
                      )
                    )
                    (select
                      (select-list
                        (item
                          d_year
                        )
                        (item
                          i_brand_id
                        )
                        (item
                          i_class_id
                        )
                        (item
                          i_category_id
                        )
                        (item
                          i_manufact_id
                        )
                        (item as sales_cnt
                          (- ss_quantity (call coalesce sr_return_quantity 0))
                        )
                        (item as sales_amt
                          (- ss_ext_sales_price (call coalesce sr_return_amt 0))
                        )
                      )
                      (from
                        (join left
                          (join inner
                            (join inner
                              (table store_sales)
                              (table item)
                              (on
                                (== i_item_sk ss_item_sk)
                              )
                            )
                            (table date_dim)
                            (on
                              (== d_date_sk ss_sold_date_sk)
                            )
                          )
                          (table store_returns)
                          (on
                            (&& (== ss_ticket_number sr_ticket_number) (== ss_item_sk sr_item_sk))
                          )
                        )
                      )
                      (where
                        (== i_category (cast "Sports" <named StringView>))
                      )
                    )
                  )
                  (select
                    (select-list
                      (item
                        d_year
                      )
                      (item
                        i_brand_id
                      )
                      (item
                        i_class_id
                      )
                      (item
                        i_category_id
                      )
                      (item
                        i_manufact_id
                      )
                      (item as sales_cnt
                        (- ws_quantity (call coalesce wr_return_quantity 0))
                      )
                      (item as sales_amt
                        (- ws_ext_sales_price (call coalesce wr_return_amt 0))
                      )
                    )
                    (from
                      (join left
                        (join inner
                          (join inner
                            (table web_sales)
                            (table item)
                            (on
                              (== i_item_sk ws_item_sk)
                            )
                          )
                          (table date_dim)
                          (on
                            (== d_date_sk ws_sold_date_sk)
                          )
                        )
                        (table web_returns)
                        (on
                          (&& (== ws_order_number wr_order_number) (== ws_item_sk wr_item_sk))
                        )
                      )
                    )
                    (where
                      (== i_category (cast "Sports" <named StringView>))
                    )
                  )
                )
              )
            )
          )
          (group-by
            d_year
            i_brand_id
            i_class_id
            i_category_id
            i_manufact_id
          )
        )
      )
    )
  )
  (select
    (select-list
      (item as prev_year
        |prev_yr.d_year|
      )
      (item as year
        |curr_yr.d_year|
      )
      (item
        |curr_yr.i_brand_id|
      )
      (item
        |curr_yr.i_class_id|
      )
      (item
        |curr_yr.i_category_id|
      )
      (item
        |curr_yr.i_manufact_id|
      )
      (item as prev_yr_cnt
        |prev_yr.sales_cnt|
      )
      (item as curr_yr_cnt
        |curr_yr.sales_cnt|
      )
      (item as sales_cnt_diff
        (- |curr_yr.sales_cnt| |prev_yr.sales_cnt|)
      )
      (item as sales_amt_diff
        (- |curr_yr.sales_amt| |prev_yr.sales_amt|)
      )
    )
    (from
      (table all_sales as curr_yr)
      (table all_sales as prev_yr)
    )
    (where
      (&& (&& (&& (&& (&& (&& (== |curr_yr.i_brand_id| |prev_yr.i_brand_id|) (== |curr_yr.i_class_id| |prev_yr.i_class_id|))
                (== |curr_yr.i_category_id| |prev_yr.i_category_id|))
              (== |curr_yr.i_manufact_id| |prev_yr.i_manufact_id|))
            (== |curr_yr.d_year| 2002))
          (== |prev_yr.d_year| (- 2002 1)))
        (< (/ (cast |curr_yr.sales_cnt| <named DECIMAL [17 2]>) (cast |prev_yr.sales_cnt| <named DECIMAL [17 2]>))
          0.90000000000000002))
    )
  )
  (order-by
    (order asc
      sales_cnt_diff
    )
    (order asc
      sales_amt_diff
    )
  )
  (limit
    100
  )
)
