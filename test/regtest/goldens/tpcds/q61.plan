(rel limit
  (rel sort
    (rel project
      (rel join
        (rel project
          (rel project
            (rel aggregate
              (rel project
                (rel filter
                  (rel join
                    (rel join
                      (rel join
                        (rel join
                          (rel join
                            (rel join (rel source "store_sales") (rel source "store") () (inner))
                            (rel source "promotion")
                            ()
                            (inner))
                          (rel source "date_dim")
                          ()
                          (inner))
                        (rel source "customer")
                        ()
                        (inner))
                      (rel source "customer_address")
                      ()
                      (inner))
                    (rel source "item")
                    ()
                    (inner))
                  (&& (&& (&& (&& (&& (&& (&& (&& (&& (&& (&& (== ss_sold_date_sk d_date_sk) (== ss_store_sk s_store_sk))
                                      (== ss_promo_sk p_promo_sk))
                                    (== ss_customer_sk c_customer_sk))
                                  (== ca_address_sk c_current_addr_sk))
                                (== ss_item_sk i_item_sk))
                              (== ca_gmt_offset (- 7)))
                            (== i_category (: (cast "Books" <named StringView>) <named StringView>)))
                          (|| (|| (== p_channel_dmail (: (cast "Y" <named StringView>) <named StringView>))
                              (== p_channel_email (: (cast "Y" <named StringView>) <named StringView>)))
                            (== p_channel_tv (: (cast "Y" <named StringView>) <named StringView>))))
                        (== s_gmt_offset (- 7)))
                      (== d_year 1999))
                    (== d_moy 11)))
                (ss_ext_sales_price ss_ext_sales_price)
                (__group__ 1))
              (keys __group__)
              (agg sum_0 sum ss_ext_sales_price))
            (promotions sum_0))
          (|promotional_sales.promotions| promotions))
        (rel project
          (rel project
            (rel aggregate
              (rel project
                (rel filter
                  (rel join
                    (rel join
                      (rel join
                        (rel join
                          (rel join (rel source "store_sales") (rel source "store") () (inner))
                          (rel source "date_dim")
                          ()
                          (inner))
                        (rel source "customer")
                        ()
                        (inner))
                      (rel source "customer_address")
                      ()
                      (inner))
                    (rel source "item")
                    ()
                    (inner))
                  (&& (&& (&& (&& (&& (&& (&& (&& (&& (== ss_sold_date_sk d_date_sk) (== ss_store_sk s_store_sk))
                                  (== ss_customer_sk c_customer_sk))
                                (== ca_address_sk c_current_addr_sk))
                              (== ss_item_sk i_item_sk))
                            (== ca_gmt_offset (- 7)))
                          (== i_category (: (cast "Books" <named StringView>) <named StringView>)))
                        (== s_gmt_offset (- 7)))
                      (== d_year 1999))
                    (== d_moy 11)))
                (ss_ext_sales_price ss_ext_sales_price)
                (__group__ 1))
              (keys __group__)
              (agg sum_0 sum ss_ext_sales_price))
            (total sum_0))
          (|all_sales.total| total))
        ()
        (inner))
      (promotions promotions)
      (total total)
      (col2 (* (/ (: (cast promotions <named DECIMAL>) <named DECIMAL>) (: (cast total <named DECIMAL>) <named DECIMAL>))
          100)))
    (promotions asc nulls-default)
    (total asc nulls-default))
  (limit 100))
