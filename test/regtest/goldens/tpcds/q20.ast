(query
  (select
    (select-list
      (item
        i_item_id
      )
      (item
        i_item_desc
      )
      (item
        i_category
      )
      (item
        i_class
      )
      (item
        i_current_price
      )
      (item as itemrevenue
        (call sum cs_ext_sales_price)
      )
      (item as revenueratio
        (/ (* (call sum cs_ext_sales_price) 100)
          (window
            (call sum (call sum cs_ext_sales_price))
            (over
              (partition-by
                (block
                  i_class))
              (range
                (between
                  (unbounded-preceding)
                  (unbounded-following))))))
      )
    )
    (from
      (table catalog_sales)
      (table item)
      (table date_dim)
    )
    (where
      (&& (&& (&& (== cs_item_sk i_item_sk)
            (|| (|| (== i_category (: (cast "Jewelry" <named StringView>) <named StringView>))
                (== i_category (: (cast "Sports" <named StringView>) <named StringView>)))
              (== i_category (: (cast "Books" <named StringView>) <named StringView>))))
          (== cs_sold_date_sk d_date_sk))
        (&& (<= (: (cast (: (cast "2001-01-12" <named StringView>) <named StringView>) <named DATE>) <named DATE>) d_date)
          (<= d_date
            (+ (: (cast (: (cast "2001-01-12" <named StringView>) <named StringView>) <named DATE>) <named DATE>) (: 30 i32)))))
    )
    (group-by
      i_item_id
      i_item_desc
      i_category
      i_class
      i_current_price
    )
  )
  (order-by
    (order asc
      i_category
    )
    (order asc
      i_class
    )
    (order asc
      i_item_id
    )
    (order asc
      i_item_desc
    )
    (order asc
      revenueratio
    )
  )
  (limit
    100
  )
)
