(rel limit
  (rel sort
    (rel project
      (rel aggregate
        (rel project
          (rel filter
            (rel join
              (rel join
                (rel join
                  (rel join (rel source "store_sales") (rel source "store_returns") () (inner))
                  (rel source "store")
                  ()
                  (inner))
                (rel source "date_dim" "d1")
                ()
                (inner))
              (rel source "date_dim" "d2")
              ()
              (inner))
            (&& (&& (&& (&& (&& (&& (&& (== |d2.d_year| 2000) (== |d2.d_moy| 9)) (== ss_ticket_number sr_ticket_number))
                      (== ss_item_sk sr_item_sk))
                    (== ss_sold_date_sk |d1.d_date_sk|))
                  (== sr_returned_date_sk |d2.d_date_sk|))
                (== ss_customer_sk sr_customer_sk))
              (== ss_store_sk s_store_sk)))
          (s_store_name s_store_name)
          (s_company_id s_company_id)
          (s_street_number s_street_number)
          (s_street_name s_street_name)
          (s_street_type s_street_type)
          (s_suite_number s_suite_number)
          (s_city s_city)
          (s_county s_county)
          (s_state s_state)
          (s_zip s_zip)
          (arg_0 (if (<= (- sr_returned_date_sk ss_sold_date_sk) 30) 1 0))
          (arg_1 (if (&& (> (- sr_returned_date_sk ss_sold_date_sk) 30) (<= (- sr_returned_date_sk ss_sold_date_sk) 60)) 1 0))
          (arg_2 (if (&& (> (- sr_returned_date_sk ss_sold_date_sk) 60) (<= (- sr_returned_date_sk ss_sold_date_sk) 90)) 1 0))
          (arg_3 (if
              (&& (> (- sr_returned_date_sk ss_sold_date_sk) 90) (<= (- sr_returned_date_sk ss_sold_date_sk) 120))
              1
              0))
          (arg_4 (if (> (- sr_returned_date_sk ss_sold_date_sk) 120) 1 0)))
        (keys s_store_name s_company_id s_street_number s_street_name s_street_type s_suite_number s_city s_county s_state s_zip)
        (agg sum_0 sum arg_0)
        (agg sum_1 sum arg_1)
        (agg sum_2 sum arg_2)
        (agg sum_3 sum arg_3)
        (agg sum_4 sum arg_4))
      (s_store_name s_store_name)
      (s_company_id s_company_id)
      (s_street_number s_street_number)
      (s_street_name s_street_name)
      (s_street_type s_street_type)
      (s_suite_number s_suite_number)
      (s_city s_city)
      (s_county s_county)
      (s_state s_state)
      (s_zip s_zip)
      (|30 days| sum_0)
      (|31-60 days| sum_1)
      (|61-90 days| sum_2)
      (|91-120 days| sum_3)
      (|>120 days| sum_4))
    (s_store_name asc nulls-default)
    (s_company_id asc nulls-default)
    (s_street_number asc nulls-default)
    (s_street_name asc nulls-default)
    (s_street_type asc nulls-default)
    (s_suite_number asc nulls-default)
    (s_city asc nulls-default)
    (s_county asc nulls-default)
    (s_state asc nulls-default)
    (s_zip asc nulls-default))
  (limit 100))
