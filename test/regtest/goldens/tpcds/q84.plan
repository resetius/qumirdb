(rel limit
  (rel sort
    (rel project
      (rel filter
        (rel join
          (rel join
            (rel join
              (rel join
                (rel join (rel source "customer") (rel source "customer_address") () (inner))
                (rel source "customer_demographics")
                ()
                (inner))
              (rel source "household_demographics")
              ()
              (inner))
            (rel source "income_band")
            ()
            (inner))
          (rel source "store_returns")
          ()
          (inner))
        (&& (&& (&& (&& (&& (&& (&& (== ca_city (cast "Hopewell" <named StringView>)) (== c_current_addr_sk ca_address_sk))
                    (>= ib_lower_bound 32287))
                  (<= ib_upper_bound (+ 32287 50000)))
                (== ib_income_band_sk hd_income_band_sk))
              (== cd_demo_sk c_current_cdemo_sk))
            (== hd_demo_sk c_current_hdemo_sk))
          (== sr_cdemo_sk cd_demo_sk)))
      (customer_id c_customer_id)
      (customername (call
          strcat
          (call strcat (call coalesce c_last_name (cast "" <named StringView>)) (cast ", " <named StringView>))
          (call coalesce c_first_name (cast "" <named StringView>)))))
    (customer_id asc nulls-default))
  (limit 100))
