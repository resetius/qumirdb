(rel project
  (rel aggregate
    (rel project
      (rel filter
        (rel join
          (rel join
            (rel join
              (rel join
                (rel join (rel source "store_sales") (rel source "store") () (inner))
                (rel source "customer_demographics")
                ()
                (inner))
              (rel source "household_demographics")
              ()
              (inner))
            (rel source "customer_address")
            ()
            (inner))
          (rel source "date_dim")
          ()
          (inner))
        (&& (&& (&& (&& (== s_store_sk ss_store_sk) (== ss_sold_date_sk d_date_sk)) (== d_year 2001))
            (|| (|| (&& (&& (&& (&& (&& (== ss_hdemo_sk hd_demo_sk) (== cd_demo_sk ss_cdemo_sk))
                        (== cd_marital_status (: (cast "D" <named StringView>) <named StringView>)))
                      (== cd_education_status (: (cast "2 yr Degree" <named StringView>) <named StringView>)))
                    (&& (<= 100 ss_sales_price) (<= ss_sales_price 150)))
                  (== hd_dep_count 3))
                (&& (&& (&& (&& (&& (== ss_hdemo_sk hd_demo_sk) (== cd_demo_sk ss_cdemo_sk))
                        (== cd_marital_status (: (cast "S" <named StringView>) <named StringView>)))
                      (== cd_education_status (: (cast "Secondary" <named StringView>) <named StringView>)))
                    (&& (<= 50 ss_sales_price) (<= ss_sales_price 100)))
                  (== hd_dep_count 1)))
              (&& (&& (&& (&& (&& (== ss_hdemo_sk hd_demo_sk) (== cd_demo_sk ss_cdemo_sk))
                      (== cd_marital_status (: (cast "W" <named StringView>) <named StringView>)))
                    (== cd_education_status (: (cast "Advanced Degree" <named StringView>) <named StringView>)))
                  (&& (<= 150 ss_sales_price) (<= ss_sales_price 200)))
                (== hd_dep_count 1))))
          (|| (|| (&& (&& (&& (== ss_addr_sk ca_address_sk)
                    (== ca_country (: (cast "United States" <named StringView>) <named StringView>)))
                  (|| (|| (== ca_state (: (cast "CO" <named StringView>) <named StringView>))
                      (== ca_state (: (cast "IL" <named StringView>) <named StringView>)))
                    (== ca_state (: (cast "MN" <named StringView>) <named StringView>))))
                (&& (<= 100 ss_net_profit) (<= ss_net_profit 200)))
              (&& (&& (&& (== ss_addr_sk ca_address_sk)
                    (== ca_country (: (cast "United States" <named StringView>) <named StringView>)))
                  (|| (|| (== ca_state (: (cast "OH" <named StringView>) <named StringView>))
                      (== ca_state (: (cast "MT" <named StringView>) <named StringView>)))
                    (== ca_state (: (cast "NM" <named StringView>) <named StringView>))))
                (&& (<= 150 ss_net_profit) (<= ss_net_profit 300))))
            (&& (&& (&& (== ss_addr_sk ca_address_sk)
                  (== ca_country (: (cast "United States" <named StringView>) <named StringView>)))
                (|| (|| (== ca_state (: (cast "TX" <named StringView>) <named StringView>))
                    (== ca_state (: (cast "MO" <named StringView>) <named StringView>)))
                  (== ca_state (: (cast "MI" <named StringView>) <named StringView>))))
              (&& (<= 50 ss_net_profit) (<= ss_net_profit 250))))))
      (ss_quantity ss_quantity)
      (ss_ext_sales_price ss_ext_sales_price)
      (ss_ext_wholesale_cost ss_ext_wholesale_cost)
      (__group__ 1))
    (keys __group__)
    (agg sum_0 sum ss_quantity)
    (agg count_1 count)
    (agg sum_2 sum ss_ext_sales_price)
    (agg count_3 count)
    (agg sum_4 sum ss_ext_wholesale_cost)
    (agg count_5 count)
    (agg sum_6 sum ss_ext_wholesale_cost))
  (col0 (/ sum_0 (cast count_1 f64)))
  (col1 (/ sum_2 (cast count_3 f64)))
  (col2 (/ sum_4 (cast count_5 f64)))
  (col3 sum_6))
