(query
  (select
    (select-list
      (item
        ca_state
      )
      (item
        cd_gender
      )
      (item
        cd_marital_status
      )
      (item
        cd_dep_count
      )
      (item as cnt1
        (call count *)
      )
      (item as aggone1
        (call avg cd_dep_count)
      )
      (item as aggtwo1
        (call max cd_dep_count)
      )
      (item as aggthree1
        (call sum cd_dep_count)
      )
      (item
        cd_dep_employed_count
      )
      (item as cnt2
        (call count *)
      )
      (item as aggone2
        (call avg cd_dep_employed_count)
      )
      (item as aggtwo2
        (call max cd_dep_employed_count)
      )
      (item as aggthree2
        (call sum cd_dep_employed_count)
      )
      (item
        cd_dep_college_count
      )
      (item as cnt3
        (call count *)
      )
      (item as aggone3
        (call avg cd_dep_college_count)
      )
      (item as aggtwo3
        (call max cd_dep_college_count)
      )
      (item as aggthree3
        (call sum cd_dep_college_count)
      )
    )
    (from
      (table customer as c)
      (table customer_address as ca)
      (table customer_demographics)
    )
    (where
      (&& (&& (&& (== |c.c_current_addr_sk| |ca.ca_address_sk|) (== cd_demo_sk |c.c_current_cdemo_sk|))
          (subquery exists (query
        (select
          (select-list
            (star *)
          )
          (from
            (table store_sales)
            (table date_dim)
          )
          (where
            (&& (&& (&& (== |c.c_customer_sk| ss_customer_sk) (== ss_sold_date_sk d_date_sk)) (== d_year 1999)) (< d_qoy 4))
          )
        )
      )
      ))
        (|| (subquery exists (query
        (select
          (select-list
            (star *)
          )
          (from
            (table web_sales)
            (table date_dim)
          )
          (where
            (&& (&& (&& (== |c.c_customer_sk| ws_bill_customer_sk) (== ws_sold_date_sk d_date_sk)) (== d_year 1999)) (< d_qoy 4))
          )
        )
      )
      )
          (subquery exists (query
        (select
          (select-list
            (star *)
          )
          (from
            (table catalog_sales)
            (table date_dim)
          )
          (where
            (&& (&& (&& (== |c.c_customer_sk| cs_ship_customer_sk) (== cs_sold_date_sk d_date_sk)) (== d_year 1999)) (< d_qoy 4))
          )
        )
      )
      )))
    )
    (group-by
      ca_state
      cd_gender
      cd_marital_status
      cd_dep_count
      cd_dep_employed_count
      cd_dep_college_count
    )
  )
  (order-by
    (order asc
      ca_state
    )
    (order asc
      cd_gender
    )
    (order asc
      cd_marital_status
    )
    (order asc
      cd_dep_count
    )
    (order asc
      cd_dep_employed_count
    )
    (order asc
      cd_dep_college_count
    )
  )
  (limit
    100
  )
)
