(rel limit
  (rel sort
    (rel project
      (rel aggregate
        (rel project
          (rel union-all
            (rel project
              (rel project (rel cte-ref 0) (|ss.i_item_id| i_item_id) (|ss.total_sales| total_sales))
              (i_item_id |ss.i_item_id|)
              (total_sales |ss.total_sales|))
            (rel project
              (rel project (rel cte-ref 1) (|cs.i_item_id| i_item_id) (|cs.total_sales| total_sales))
              (i_item_id |cs.i_item_id|)
              (total_sales |cs.total_sales|))
            (rel project
              (rel project (rel cte-ref 2) (|ws.i_item_id| i_item_id) (|ws.total_sales| total_sales))
              (i_item_id |ws.i_item_id|)
              (total_sales |ws.total_sales|)))
          (|tmp1.i_item_id| i_item_id)
          (|tmp1.total_sales| total_sales))
        (keys i_item_id)
        (agg sum_0 sum total_sales))
      (i_item_id i_item_id)
      (total_sales sum_0))
    (total_sales asc nulls-default)
    (i_item_id asc nulls-default))
  (limit 100))
