(rel limit
  (rel sort
    (rel project
      (rel filter
        (rel join
          (rel join
            (rel join
              (rel project
                (rel project
                  (rel aggregate
                    (rel filter
                      (rel join
                        (rel join (rel source "web_returns") (rel source "date_dim") () (inner))
                        (rel source "customer_address")
                        ()
                        (inner))
                      (&& (&& (== wr_returned_date_sk d_date_sk) (== d_year 2002))
                        (== wr_returning_addr_sk ca_address_sk)))
                    (keys wr_returning_customer_sk ca_state)
                    (agg sum_0 sum wr_return_amt))
                  (ctr_customer_sk wr_returning_customer_sk)
                  (ctr_state ca_state)
                  (ctr_total_return sum_0))
                (|ctr1.ctr_customer_sk| ctr_customer_sk)
                (|ctr1.ctr_state| ctr_state)
                (|ctr1.ctr_total_return| ctr_total_return))
              (rel source "customer_address")
              ()
              (inner))
            (rel source "customer")
            ()
            (inner))
          (rel project
            (rel aggregate
              (rel project
                (rel filter
                  (rel project
                    (rel project
                      (rel aggregate
                        (rel filter
                          (rel join
                            (rel join (rel source "web_returns") (rel source "date_dim") () (inner))
                            (rel source "customer_address")
                            ()
                            (inner))
                          (&& (&& (== wr_returned_date_sk d_date_sk) (== d_year 2002))
                            (== wr_returning_addr_sk ca_address_sk)))
                        (keys wr_returning_customer_sk ca_state)
                        (agg sum_0 sum wr_return_amt))
                      (ctr_customer_sk wr_returning_customer_sk)
                      (ctr_state ca_state)
                      (ctr_total_return sum_0))
                    (|ctr2.ctr_customer_sk| ctr_customer_sk)
                    (|ctr2.ctr_state| ctr_state)
                    (|ctr2.ctr_total_return| ctr_total_return))
                  (== |ctr1.ctr_state| |ctr2.ctr_state|))
                (ctr_total_return ctr_total_return)
                (__group__ 1))
              (keys __group__)
              (agg sum_0 sum ctr_total_return)
              (agg count_1 count))
            (__scalar_0__ (* (/ sum_0 (cast count_1 f64)) 1.2)))
          ()
          (inner))
        (&& (&& (&& (> |ctr1.ctr_total_return| __scalar_0__) (== ca_address_sk c_current_addr_sk)) (== ca_state "IL"))
          (== |ctr1.ctr_customer_sk| c_customer_sk)))
      (c_customer_id c_customer_id)
      (c_salutation c_salutation)
      (c_first_name c_first_name)
      (c_last_name c_last_name)
      (c_preferred_cust_flag c_preferred_cust_flag)
      (c_birth_day c_birth_day)
      (c_birth_month c_birth_month)
      (c_birth_year c_birth_year)
      (c_birth_country c_birth_country)
      (c_login c_login)
      (c_email_address c_email_address)
      (c_last_review_date_sk c_last_review_date_sk)
      (ctr_total_return ctr_total_return))
    (c_customer_id asc nulls-default)
    (c_salutation asc nulls-default)
    (c_first_name asc nulls-default)
    (c_last_name asc nulls-default)
    (c_preferred_cust_flag asc nulls-default)
