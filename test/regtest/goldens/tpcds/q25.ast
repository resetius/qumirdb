(query
  (select
    (select-list
      (item
        i_item_id
      )
      (item
        i_item_desc
      )
      (item
        s_store_id
      )
      (item
        s_store_name
      )
      (item as store_sales_profit
        (call sum ss_net_profit)
      )
      (item as store_returns_loss
        (call sum sr_net_loss)
      )
      (item as catalog_sales_profit
        (call sum cs_net_profit)
      )
    )
    (from
      (table store_sales)
      (table store_returns)
      (table catalog_sales)
      (table date_dim as d1)
      (table date_dim as d2)
      (table date_dim as d3)
      (table store)
      (table item)
    )
    (where
      (&& (&& (&& (&& (&& (&& (&& (&& (&& (&& (&& (&& (&& (&& (&& (== |d1.d_moy| 4) (== |d1.d_year| 2000)) (== |d1.d_date_sk| ss_sold_date_sk))
                                (== i_item_sk ss_item_sk))
                              (== s_store_sk ss_store_sk))
                            (== ss_customer_sk sr_customer_sk))
                          (== ss_item_sk sr_item_sk))
                        (== ss_ticket_number sr_ticket_number))
                      (== sr_returned_date_sk |d2.d_date_sk|))
                    (&& (<= 4 |d2.d_moy|) (<= |d2.d_moy| 10)))
                  (== |d2.d_year| 2000))
                (== sr_customer_sk cs_bill_customer_sk))
              (== sr_item_sk cs_item_sk))
            (== cs_sold_date_sk |d3.d_date_sk|))
          (&& (<= 4 |d3.d_moy|) (<= |d3.d_moy| 10)))
        (== |d3.d_year| 2000))
    )
    (group-by
      i_item_id
      i_item_desc
      s_store_id
      s_store_name
    )
  )
  (order-by
    (order asc
      i_item_id
    )
    (order asc
      i_item_desc
    )
    (order asc
      s_store_id
    )
    (order asc
      s_store_name
    )
  )
  (limit
    100
  )
)
