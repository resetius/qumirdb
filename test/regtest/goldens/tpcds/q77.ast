(query
  (with
    (cte ss
      (query
        (select
          (select-list
            (item
              s_store_sk
            )
            (item as sales
              (call sum ss_ext_sales_price)
            )
            (item as profit
              (call sum ss_net_profit)
            )
          )
          (from
            (table store_sales)
            (table date_dim)
            (table store)
          )
          (where
            (&& (&& (== ss_sold_date_sk d_date_sk)
                (&& (<= (: (cast "1998-08-04" <named DATE>) <named DATE>) d_date)
                  (<= d_date (+ (: (cast "1998-08-04" <named DATE>) <named DATE>) (: 30 i32)))))
              (== ss_store_sk s_store_sk))
          )
          (group-by
            s_store_sk
          )
        )
      )
    )
    (cte sr
      (query
        (select
          (select-list
            (item
              s_store_sk
            )
            (item as returns
              (call sum sr_return_amt)
            )
            (item as profit_loss
              (call sum sr_net_loss)
            )
          )
          (from
            (table store_returns)
            (table date_dim)
            (table store)
          )
          (where
            (&& (&& (== sr_returned_date_sk d_date_sk)
                (&& (<= (: (cast "1998-08-04" <named DATE>) <named DATE>) d_date)
                  (<= d_date (+ (: (cast "1998-08-04" <named DATE>) <named DATE>) (: 30 i32)))))
              (== sr_store_sk s_store_sk))
          )
          (group-by
            s_store_sk
          )
        )
      )
    )
    (cte cs
      (query
        (select
          (select-list
            (item
              cs_call_center_sk
            )
            (item as sales
              (call sum cs_ext_sales_price)
            )
            (item as profit
              (call sum cs_net_profit)
            )
          )
          (from
            (table catalog_sales)
            (table date_dim)
          )
          (where
            (&& (== cs_sold_date_sk d_date_sk)
              (&& (<= (: (cast "1998-08-04" <named DATE>) <named DATE>) d_date)
                (<= d_date (+ (: (cast "1998-08-04" <named DATE>) <named DATE>) (: 30 i32)))))
          )
          (group-by
            cs_call_center_sk
          )
        )
      )
    )
    (cte cr
      (query
        (select
          (select-list
            (item
              cr_call_center_sk
            )
            (item as returns
              (call sum cr_return_amount)
            )
            (item as profit_loss
              (call sum cr_net_loss)
            )
          )
          (from
            (table catalog_returns)
            (table date_dim)
          )
          (where
            (&& (== cr_returned_date_sk d_date_sk)
              (&& (<= (: (cast "1998-08-04" <named DATE>) <named DATE>) d_date)
                (<= d_date (+ (: (cast "1998-08-04" <named DATE>) <named DATE>) (: 30 i32)))))
          )
          (group-by
            cr_call_center_sk
          )
        )
      )
    )
    (cte ws
      (query
        (select
          (select-list
            (item
              wp_web_page_sk
            )
            (item as sales
              (call sum ws_ext_sales_price)
            )
            (item as profit
              (call sum ws_net_profit)
            )
          )
          (from
            (table web_sales)
            (table date_dim)
            (table web_page)
          )
          (where
            (&& (&& (== ws_sold_date_sk d_date_sk)
                (&& (<= (: (cast "1998-08-04" <named DATE>) <named DATE>) d_date)
                  (<= d_date (+ (: (cast "1998-08-04" <named DATE>) <named DATE>) (: 30 i32)))))
              (== ws_web_page_sk wp_web_page_sk))
          )
          (group-by
            wp_web_page_sk
          )
        )
      )
    )
    (cte wr
      (query
        (select
          (select-list
            (item
              wp_web_page_sk
            )
            (item as returns
              (call sum wr_return_amt)
            )
            (item as profit_loss
              (call sum wr_net_loss)
            )
          )
          (from
            (table web_returns)
            (table date_dim)
            (table web_page)
          )
          (where
            (&& (&& (== wr_returned_date_sk d_date_sk)
                (&& (<= (: (cast "1998-08-04" <named DATE>) <named DATE>) d_date)
                  (<= d_date (+ (: (cast "1998-08-04" <named DATE>) <named DATE>) (: 30 i32)))))
              (== wr_web_page_sk wp_web_page_sk))
          )
          (group-by
            wp_web_page_sk
          )
        )
      )
    )
  )
  (select
    (select-list
      (item
        channel
      )
      (item
        id
      )
      (item as sales
        (call sum sales)
      )
      (item as returns
        (call sum returns)
      )
      (item as profit
        (call sum profit)
      )
    )
    (from
      (subquery-table as x
        (query
          (unknown-body)
        )
      )
    )
    (group-by
      (rollup
        (block
          channel
          id)
      )
    )
  )
  (order-by
    (order asc
      channel
    )
    (order asc
      id
    )
  )
  (limit
    100
  )
)
