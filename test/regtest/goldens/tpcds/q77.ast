(query
  (with
    (cte ss
      (query
        (select
          (select-list
            (item
              s_store_sk
            )
            (item as sales
              (call sum ss_ext_sales_price)
            )
            (item as profit
              (call sum ss_net_profit)
            )
          )
          (from
            (table store_sales)
            (table date_dim)
            (table store)
          )
          (where
            (&& (&& (== ss_sold_date_sk d_date_sk)
                (&& (<= (cast (cast "1998-08-04" <named StringView>) <named DATE>) d_date)
                  (<= d_date (+ (cast (cast "1998-08-04" <named StringView>) <named DATE>) (: 30 i32)))))
              (== ss_store_sk s_store_sk))
          )
          (group-by
            s_store_sk
          )
        )
      )
    )
    (cte sr
      (query
        (select
          (select-list
            (item
              s_store_sk
            )
            (item as returns
              (call sum sr_return_amt)
            )
            (item as profit_loss
              (call sum sr_net_loss)
            )
          )
          (from
            (table store_returns)
            (table date_dim)
            (table store)
          )
          (where
            (&& (&& (== sr_returned_date_sk d_date_sk)
                (&& (<= (cast (cast "1998-08-04" <named StringView>) <named DATE>) d_date)
                  (<= d_date (+ (cast (cast "1998-08-04" <named StringView>) <named DATE>) (: 30 i32)))))
              (== sr_store_sk s_store_sk))
          )
          (group-by
            s_store_sk
          )
        )
      )
    )
    (cte cs
      (query
        (select
          (select-list
            (item
              cs_call_center_sk
            )
            (item as sales
              (call sum cs_ext_sales_price)
            )
            (item as profit
              (call sum cs_net_profit)
            )
          )
          (from
            (table catalog_sales)
            (table date_dim)
          )
          (where
            (&& (== cs_sold_date_sk d_date_sk)
              (&& (<= (cast (cast "1998-08-04" <named StringView>) <named DATE>) d_date)
                (<= d_date (+ (cast (cast "1998-08-04" <named StringView>) <named DATE>) (: 30 i32)))))
          )
          (group-by
            cs_call_center_sk
          )
        )
      )
    )
    (cte cr
      (query
        (select
          (select-list
            (item
              cr_call_center_sk
            )
            (item as returns
              (call sum cr_return_amount)
            )
            (item as profit_loss
              (call sum cr_net_loss)
            )
          )
          (from
            (table catalog_returns)
            (table date_dim)
          )
          (where
            (&& (== cr_returned_date_sk d_date_sk)
              (&& (<= (cast (cast "1998-08-04" <named StringView>) <named DATE>) d_date)
                (<= d_date (+ (cast (cast "1998-08-04" <named StringView>) <named DATE>) (: 30 i32)))))
          )
          (group-by
            cr_call_center_sk
          )
        )
      )
    )
    (cte ws
      (query
        (select
          (select-list
            (item
              wp_web_page_sk
            )
            (item as sales
              (call sum ws_ext_sales_price)
            )
            (item as profit
              (call sum ws_net_profit)
            )
          )
          (from
            (table web_sales)
            (table date_dim)
            (table web_page)
          )
          (where
            (&& (&& (== ws_sold_date_sk d_date_sk)
                (&& (<= (cast (cast "1998-08-04" <named StringView>) <named DATE>) d_date)
                  (<= d_date (+ (cast (cast "1998-08-04" <named StringView>) <named DATE>) (: 30 i32)))))
              (== ws_web_page_sk wp_web_page_sk))
          )
          (group-by
            wp_web_page_sk
          )
        )
      )
    )
    (cte wr
      (query
        (select
          (select-list
            (item
              wp_web_page_sk
            )
            (item as returns
              (call sum wr_return_amt)
            )
            (item as profit_loss
              (call sum wr_net_loss)
            )
          )
          (from
            (table web_returns)
            (table date_dim)
            (table web_page)
          )
          (where
            (&& (&& (== wr_returned_date_sk d_date_sk)
                (&& (<= (cast (cast "1998-08-04" <named StringView>) <named DATE>) d_date)
                  (<= d_date (+ (cast (cast "1998-08-04" <named StringView>) <named DATE>) (: 30 i32)))))
              (== wr_web_page_sk wp_web_page_sk))
          )
          (group-by
            wp_web_page_sk
          )
        )
      )
    )
  )
  (select
    (select-list
      (item
        channel
      )
      (item
        id
      )
      (item as sales
        (call sum sales)
      )
      (item as returns
        (call sum returns)
      )
      (item as profit
        (call sum profit)
      )
    )
    (from
      (subquery-table as x
        (query
          (union all
            (union all
              (select
                (select-list
                  (item as channel
                    (cast "store channel" <named StringView>)
                  )
                  (item as id
                    |ss.s_store_sk|
                  )
                  (item
                    sales
                  )
                  (item as returns
                    (call coalesce returns 0)
                  )
                  (item as profit
                    (- profit (call coalesce profit_loss 0))
                  )
                )
                (from
                  (join left
                    (table ss)
                    (table sr)
                    (on
                      (== |ss.s_store_sk| |sr.s_store_sk|)
                    )
                  )
                )
              )
              (select
                (select-list
                  (item as channel
                    (cast "catalog channel" <named StringView>)
                  )
                  (item as id
                    cs_call_center_sk
                  )
                  (item
                    sales
                  )
                  (item
                    returns
                  )
                  (item as profit
                    (- profit profit_loss)
                  )
                )
                (from
                  (table cs)
                  (table cr)
                )
              )
            )
            (select
              (select-list
                (item as channel
                  (cast "web channel" <named StringView>)
                )
                (item as id
                  |ws.wp_web_page_sk|
                )
                (item
                  sales
                )
                (item as returns
                  (call coalesce returns 0)
                )
                (item as profit
                  (- profit (call coalesce profit_loss 0))
                )
              )
              (from
                (join left
                  (table ws)
                  (table wr)
                  (on
                    (== |ws.wp_web_page_sk| |wr.wp_web_page_sk|)
                  )
                )
              )
            )
          )
        )
      )
    )
    (group-by
      (rollup
        (block
          channel
          id)
      )
    )
  )
  (order-by
    (order asc
      channel
    )
    (order asc
      id
    )
  )
  (limit
    100
  )
)
