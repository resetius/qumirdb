(rel limit
  (rel sort
    (rel project
      (rel aggregate
        (rel project
          (rel filter
            (rel join
              (rel join
                (rel join (rel source "web_sales") (rel source "item") () (inner))
                (rel source "date_dim")
                ()
                (inner))
              (rel project
                (rel aggregate
                  (rel project
                    (rel filter
                      (rel join (rel source "web_sales") (rel source "date_dim") () (inner))
                      (&& (&& (&& (== ws_item_sk i_item_sk) (<= "1998-03-18" d_date))
                          (<= d_date (+ (: (cast "1998-03-18" <named DATE>) <named DATE>) (: 90 i32))))
                        (== d_date_sk ws_sold_date_sk)))
                    (ws_ext_discount_amt ws_ext_discount_amt)
                    (__group__ 1))
                  (keys __group__)
                  (agg sum_0 sum ws_ext_discount_amt)
                  (agg count_1 count))
                (__scalar_0__ (* 1.3 (/ sum_0 (cast count_1 f64)))))
              ()
              (inner))
            (&& (&& (&& (&& (&& (== i_manufact_id 269) (== i_item_sk ws_item_sk)) (<= "1998-03-18" d_date))
                  (<= d_date (+ (: (cast "1998-03-18" <named DATE>) <named DATE>) (: 90 i32))))
                (== d_date_sk ws_sold_date_sk))
              (> ws_ext_discount_amt __scalar_0__)))
          (ws_ext_discount_amt ws_ext_discount_amt)
          (__group__ 1))
        (keys __group__)
        (agg sum_0 sum ws_ext_discount_amt))
      (|Excess Discount Amount| sum_0))
    (|Excess Discount Amount| asc nulls-default))
  (limit 100))
