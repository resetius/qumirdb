(rel limit
  (rel project
    (rel sort
      (rel project
        (rel window
          (rel project
            (rel aggregate
              (rel project
                (rel filter
                  (rel join
                    (rel join (rel source "web_sales") (rel source "date_dim" "d1") () (inner))
                    (rel source "item")
                    ()
                    (inner))
                  (&& (&& (&& (<= 1212 |d1.d_month_seq|) (<= |d1.d_month_seq| (+ 1212 11)))
                      (== |d1.d_date_sk| ws_sold_date_sk))
                    (== i_item_sk ws_item_sk)))
                (i_category i_category)
                (i_class i_class)
                (ws_net_paid ws_net_paid))
              (keys i_category i_class)
              (set i_category i_class)
              (set i_category)
              (set)
              (agg sum_0 sum ws_net_paid)
              (agg sum_1 sum ws_net_paid))
            (i_category i_category)
            (i_class i_class)
            (sum_0 sum_0)
            (sum_1 sum_1)
            (wk_0 (+ (if (== __grouping_id__ (: 2 i32)) 1 0)
                (if (== __grouping_id__ (: 1 i32)) 1 (if (== __grouping_id__ (: 2 i32)) 1 0))))
            (wk_1 (if
                (call qdb_is_true (== (if (== __grouping_id__ (: 1 i32)) 1 (if (== __grouping_id__ (: 2 i32)) 1 0)) 0))
                i_category)))
          (partition wk_0 wk_1)
          (order (sum_1 desc nulls-default))
          (frame range (start unbounded-preceding) (end current-row))
          (fn w_0 rank))
        (total_sum sum_0)
        (i_category i_category)
        (i_class i_class)
        (lochierarchy (+ (if (== __grouping_id__ (: 2 i32)) 1 0)
            (if (== __grouping_id__ (: 1 i32)) 1 (if (== __grouping_id__ (: 2 i32)) 1 0))))
        (rank_within_parent w_0)
        (__sort_0 (if (call qdb_is_true (== lochierarchy 0)) i_category)))
      (lochierarchy desc nulls-default)
      (__sort_0 asc nulls-default)
      (rank_within_parent asc nulls-default))
    (total_sum total_sum)
    (i_category i_category)
    (i_class i_class)
    (lochierarchy lochierarchy)
    (rank_within_parent rank_within_parent))
  (limit 100))
