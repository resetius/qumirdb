(query
  (select
    (select-list
      (star *)
    )
    (from
      (subquery-table as tmp1
        (query
          (select
            (select-list
              (item
                i_manufact_id
              )
              (item as sum_sales
                (call sum ss_sales_price)
              )
              (item as avg_quarterly_sales
                (window
                  (call avg (call sum ss_sales_price))
                  (over
                    (partition-by
                      (block
                        i_manufact_id))
                    (range
                      (between
                        (unbounded-preceding)
                        (unbounded-following)))))
              )
            )
            (from
              (table item)
              (table store_sales)
              (table date_dim)
              (table store)
            )
            (where
              (&& (&& (&& (&& (== ss_item_sk i_item_sk) (== ss_sold_date_sk d_date_sk)) (== ss_store_sk s_store_sk))
                  (|| (|| (|| (|| (|| (|| (|| (|| (|| (|| (|| (== d_month_seq 1212) (== d_month_seq (+ 1212 1))) (== d_month_seq (+ 1212 2)))
                                    (== d_month_seq (+ 1212 3)))
                                  (== d_month_seq (+ 1212 4)))
                                (== d_month_seq (+ 1212 5)))
                              (== d_month_seq (+ 1212 6)))
                            (== d_month_seq (+ 1212 7)))
                          (== d_month_seq (+ 1212 8)))
                        (== d_month_seq (+ 1212 9)))
                      (== d_month_seq (+ 1212 10)))
                    (== d_month_seq (+ 1212 11))))
                (|| (&& (&& (|| (|| (== i_category (: (cast "Books" <named StringView>) <named StringView>))
                          (== i_category (: (cast "Children" <named StringView>) <named StringView>)))
                        (== i_category (: (cast "Electronics" <named StringView>) <named StringView>)))
                      (|| (|| (|| (== i_class (: (cast "personal" <named StringView>) <named StringView>))
                            (== i_class (: (cast "portable" <named StringView>) <named StringView>)))
                          (== i_class (: (cast "reference" <named StringView>) <named StringView>)))
                        (== i_class (: (cast "self-help" <named StringView>) <named StringView>))))
                    (|| (|| (|| (== i_brand (: (cast "scholaramalgamalg #14" <named StringView>) <named StringView>))
                          (== i_brand (: (cast "scholaramalgamalg #7" <named StringView>) <named StringView>)))
                        (== i_brand (: (cast "exportiunivamalg #9" <named StringView>) <named StringView>)))
                      (== i_brand (: (cast "scholaramalgamalg #9" <named StringView>) <named StringView>))))
                  (&& (&& (|| (|| (== i_category (: (cast "Women" <named StringView>) <named StringView>))
                          (== i_category (: (cast "Music" <named StringView>) <named StringView>)))
                        (== i_category (: (cast "Men" <named StringView>) <named StringView>)))
                      (|| (|| (|| (== i_class (: (cast "accessories" <named StringView>) <named StringView>))
                            (== i_class (: (cast "classical" <named StringView>) <named StringView>)))
                          (== i_class (: (cast "fragrances" <named StringView>) <named StringView>)))
                        (== i_class (: (cast "pants" <named StringView>) <named StringView>))))
                    (|| (|| (|| (== i_brand (: (cast "amalgimporto #1" <named StringView>) <named StringView>))
                          (== i_brand (: (cast "edu packscholar #1" <named StringView>) <named StringView>)))
                        (== i_brand (: (cast "exportiimporto #1" <named StringView>) <named StringView>)))
                      (== i_brand (: (cast "importoamalg #1" <named StringView>) <named StringView>))))))
            )
            (group-by
              i_manufact_id
              d_qoy
            )
          )
        )
      )
    )
    (where
      (> (if
          (call qdb_is_true (> avg_quarterly_sales 0))
          (/ (call abs (- sum_sales avg_quarterly_sales)) avg_quarterly_sales)
          (call qdb_sql_null))
        0.10000000000000001)
    )
  )
  (order-by
    (order asc
      avg_quarterly_sales
    )
    (order asc
      sum_sales
    )
    (order asc
      i_manufact_id
    )
  )
  (limit
    100
  )
)
