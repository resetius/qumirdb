(query
  (select
    (select-list
      (star *)
    )
    (from
      (subquery-table as tmp1
        (query
          (select
            (select-list
              (item
                i_manufact_id
              )
              (item as sum_sales
                (call sum ss_sales_price)
              )
              (item as avg_quarterly_sales
                (window
                  (call avg (call sum ss_sales_price))
                  (over
                    (partition-by
                      (block
                        i_manufact_id))
                    (range
                      (between
                        (unbounded-preceding)
                        (unbounded-following)))))
              )
            )
            (from
              (table item)
              (table store_sales)
              (table date_dim)
              (table store)
            )
            (where
              (&& (&& (&& (&& (== ss_item_sk i_item_sk) (== ss_sold_date_sk d_date_sk)) (== ss_store_sk s_store_sk))
                  (call
                    qdb_in_list
                    d_month_seq
                    1212
                    (+ 1212 1)
                    (+ 1212 2)
                    (+ 1212 3)
                    (+ 1212 4)
                    (+ 1212 5)
                    (+ 1212 6)
                    (+ 1212 7)
                    (+ 1212 8)
                    (+ 1212 9)
                    (+ 1212 10)
                    (+ 1212 11)))
                (|| (&& (&& (call
                        qdb_in_list
                        i_category
                        (cast "Books" <named StringView>)
                        (cast "Children" <named StringView>)
                        (cast "Electronics" <named StringView>))
                      (call
                        qdb_in_list
                        i_class
                        (cast "personal" <named StringView>)
                        (cast "portable" <named StringView>)
                        (cast "reference" <named StringView>)
                        (cast "self-help" <named StringView>)))
                    (call
                      qdb_in_list
                      i_brand
                      (cast "scholaramalgamalg #14" <named StringView>)
                      (cast "scholaramalgamalg #7" <named StringView>)
                      (cast "exportiunivamalg #9" <named StringView>)
                      (cast "scholaramalgamalg #9" <named StringView>)))
                  (&& (&& (call
                        qdb_in_list
                        i_category
                        (cast "Women" <named StringView>)
                        (cast "Music" <named StringView>)
                        (cast "Men" <named StringView>))
                      (call
                        qdb_in_list
                        i_class
                        (cast "accessories" <named StringView>)
                        (cast "classical" <named StringView>)
                        (cast "fragrances" <named StringView>)
                        (cast "pants" <named StringView>)))
                    (call
                      qdb_in_list
                      i_brand
                      (cast "amalgimporto #1" <named StringView>)
                      (cast "edu packscholar #1" <named StringView>)
                      (cast "exportiimporto #1" <named StringView>)
                      (cast "importoamalg #1" <named StringView>)))))
            )
            (group-by
              i_manufact_id
              d_qoy
            )
          )
        )
      )
    )
    (where
      (> (if
          (call qdb_is_true (> avg_quarterly_sales 0))
          (/ (call abs (- sum_sales avg_quarterly_sales)) avg_quarterly_sales)
          (call qdb_sql_null))
        0.10000000000000001)
    )
  )
  (order-by
    (order asc
      avg_quarterly_sales
    )
    (order asc
      sum_sales
    )
    (order asc
      i_manufact_id
    )
  )
  (limit
    100
  )
)
