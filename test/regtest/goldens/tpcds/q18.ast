(query
  (select
    (select-list
      (item
        i_item_id
      )
      (item
        ca_country
      )
      (item
        ca_state
      )
      (item
        ca_county
      )
      (item as agg1
        (call avg (: (cast cs_quantity <named DECIMAL>) <named DECIMAL>))
      )
      (item as agg2
        (call avg (: (cast cs_list_price <named DECIMAL>) <named DECIMAL>))
      )
      (item as agg3
        (call avg (: (cast cs_coupon_amt <named DECIMAL>) <named DECIMAL>))
      )
      (item as agg4
        (call avg (: (cast cs_sales_price <named DECIMAL>) <named DECIMAL>))
      )
      (item as agg5
        (call avg (: (cast cs_net_profit <named DECIMAL>) <named DECIMAL>))
      )
      (item as agg6
        (call avg (: (cast c_birth_year <named DECIMAL>) <named DECIMAL>))
      )
      (item as agg7
        (call avg (: (cast |cd1.cd_dep_count| <named DECIMAL>) <named DECIMAL>))
      )
    )
    (from
      (table catalog_sales)
      (table customer_demographics as cd1)
      (table customer_demographics as cd2)
      (table customer)
      (table customer_address)
      (table date_dim)
      (table item)
    )
    (where
      (&& (&& (&& (&& (&& (&& (&& (&& (&& (&& (== cs_sold_date_sk d_date_sk) (== cs_item_sk i_item_sk))
                        (== cs_bill_cdemo_sk |cd1.cd_demo_sk|))
                      (== cs_bill_customer_sk c_customer_sk))
                    (== |cd1.cd_gender| "M"))
                  (== |cd1.cd_education_status| "College"))
                (== c_current_cdemo_sk |cd2.cd_demo_sk|))
              (== c_current_addr_sk ca_address_sk))
            (|| (|| (|| (|| (|| (== c_birth_month 9) (== c_birth_month 5)) (== c_birth_month 12)) (== c_birth_month 4))
                (== c_birth_month 1))
              (== c_birth_month 10)))
          (== d_year 2001))
        (|| (|| (|| (|| (|| (|| (== ca_state "ND") (== ca_state "WI")) (== ca_state "AL")) (== ca_state "NC")) (== ca_state "OK"))
            (== ca_state "MS"))
          (== ca_state "TN")))
    )
    (group-by
      (rollup
        (block
          i_item_id
          ca_country
          ca_state
          ca_county)
      )
    )
  )
  (order-by
    (order asc
      ca_country
    )
    (order asc
      ca_state
    )
    (order asc
      ca_county
    )
    (order asc
      i_item_id
    )
  )
  (limit
    100
  )
)
