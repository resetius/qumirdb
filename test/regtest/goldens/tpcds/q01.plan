(rel limit
  (rel sort
    (rel project
      (rel filter
        (rel join
          (rel join
            (rel join
              (rel project
                (rel project
                  (rel aggregate
                    (rel filter
                      (rel join (rel source "store_returns") (rel source "date_dim") () (inner))
                      (&& (== sr_returned_date_sk d_date_sk) (== d_year 2000)))
                    (keys sr_customer_sk sr_store_sk)
                    (agg sum_0 sum SR_FEE))
                  (ctr_customer_sk sr_customer_sk)
                  (ctr_store_sk sr_store_sk)
                  (ctr_total_return sum_0))
                (|ctr1.ctr_customer_sk| ctr_customer_sk)
                (|ctr1.ctr_store_sk| ctr_store_sk)
                (|ctr1.ctr_total_return| ctr_total_return))
              (rel source "store")
              ()
              (inner))
            (rel source "customer")
            ()
            (inner))
          (rel project
            (rel aggregate
              (rel project
                (rel filter
                  (rel project
                    (rel project
                      (rel aggregate
                        (rel filter
                          (rel join (rel source "store_returns") (rel source "date_dim") () (inner))
                          (&& (== sr_returned_date_sk d_date_sk) (== d_year 2000)))
                        (keys sr_customer_sk sr_store_sk)
                        (agg sum_0 sum SR_FEE))
                      (ctr_customer_sk sr_customer_sk)
                      (ctr_store_sk sr_store_sk)
                      (ctr_total_return sum_0))
                    (|ctr2.ctr_customer_sk| ctr_customer_sk)
                    (|ctr2.ctr_store_sk| ctr_store_sk)
                    (|ctr2.ctr_total_return| ctr_total_return))
                  (== |ctr1.ctr_store_sk| |ctr2.ctr_store_sk|))
                (ctr_total_return ctr_total_return)
                (__group__ 1))
              (keys __group__)
              (agg sum_0 sum ctr_total_return)
              (agg count_1 count))
            (__scalar_0__ (* (/ sum_0 (cast count_1 f64)) 1.2)))
          ()
          (inner))
        (&& (&& (&& (> |ctr1.ctr_total_return| __scalar_0__) (== s_store_sk |ctr1.ctr_store_sk|)) (== s_state "TN"))
          (== |ctr1.ctr_customer_sk| c_customer_sk)))
      (c_customer_id c_customer_id))
    (c_customer_id asc nulls-default))
  (limit 100))
