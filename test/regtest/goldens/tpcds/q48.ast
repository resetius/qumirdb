(query
  (select
    (select-list
      (item
        (call sum ss_quantity)
      )
    )
    (from
      (table store_sales)
      (table store)
      (table customer_demographics)
      (table customer_address)
      (table date_dim)
    )
    (where
      (&& (&& (&& (&& (== s_store_sk ss_store_sk) (== ss_sold_date_sk d_date_sk)) (== d_year 1998))
          (|| (|| (&& (&& (&& (== cd_demo_sk ss_cdemo_sk) (== cd_marital_status (: (cast "M" <named StringView>) <named StringView>)))
                  (== cd_education_status (: (cast "4 yr Degree" <named StringView>) <named StringView>)))
                (&& (<= 100 ss_sales_price) (<= ss_sales_price 150)))
              (&& (&& (&& (== cd_demo_sk ss_cdemo_sk) (== cd_marital_status (: (cast "D" <named StringView>) <named StringView>)))
                  (== cd_education_status (: (cast "Primary" <named StringView>) <named StringView>)))
                (&& (<= 50 ss_sales_price) (<= ss_sales_price 100))))
            (&& (&& (&& (== cd_demo_sk ss_cdemo_sk) (== cd_marital_status (: (cast "U" <named StringView>) <named StringView>)))
                (== cd_education_status (: (cast "Advanced Degree" <named StringView>) <named StringView>)))
              (&& (<= 150 ss_sales_price) (<= ss_sales_price 200)))))
        (|| (|| (&& (&& (&& (== ss_addr_sk ca_address_sk)
                  (== ca_country (: (cast "United States" <named StringView>) <named StringView>)))
                (|| (|| (== ca_state (: (cast "KY" <named StringView>) <named StringView>))
                    (== ca_state (: (cast "GA" <named StringView>) <named StringView>)))
                  (== ca_state (: (cast "NM" <named StringView>) <named StringView>))))
              (&& (<= 0 ss_net_profit) (<= ss_net_profit 2000)))
            (&& (&& (&& (== ss_addr_sk ca_address_sk)
                  (== ca_country (: (cast "United States" <named StringView>) <named StringView>)))
                (|| (|| (== ca_state (: (cast "MT" <named StringView>) <named StringView>))
                    (== ca_state (: (cast "OR" <named StringView>) <named StringView>)))
                  (== ca_state (: (cast "IN" <named StringView>) <named StringView>))))
              (&& (<= 150 ss_net_profit) (<= ss_net_profit 3000))))
          (&& (&& (&& (== ss_addr_sk ca_address_sk)
                (== ca_country (: (cast "United States" <named StringView>) <named StringView>)))
              (|| (|| (== ca_state (: (cast "WI" <named StringView>) <named StringView>))
                  (== ca_state (: (cast "MO" <named StringView>) <named StringView>)))
                (== ca_state (: (cast "WV" <named StringView>) <named StringView>))))
            (&& (<= 50 ss_net_profit) (<= ss_net_profit 25000)))))
    )
  )
)
