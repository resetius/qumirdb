(rel limit
  (rel sort
    (rel project
      (rel aggregate
        (rel filter
          (rel join
            (rel join
              (rel join
                (rel join (rel source "store_sales") (rel source "customer_demographics") () (inner))
                (rel source "date_dim")
                ()
                (inner))
              (rel source "item")
              ()
              (inner))
            (rel source "promotion")
            ()
            (inner))
          (&& (&& (&& (&& (&& (&& (&& (&& (== ss_sold_date_sk d_date_sk) (== ss_item_sk i_item_sk)) (== ss_cdemo_sk cd_demo_sk))
                      (== ss_promo_sk p_promo_sk))
                    (== cd_gender "F"))
                  (== cd_marital_status "W"))
                (== cd_education_status "Primary"))
              (|| (== p_channel_email "N") (== p_channel_event "N")))
            (== d_year 1998)))
        (keys i_item_id)
        (agg sum_0 sum ss_quantity)
        (agg count_1 count)
        (agg sum_2 sum ss_list_price)
        (agg count_3 count)
        (agg sum_4 sum ss_coupon_amt)
        (agg count_5 count)
        (agg sum_6 sum ss_sales_price)
        (agg count_7 count))
      (i_item_id i_item_id)
      (agg1 (/ sum_0 (cast count_1 f64)))
      (agg2 (/ sum_2 (cast count_3 f64)))
      (agg3 (/ sum_4 (cast count_5 f64)))
      (agg4 (/ sum_6 (cast count_7 f64))))
    (i_item_id asc nulls-default))
  (limit 100))
