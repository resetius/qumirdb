(query
  (select
    (select-list
      (item
        (call substr w_warehouse_name 1 20)
      )
      (item
        sm_type
      )
      (item
        web_name
      )
      (item as 30 days
        (call sum (if (call qdb_is_true (<= (- ws_ship_date_sk ws_sold_date_sk) 30)) 1 0))
      )
      (item as 31-60 days
        (call
          sum
          (if
            (call qdb_is_true (&& (> (- ws_ship_date_sk ws_sold_date_sk) 30) (<= (- ws_ship_date_sk ws_sold_date_sk) 60)))
            1
            0))
      )
      (item as 61-90 days
        (call
          sum
          (if
            (call qdb_is_true (&& (> (- ws_ship_date_sk ws_sold_date_sk) 60) (<= (- ws_ship_date_sk ws_sold_date_sk) 90)))
            1
            0))
      )
      (item as 91-120 days
        (call
          sum
          (if
            (call qdb_is_true (&& (> (- ws_ship_date_sk ws_sold_date_sk) 90) (<= (- ws_ship_date_sk ws_sold_date_sk) 120)))
            1
            0))
      )
      (item as >120 days
        (call sum (if (call qdb_is_true (> (- ws_ship_date_sk ws_sold_date_sk) 120)) 1 0))
      )
    )
    (from
      (table web_sales)
      (table warehouse)
      (table ship_mode)
      (table web_site)
      (table date_dim)
    )
    (where
      (&& (&& (&& (&& (&& (<= 1212 d_month_seq) (<= d_month_seq (+ 1212 11))) (== ws_ship_date_sk d_date_sk))
            (== ws_warehouse_sk w_warehouse_sk))
          (== ws_ship_mode_sk sm_ship_mode_sk))
        (== ws_web_site_sk web_site_sk))
    )
    (group-by
      (call substr w_warehouse_name 1 20)
      sm_type
      web_name
    )
  )
  (order-by
    (order asc
      (call substr w_warehouse_name 1 20)
    )
    (order asc
      sm_type
    )
    (order asc
      web_name
    )
  )
  (limit
    100
  )
)
