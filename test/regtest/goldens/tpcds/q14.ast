(query
  (with
    (cte cross_items
      (query
        (select
          (select-list
            (item as ss_item_sk
              i_item_sk
            )
          )
          (from
            (table item)
            (subquery-table
              (query
                (intersect distinct
                  (intersect distinct
                    (select
                      (select-list
                        (item as brand_id
                          |iss.i_brand_id|
                        )
                        (item as class_id
                          |iss.i_class_id|
                        )
                        (item as category_id
                          |iss.i_category_id|
                        )
                      )
                      (from
                        (table store_sales)
                        (table item as iss)
                        (table date_dim as d1)
                      )
                      (where
                        (&& (&& (== ss_item_sk |iss.i_item_sk|) (== ss_sold_date_sk |d1.d_date_sk|))
                          (&& (<= 1998 |d1.d_year|) (<= |d1.d_year| (+ 1998 2))))
                      )
                    )
                    (select
                      (select-list
                        (item
                          |ics.i_brand_id|
                        )
                        (item
                          |ics.i_class_id|
                        )
                        (item
                          |ics.i_category_id|
                        )
                      )
                      (from
                        (table catalog_sales)
                        (table item as ics)
                        (table date_dim as d2)
                      )
                      (where
                        (&& (&& (== cs_item_sk |ics.i_item_sk|) (== cs_sold_date_sk |d2.d_date_sk|))
                          (&& (<= 1998 |d2.d_year|) (<= |d2.d_year| (+ 1998 2))))
                      )
                    )
                  )
                  (select
                    (select-list
                      (item
                        |iws.i_brand_id|
                      )
                      (item
                        |iws.i_class_id|
                      )
                      (item
                        |iws.i_category_id|
                      )
                    )
                    (from
                      (table web_sales)
                      (table item as iws)
                      (table date_dim as d3)
                    )
                    (where
                      (&& (&& (== ws_item_sk |iws.i_item_sk|) (== ws_sold_date_sk |d3.d_date_sk|))
                        (&& (<= 1998 |d3.d_year|) (<= |d3.d_year| (+ 1998 2))))
                    )
                  )
                )
              )
            )
          )
          (where
            (&& (&& (== i_brand_id brand_id) (== i_class_id class_id)) (== i_category_id category_id))
          )
        )
      )
    )
    (cte avg_sales
      (query
        (select
          (select-list
            (item as average_sales
              (call avg (* quantity list_price))
            )
          )
          (from
            (subquery-table as x
              (query
                (union all
                  (union all
                    (select
                      (select-list
                        (item as quantity
                          ss_quantity
                        )
                        (item as list_price
                          ss_list_price
                        )
                      )
                      (from
                        (table store_sales)
                        (table date_dim)
                      )
                      (where
                        (&& (== ss_sold_date_sk d_date_sk) (&& (<= 1998 d_year) (<= d_year (+ 1998 2))))
                      )
                    )
                    (select
                      (select-list
                        (item as quantity
                          cs_quantity
                        )
                        (item as list_price
                          cs_list_price
                        )
                      )
                      (from
                        (table catalog_sales)
                        (table date_dim)
                      )
                      (where
                        (&& (== cs_sold_date_sk d_date_sk) (&& (<= 1998 d_year) (<= d_year (+ 1998 2))))
                      )
                    )
                  )
                  (select
                    (select-list
                      (item as quantity
                        ws_quantity
                      )
                      (item as list_price
                        ws_list_price
                      )
                    )
                    (from
                      (table web_sales)
                      (table date_dim)
                    )
                    (where
                      (&& (== ws_sold_date_sk d_date_sk) (&& (<= 1998 d_year) (<= d_year (+ 1998 2))))
                    )
                  )
                )
              )
            )
          )
        )
      )
    )
  )
  (select
    (select-list
      (item
        channel
      )
      (item
        i_brand_id
      )
      (item
        i_class_id
      )
      (item
        i_category_id
      )
      (item
        (call sum sales)
      )
      (item
        (call sum number_sales)
      )
    )
    (from
      (subquery-table as y
        (query
          (union all
            (union all
              (select
                (select-list
                  (item as channel
                    (: (cast "store" <named StringView>) <named StringView>)
                  )
                  (item
                    i_brand_id
                  )
                  (item
                    i_class_id
                  )
                  (item
                    i_category_id
                  )
                  (item as sales
                    (call sum (* ss_quantity ss_list_price))
                  )
                  (item as number_sales
                    (call count *)
                  )
                )
                (from
                  (table store_sales)
                  (table item)
                  (table date_dim)
                )
                (where
                  (&& (&& (&& (&& (subquery in ss_item_sk (query
                    (select
                      (select-list
                        (item
                          ss_item_sk
                        )
                      )
                      (from
                        (table cross_items)
                      )
                    )
                  )
                  )
                          (== ss_item_sk i_item_sk))
                        (== ss_sold_date_sk d_date_sk))
                      (== d_year (+ 1998 2)))
                    (== d_moy 11))
                )
                (group-by
                  i_brand_id
                  i_class_id
                  i_category_id
                )
                (having
                  (> (call sum (* ss_quantity ss_list_price))
                    (subquery scalar (query
                    (select
                      (select-list
                        (item
                          average_sales
                        )
                      )
                      (from
                        (table avg_sales)
                      )
                    )
                  )
                  ))
                )
              )
              (select
                (select-list
                  (item as channel
                    (: (cast "catalog" <named StringView>) <named StringView>)
                  )
                  (item
                    i_brand_id
                  )
                  (item
                    i_class_id
                  )
                  (item
                    i_category_id
                  )
                  (item as sales
                    (call sum (* cs_quantity cs_list_price))
                  )
                  (item as number_sales
                    (call count *)
                  )
                )
                (from
                  (table catalog_sales)
                  (table item)
                  (table date_dim)
                )
                (where
                  (&& (&& (&& (&& (subquery in cs_item_sk (query
                    (select
                      (select-list
                        (item
                          ss_item_sk
                        )
                      )
                      (from
                        (table cross_items)
                      )
                    )
                  )
                  )
                          (== cs_item_sk i_item_sk))
                        (== cs_sold_date_sk d_date_sk))
                      (== d_year (+ 1998 2)))
                    (== d_moy 11))
                )
                (group-by
                  i_brand_id
                  i_class_id
                  i_category_id
                )
                (having
                  (> (call sum (* cs_quantity cs_list_price))
                    (subquery scalar (query
                    (select
                      (select-list
                        (item
                          average_sales
                        )
                      )
                      (from
                        (table avg_sales)
                      )
                    )
                  )
                  ))
                )
              )
            )
            (select
              (select-list
                (item as channel
                  (: (cast "web" <named StringView>) <named StringView>)
                )
                (item
                  i_brand_id
                )
                (item
                  i_class_id
                )
                (item
                  i_category_id
                )
                (item as sales
                  (call sum (* ws_quantity ws_list_price))
                )
                (item as number_sales
                  (call count *)
                )
              )
              (from
                (table web_sales)
                (table item)
                (table date_dim)
              )
              (where
                (&& (&& (&& (&& (subquery in ws_item_sk (query
                  (select
                    (select-list
                      (item
                        ss_item_sk
                      )
                    )
                    (from
                      (table cross_items)
                    )
                  )
                )
                )
                        (== ws_item_sk i_item_sk))
                      (== ws_sold_date_sk d_date_sk))
                    (== d_year (+ 1998 2)))
                  (== d_moy 11))
              )
              (group-by
                i_brand_id
                i_class_id
                i_category_id
              )
              (having
                (> (call sum (* ws_quantity ws_list_price))
                  (subquery scalar (query
                  (select
                    (select-list
                      (item
                        average_sales
                      )
                    )
                    (from
                      (table avg_sales)
                    )
                  )
                )
                ))
              )
            )
          )
        )
      )
    )
    (group-by
      (rollup
        (block
          channel
          i_brand_id
          i_class_id
          i_category_id)
      )
    )
  )
  (order-by
    (order asc
      channel
    )
    (order asc
      i_brand_id
    )
    (order asc
      i_class_id
    )
    (order asc
      i_category_id
    )
  )
  (limit
    100
  )
)
