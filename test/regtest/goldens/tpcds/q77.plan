(rel limit
  (rel sort
    (rel project
      (rel aggregate
        (rel project
          (rel project
            (rel union-all
              (rel project
                (rel join
                  (rel project (rel cte-ref 0) (|ss.s_store_sk| s_store_sk) (|ss.sales| sales) (|ss.profit| profit))
                  (rel project
                    (rel cte-ref 1)
                    (|sr.s_store_sk| s_store_sk)
                    (|sr.returns| returns)
                    (|sr.profit_loss| profit_loss))
                  ()
                  (left)
                  (== |ss.s_store_sk| |sr.s_store_sk|))
                (channel (: (cast "store channel" <named StringView>) <named StringView>))
                (id |ss.s_store_sk|)
                (sales sales)
                (returns (call coalesce returns 0))
                (profit (- profit (call coalesce profit_loss 0))))
              (rel project
                (rel join
                  (rel project
                    (rel cte-ref 2)
                    (|cs.cs_call_center_sk| cs_call_center_sk)
                    (|cs.sales| sales)
                    (|cs.profit| profit))
                  (rel project
                    (rel cte-ref 3)
                    (|cr.cr_call_center_sk| cr_call_center_sk)
                    (|cr.returns| returns)
                    (|cr.profit_loss| profit_loss))
                  ()
                  (inner))
                (channel (: (cast "catalog channel" <named StringView>) <named StringView>))
                (id cs_call_center_sk)
                (sales sales)
                (returns returns)
                (profit (- profit profit_loss)))
              (rel project
                (rel join
                  (rel project
                    (rel cte-ref 4)
                    (|ws.wp_web_page_sk| wp_web_page_sk)
                    (|ws.sales| sales)
                    (|ws.profit| profit))
                  (rel project
                    (rel cte-ref 5)
                    (|wr.wp_web_page_sk| wp_web_page_sk)
                    (|wr.returns| returns)
                    (|wr.profit_loss| profit_loss))
                  ()
                  (left)
                  (== |ws.wp_web_page_sk| |wr.wp_web_page_sk|))
                (channel (: (cast "web channel" <named StringView>) <named StringView>))
                (id |ws.wp_web_page_sk|)
                (sales sales)
                (returns (call coalesce returns 0))
                (profit (- profit (call coalesce profit_loss 0)))))
            (|x.channel| channel)
            (|x.id| id)
            (|x.sales| sales)
            (|x.returns| returns)
            (|x.profit| profit))
          (channel channel)
          (id id)
          (sales sales)
          (returns returns)
          (profit profit))
        (keys channel id)
        (set channel id)
        (set channel)
        (set)
        (agg sum_0 sum sales)
        (agg sum_1 sum returns)
        (agg sum_2 sum profit))
      (channel channel)
      (id id)
      (sales sum_0)
      (returns sum_1)
      (profit sum_2))
    (channel asc nulls-default)
    (id asc nulls-default))
  (limit 100))
