(query
  (select
    (select-list
      (item
        i_item_id
      )
      (item
        i_item_desc
      )
      (item
        i_current_price
      )
    )
    (from
      (table item)
      (table inventory)
      (table date_dim)
      (table store_sales)
    )
    (where
      (&& (&& (&& (&& (&& (&& (&& (<= 30 i_current_price) (<= i_current_price (+ 30 30))) (== inv_item_sk i_item_sk))
                (== d_date_sk inv_date_sk))
              (&& (<= (: (cast (: (cast "2002-05-30" <named StringView>) <named StringView>) <named DATE>) <named DATE>) d_date)
                (<= d_date
                  (+ (: (cast (: (cast "2002-05-30" <named StringView>) <named StringView>) <named DATE>) <named DATE>)
                    (: 60 i32)))))
            (|| (|| (|| (== i_manufact_id 437) (== i_manufact_id 129)) (== i_manufact_id 727)) (== i_manufact_id 663)))
          (&& (<= 100 inv_quantity_on_hand) (<= inv_quantity_on_hand 500)))
        (== ss_item_sk i_item_sk))
    )
    (group-by
      i_item_id
      i_item_desc
      i_current_price
    )
  )
  (order-by
    (order asc
      i_item_id
    )
  )
  (limit
    100
  )
)
