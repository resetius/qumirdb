(query
  (select
    (select-list
      (item
        i_item_id
      )
      (item
        i_item_desc
      )
      (item
        s_state
      )
      (item as store_sales_quantitycount
        (call count ss_quantity)
      )
      (item as store_sales_quantityave
        (call avg ss_quantity)
      )
      (item as store_sales_quantitystdev
        (call stddev_samp ss_quantity)
      )
      (item as store_sales_quantitycov
        (/ (call stddev_samp ss_quantity) (call avg ss_quantity))
      )
      (item as store_returns_quantitycount
        (call count sr_return_quantity)
      )
      (item as store_returns_quantityave
        (call avg sr_return_quantity)
      )
      (item as store_returns_quantitystdev
        (call stddev_samp sr_return_quantity)
      )
      (item as store_returns_quantitycov
        (/ (call stddev_samp sr_return_quantity) (call avg sr_return_quantity))
      )
      (item as catalog_sales_quantitycount
        (call count cs_quantity)
      )
      (item as catalog_sales_quantityave
        (call avg cs_quantity)
      )
      (item as catalog_sales_quantitystdev
        (call stddev_samp cs_quantity)
      )
      (item as catalog_sales_quantitycov
        (/ (call stddev_samp cs_quantity) (call avg cs_quantity))
      )
    )
    (from
      (table store_sales)
      (table store_returns)
      (table catalog_sales)
      (table date_dim as d1)
      (table date_dim as d2)
      (table date_dim as d3)
      (table store)
      (table item)
    )
    (where
      (&& (&& (&& (&& (&& (&& (&& (&& (&& (&& (&& (&& (== |d1.d_quarter_name| (cast "1998Q1" <named StringView>))
                              (== |d1.d_date_sk| ss_sold_date_sk))
                            (== i_item_sk ss_item_sk))
                          (== s_store_sk ss_store_sk))
                        (== ss_customer_sk sr_customer_sk))
                      (== ss_item_sk sr_item_sk))
                    (== ss_ticket_number sr_ticket_number))
                  (== sr_returned_date_sk |d2.d_date_sk|))
                (call
                  qdb_in_list
                  |d2.d_quarter_name|
                  (cast "1998Q1" <named StringView>)
                  (cast "1998Q2" <named StringView>)
                  (cast "1998Q3" <named StringView>)))
              (== sr_customer_sk cs_bill_customer_sk))
            (== sr_item_sk cs_item_sk))
          (== cs_sold_date_sk |d3.d_date_sk|))
        (call
          qdb_in_list
          |d3.d_quarter_name|
          (cast "1998Q1" <named StringView>)
          (cast "1998Q2" <named StringView>)
          (cast "1998Q3" <named StringView>)))
    )
    (group-by
      i_item_id
      i_item_desc
      s_state
    )
  )
  (order-by
    (order asc
      i_item_id
    )
    (order asc
      i_item_desc
    )
    (order asc
      s_state
    )
  )
  (limit
    100
  )
)
