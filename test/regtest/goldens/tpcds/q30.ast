(query
  (with
    (cte customer_total_return
      (query
        (select
          (select-list
            (item as ctr_customer_sk
              wr_returning_customer_sk
            )
            (item as ctr_state
              ca_state
            )
            (item as ctr_total_return
              (call sum wr_return_amt)
            )
          )
          (from
            (table web_returns)
            (table date_dim)
            (table customer_address)
          )
          (where
            (&& (&& (== wr_returned_date_sk d_date_sk) (== d_year 2002)) (== wr_returning_addr_sk ca_address_sk))
          )
          (group-by
            wr_returning_customer_sk
            ca_state
          )
        )
      )
    )
  )
  (select
    (select-list
      (item
        c_customer_id
      )
      (item
        c_salutation
      )
      (item
        c_first_name
      )
      (item
        c_last_name
      )
      (item
        c_preferred_cust_flag
      )
      (item
        c_birth_day
      )
      (item
        c_birth_month
      )
      (item
        c_birth_year
      )
      (item
        c_birth_country
      )
      (item
        c_login
      )
      (item
        c_email_address
      )
      (item
        c_last_review_date_sk
      )
      (item
        ctr_total_return
      )
    )
    (from
      (table customer_total_return as ctr1)
      (table customer_address)
      (table customer)
    )
    (where
      (&& (&& (&& (> |ctr1.ctr_total_return|
              (subquery scalar (query
        (select
          (select-list
            (item
              (* (call avg ctr_total_return) 1.2)
            )
          )
          (from
            (table customer_total_return as ctr2)
          )
          (where
            (== |ctr1.ctr_state| |ctr2.ctr_state|)
          )
        )
      )
      ))
            (== ca_address_sk c_current_addr_sk))
          (== ca_state (: (cast "IL" <named StringView>) <named StringView>)))
        (== |ctr1.ctr_customer_sk| c_customer_sk))
    )
  )
  (order-by
    (order asc
      c_customer_id
    )
    (order asc
      c_salutation
    )
    (order asc
      c_first_name
    )
    (order asc
      c_last_name
    )
    (order asc
      c_preferred_cust_flag
    )
    (order asc
      c_birth_day
    )
    (order asc
      c_birth_month
    )
    (order asc
      c_birth_year
    )
    (order asc
      c_birth_country
    )
    (order asc
      c_login
    )
    (order asc
      c_email_address
    )
    (order asc
      c_last_review_date_sk
    )
    (order asc
      ctr_total_return
    )
  )
  (limit
    100
  )
)
