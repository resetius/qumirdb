(query
  (select
    (select-list
      (item
        cd_gender
      )
      (item
        cd_marital_status
      )
      (item
        cd_education_status
      )
      (item as cnt1
        (call count *)
      )
      (item
        cd_purchase_estimate
      )
      (item as cnt2
        (call count *)
      )
      (item
        cd_credit_rating
      )
      (item as cnt3
        (call count *)
      )
      (item
        cd_dep_count
      )
      (item as cnt4
        (call count *)
      )
      (item
        cd_dep_employed_count
      )
      (item as cnt5
        (call count *)
      )
      (item
        cd_dep_college_count
      )
      (item as cnt6
        (call count *)
      )
    )
    (from
      (table customer as c)
      (table customer_address as ca)
      (table customer_demographics)
    )
    (where
      (&& (&& (&& (&& (== |c.c_current_addr_sk| |ca.ca_address_sk|)
              (|| (|| (|| (|| (== ca_county "Walker County") (== ca_county "Richland County")) (== ca_county "Gaines County"))
                  (== ca_county "Douglas County"))
                (== ca_county "Dona Ana County")))
            (== cd_demo_sk |c.c_current_cdemo_sk|))
          (subquery exists (query
        (select
          (select-list
            (star *)
          )
          (from
            (table store_sales)
            (table date_dim)
          )
          (where
            (&& (&& (&& (== |c.c_customer_sk| ss_customer_sk) (== ss_sold_date_sk d_date_sk)) (== d_year 2002))
              (&& (<= 4 d_moy) (<= d_moy (+ 4 3))))
          )
        )
      )
      ))
        (|| (subquery exists (query
        (select
          (select-list
            (star *)
          )
          (from
            (table web_sales)
            (table date_dim)
          )
          (where
            (&& (&& (&& (== |c.c_customer_sk| ws_bill_customer_sk) (== ws_sold_date_sk d_date_sk)) (== d_year 2002))
              (&& (<= 4 d_moy) (<= d_moy (+ 4 3))))
          )
        )
      )
      )
          (subquery exists (query
        (select
          (select-list
            (star *)
          )
          (from
            (table catalog_sales)
            (table date_dim)
          )
          (where
            (&& (&& (&& (== |c.c_customer_sk| cs_ship_customer_sk) (== cs_sold_date_sk d_date_sk)) (== d_year 2002))
              (&& (<= 4 d_moy) (<= d_moy (+ 4 3))))
          )
        )
      )
      )))
    )
    (group-by
      cd_gender
      cd_marital_status
      cd_education_status
      cd_purchase_estimate
      cd_credit_rating
      cd_dep_count
      cd_dep_employed_count
      cd_dep_college_count
    )
  )
  (order-by
    (order asc
      cd_gender
    )
    (order asc
      cd_marital_status
    )
    (order asc
      cd_education_status
    )
    (order asc
      cd_purchase_estimate
    )
    (order asc
      cd_credit_rating
    )
    (order asc
      cd_dep_count
    )
    (order asc
      cd_dep_employed_count
    )
    (order asc
      cd_dep_college_count
    )
  )
  (limit
    100
  )
)
