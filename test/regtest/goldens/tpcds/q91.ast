(query
  (select
    (select-list
      (item as Call_Center
        cc_call_center_id
      )
      (item as Call_Center_Name
        cc_name
      )
      (item as Manager
        cc_manager
      )
      (item as Returns_Loss
        (call sum cr_net_loss)
      )
    )
    (from
      (table call_center)
      (table catalog_returns)
      (table date_dim)
      (table customer)
      (table customer_address)
      (table customer_demographics)
      (table household_demographics)
    )
    (where
      (&& (&& (&& (&& (&& (&& (&& (&& (&& (&& (== cr_call_center_sk cc_call_center_sk) (== cr_returned_date_sk d_date_sk))
                        (== cr_returning_customer_sk c_customer_sk))
                      (== cd_demo_sk c_current_cdemo_sk))
                    (== hd_demo_sk c_current_hdemo_sk))
                  (== ca_address_sk c_current_addr_sk))
                (== d_year 1999))
              (== d_moy 11))
            (|| (&& (== cd_marital_status "M") (== cd_education_status "Unknown"))
              (&& (== cd_marital_status "W") (== cd_education_status "Advanced Degree"))))
          (call qdb_string_view_sql_like hd_buy_potential "0-500%"))
        (== ca_gmt_offset (- 7)))
    )
    (group-by
      cc_call_center_id
      cc_name
      cc_manager
      cd_marital_status
      cd_education_status
    )
  )
  (order-by
    (order desc
      (call sum cr_net_loss)
    )
  )
)
