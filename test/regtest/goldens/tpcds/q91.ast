(query
  (select
    (select-list
      (item as call_center
        cc_call_center_id
      )
      (item as call_center_name
        cc_name
      )
      (item as manager
        cc_manager
      )
      (item as returns_loss
        (call sum cr_net_loss)
      )
    )
    (from
      (table call_center)
      (table catalog_returns)
      (table date_dim)
      (table customer)
      (table customer_address)
      (table customer_demographics)
      (table household_demographics)
    )
    (where
      (&& (&& (&& (&& (&& (&& (&& (&& (&& (&& (== cr_call_center_sk cc_call_center_sk) (== cr_returned_date_sk d_date_sk))
                        (== cr_returning_customer_sk c_customer_sk))
                      (== cd_demo_sk c_current_cdemo_sk))
                    (== hd_demo_sk c_current_hdemo_sk))
                  (== ca_address_sk c_current_addr_sk))
                (== d_year 1999))
              (== d_moy 11))
            (|| (&& (== cd_marital_status (: (cast "M" <named StringView>) <named StringView>))
                (== cd_education_status (: (cast "Unknown" <named StringView>) <named StringView>)))
              (&& (== cd_marital_status (: (cast "W" <named StringView>) <named StringView>))
                (== cd_education_status (: (cast "Advanced Degree" <named StringView>) <named StringView>)))))
          (call qdb_string_view_sql_like hd_buy_potential (: (cast "0-500%" <named StringView>) <named StringView>)))
        (== ca_gmt_offset (- 7)))
    )
    (group-by
      cc_call_center_id
      cc_name
      cc_manager
      cd_marital_status
      cd_education_status
    )
  )
  (order-by
    (order desc
      (call sum cr_net_loss)
    )
  )
)
