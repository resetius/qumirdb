(rel limit
  (rel project
    (rel sort
      (rel project
        (rel filter
          (rel project
            (rel cte-ref 1)
            (|v2.i_category| i_category)
            (|v2.i_brand| i_brand)
            (|v2.d_year| d_year)
            (|v2.d_moy| d_moy)
            (|v2.avg_monthly_sales| avg_monthly_sales)
            (|v2.sum_sales| sum_sales)
            (|v2.psum| psum)
            (|v2.nsum| nsum))
          (&& (&& (== d_year 2000) (> avg_monthly_sales 0))
            (> (if
                (call qdb_is_true (> avg_monthly_sales 0))
                (/ (call abs (- sum_sales avg_monthly_sales)) avg_monthly_sales)
                (call qdb_sql_null))
              0.10000000000000001)))
        (i_category |v2.i_category|)
        (i_brand |v2.i_brand|)
        (d_year |v2.d_year|)
        (d_moy |v2.d_moy|)
        (avg_monthly_sales |v2.avg_monthly_sales|)
        (sum_sales |v2.sum_sales|)
        (psum |v2.psum|)
        (nsum |v2.nsum|)
        (__sort_0 (- sum_sales avg_monthly_sales)))
      (__sort_0 asc nulls-default)
      (nsum asc nulls-default))
    (i_category i_category)
    (i_brand i_brand)
    (d_year d_year)
    (d_moy d_moy)
    (avg_monthly_sales avg_monthly_sales)
    (sum_sales sum_sales)
    (psum psum)
    (nsum nsum))
  (limit 100))
