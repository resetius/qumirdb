(rel sort
  (rel project
    (rel aggregate
      (rel filter
        (rel join
          (rel join
            (rel join
              (rel join
                (rel join
                  (rel join (rel source "call_center") (rel source "catalog_returns") () (inner))
                  (rel source "date_dim")
                  ()
                  (inner))
                (rel source "customer")
                ()
                (inner))
              (rel source "customer_address")
              ()
              (inner))
            (rel source "customer_demographics")
            ()
            (inner))
          (rel source "household_demographics")
          ()
          (inner))
        (&& (&& (&& (&& (&& (&& (&& (&& (&& (&& (== cr_call_center_sk cc_call_center_sk) (== cr_returned_date_sk d_date_sk))
                          (== cr_returning_customer_sk c_customer_sk))
                        (== cd_demo_sk c_current_cdemo_sk))
                      (== hd_demo_sk c_current_hdemo_sk))
                    (== ca_address_sk c_current_addr_sk))
                  (== d_year 1999))
                (== d_moy 11))
              (|| (&& (== cd_marital_status (: (cast "M" <named StringView>) <named StringView>))
                  (== cd_education_status (: (cast "Unknown" <named StringView>) <named StringView>)))
                (&& (== cd_marital_status (: (cast "W" <named StringView>) <named StringView>))
                  (== cd_education_status (: (cast "Advanced Degree" <named StringView>) <named StringView>)))))
            (call qdb_string_view_sql_like hd_buy_potential (: (cast "0-500%" <named StringView>) <named StringView>)))
          (== ca_gmt_offset (- 7))))
      (keys cc_call_center_id cc_name cc_manager cd_marital_status cd_education_status)
      (agg sum_0 sum cr_net_loss))
    (call_center cc_call_center_id)
    (call_center_name cc_name)
    (manager cc_manager)
    (returns_loss sum_0))
  (returns_loss desc nulls-default))
