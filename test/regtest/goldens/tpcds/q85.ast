(query
  (select
    (select-list
      (item
        (call substr r_reason_desc 1 20)
      )
      (item
        (call avg ws_quantity)
      )
      (item
        (call avg wr_refunded_cash)
      )
      (item
        (call avg wr_fee)
      )
    )
    (from
      (table web_sales)
      (table web_returns)
      (table web_page)
      (table customer_demographics as cd1)
      (table customer_demographics as cd2)
      (table customer_address)
      (table date_dim)
      (table reason)
    )
    (where
      (&& (&& (&& (&& (&& (&& (&& (&& (&& (&& (== ws_web_page_sk wp_web_page_sk) (== ws_item_sk wr_item_sk))
                        (== ws_order_number wr_order_number))
                      (== ws_sold_date_sk d_date_sk))
                    (== d_year 1998))
                  (== |cd1.cd_demo_sk| wr_refunded_cdemo_sk))
                (== |cd2.cd_demo_sk| wr_returning_cdemo_sk))
              (== ca_address_sk wr_refunded_addr_sk))
            (== r_reason_sk wr_reason_sk))
          (|| (|| (&& (&& (&& (&& (== |cd1.cd_marital_status| "M") (== |cd1.cd_marital_status| |cd2.cd_marital_status|))
                    (== |cd1.cd_education_status| "4 yr Degree"))
                  (== |cd1.cd_education_status| |cd2.cd_education_status|))
                (&& (<= 100 ws_sales_price) (<= ws_sales_price 150)))
              (&& (&& (&& (&& (== |cd1.cd_marital_status| "D") (== |cd1.cd_marital_status| |cd2.cd_marital_status|))
                    (== |cd1.cd_education_status| "Primary"))
                  (== |cd1.cd_education_status| |cd2.cd_education_status|))
                (&& (<= 50 ws_sales_price) (<= ws_sales_price 100))))
            (&& (&& (&& (&& (== |cd1.cd_marital_status| "U") (== |cd1.cd_marital_status| |cd2.cd_marital_status|))
                  (== |cd1.cd_education_status| "Advanced Degree"))
                (== |cd1.cd_education_status| |cd2.cd_education_status|))
              (&& (<= 150 ws_sales_price) (<= ws_sales_price 200)))))
        (|| (|| (&& (&& (== ca_country "United States") (|| (|| (== ca_state "KY") (== ca_state "GA")) (== ca_state "NM")))
              (&& (<= 100 ws_net_profit) (<= ws_net_profit 200)))
            (&& (&& (== ca_country "United States") (|| (|| (== ca_state "MT") (== ca_state "OR")) (== ca_state "IN")))
              (&& (<= 150 ws_net_profit) (<= ws_net_profit 300))))
          (&& (&& (== ca_country "United States") (|| (|| (== ca_state "WI") (== ca_state "MO")) (== ca_state "WV")))
            (&& (<= 50 ws_net_profit) (<= ws_net_profit 250)))))
    )
    (group-by
      r_reason_desc
    )
  )
  (order-by
    (order asc
      (call substr r_reason_desc 1 20)
    )
    (order asc
      (call avg ws_quantity)
    )
    (order asc
      (call avg wr_refunded_cash)
    )
    (order asc
      (call avg wr_fee)
    )
  )
  (limit
    100
  )
)
