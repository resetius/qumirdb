(query
  (select
    (select-list
      (item
        (call substr w_warehouse_name 1 20)
      )
      (item
        sm_type
      )
      (item
        cc_name
      )
      (item as 30 days
        (call sum (if (call qdb_is_true (<= (- cs_ship_date_sk cs_sold_date_sk) 30)) 1 0))
      )
      (item as 31-60 days
        (call
          sum
          (if
            (call qdb_is_true (&& (> (- cs_ship_date_sk cs_sold_date_sk) 30) (<= (- cs_ship_date_sk cs_sold_date_sk) 60)))
            1
            0))
      )
      (item as 61-90 days
        (call
          sum
          (if
            (call qdb_is_true (&& (> (- cs_ship_date_sk cs_sold_date_sk) 60) (<= (- cs_ship_date_sk cs_sold_date_sk) 90)))
            1
            0))
      )
      (item as 91-120 days
        (call
          sum
          (if
            (call qdb_is_true (&& (> (- cs_ship_date_sk cs_sold_date_sk) 90) (<= (- cs_ship_date_sk cs_sold_date_sk) 120)))
            1
            0))
      )
      (item as >120 days
        (call sum (if (call qdb_is_true (> (- cs_ship_date_sk cs_sold_date_sk) 120)) 1 0))
      )
    )
    (from
      (table catalog_sales)
      (table warehouse)
      (table ship_mode)
      (table call_center)
      (table date_dim)
    )
    (where
      (&& (&& (&& (&& (&& (<= 1212 d_month_seq) (<= d_month_seq (+ 1212 11))) (== cs_ship_date_sk d_date_sk))
            (== cs_warehouse_sk w_warehouse_sk))
          (== cs_ship_mode_sk sm_ship_mode_sk))
        (== cs_call_center_sk cc_call_center_sk))
    )
    (group-by
      (call substr w_warehouse_name 1 20)
      sm_type
      cc_name
    )
  )
  (order-by
    (order asc
      (call substr w_warehouse_name 1 20)
    )
    (order asc
      sm_type
    )
    (order asc
      cc_name
    )
  )
  (limit
    100
  )
)
