(query
  (select
    (select-list
      (item
        |dt.d_year|
      )
      (item
        |item.i_category_id|
      )
      (item
        |item.i_category|
      )
      (item
        (call sum ss_ext_sales_price)
      )
    )
    (from
      (table date_dim as dt)
      (table store_sales)
      (table item)
    )
    (where
      (&& (&& (&& (&& (== |dt.d_date_sk| |store_sales.ss_sold_date_sk|) (== |store_sales.ss_item_sk| |item.i_item_sk|))
            (== |item.i_manager_id| 1))
          (== |dt.d_moy| 12))
        (== |dt.d_year| 1998))
    )
    (group-by
      |dt.d_year|
      |item.i_category_id|
      |item.i_category|
    )
  )
  (order-by
    (order desc
      (call sum ss_ext_sales_price)
    )
    (order asc
      |dt.d_year|
    )
    (order asc
      |item.i_category_id|
    )
    (order asc
      |item.i_category|
    )
  )
  (limit
    100
  )
)
