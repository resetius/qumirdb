(query
  (select
    (select-list
      (item
        c_last_name
      )
      (item
        c_first_name
      )
      (item
        c_salutation
      )
      (item
        c_preferred_cust_flag
      )
      (item
        ss_ticket_number
      )
      (item
        cnt
      )
    )
    (from
      (subquery-table as dj
        (query
          (select
            (select-list
              (item
                ss_ticket_number
              )
              (item
                ss_customer_sk
              )
              (item as cnt
                (call count *)
              )
            )
            (from
              (table store_sales)
              (table date_dim)
              (table store)
              (table household_demographics)
            )
            (where
              (&& (&& (&& (&& (&& (&& (&& (&& (== |store_sales.ss_sold_date_sk| |date_dim.d_date_sk|)
                              (== |store_sales.ss_store_sk| |store.s_store_sk|))
                            (== |store_sales.ss_hdemo_sk| |household_demographics.hd_demo_sk|))
                          (&& (<= 1 |date_dim.d_dom|) (<= |date_dim.d_dom| 2)))
                        (|| (== |household_demographics.hd_buy_potential| (: (cast ">10000" <named StringView>) <named StringView>))
                          (== |household_demographics.hd_buy_potential| (: (cast "Unknown" <named StringView>) <named StringView>))))
                      (> |household_demographics.hd_vehicle_count| 0))
                    (> (if
                        (call qdb_is_true (> |household_demographics.hd_vehicle_count| 0))
                        (/ |household_demographics.hd_dep_count| |household_demographics.hd_vehicle_count|)
                        (call qdb_sql_null))
                      1))
                  (call qdb_in_list |date_dim.d_year| 1998 (+ 1998 1) (+ 1998 2)))
                (call
                  qdb_in_list
                  |store.s_county|
                  (: (cast "Williamson County" <named StringView>) <named StringView>)
                  (: (cast "Williamson County" <named StringView>) <named StringView>)
                  (: (cast "Williamson County" <named StringView>) <named StringView>)
                  (: (cast "Williamson County" <named StringView>) <named StringView>)))
            )
            (group-by
              ss_ticket_number
              ss_customer_sk
            )
          )
        )
      )
      (table customer)
    )
    (where
      (&& (== ss_customer_sk c_customer_sk) (&& (<= 1 cnt) (<= cnt 5)))
    )
  )
  (order-by
    (order desc
      cnt
    )
    (order asc
      c_last_name
    )
  )
)
