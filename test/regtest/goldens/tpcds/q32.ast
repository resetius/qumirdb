(query
  (select
    (select-list
      (item as excess discount amount
        (call sum cs_ext_discount_amt)
      )
    )
    (from
      (table catalog_sales)
      (table item)
      (table date_dim)
    )
    (where
      (&& (&& (&& (&& (== i_manufact_id 269) (== i_item_sk cs_item_sk))
            (&& (<= "1998-03-18" d_date) (<= d_date (+ (: (cast "1998-03-18" <named DATE>) <named DATE>) (: 90 i32)))))
          (== d_date_sk cs_sold_date_sk))
        (> cs_ext_discount_amt
          (subquery scalar (query
        (select
          (select-list
            (item
              (* 1.3 (call avg cs_ext_discount_amt))
            )
          )
          (from
            (table catalog_sales)
            (table date_dim)
          )
          (where
            (&& (&& (== cs_item_sk i_item_sk)
                (&& (<= "1998-03-18" d_date) (<= d_date (+ (: (cast "1998-03-18" <named DATE>) <named DATE>) (: 90 i32)))))
              (== d_date_sk cs_sold_date_sk))
          )
        )
      )
      )))
    )
  )
  (limit
    100
  )
)
