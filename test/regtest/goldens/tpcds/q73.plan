(rel sort
  (rel project
    (rel filter
      (rel join
        (rel project
          (rel project
            (rel aggregate
              (rel filter
                (rel join
                  (rel join
                    (rel join (rel source "store_sales") (rel source "date_dim") () (inner))
                    (rel source "store")
                    ()
                    (inner))
                  (rel source "household_demographics")
                  ()
                  (inner))
                (&& (&& (&& (&& (&& (&& (&& (&& (&& (== |store_sales.ss_sold_date_sk| |date_dim.d_date_sk|)
                                  (== |store_sales.ss_store_sk| |store.s_store_sk|))
                                (== |store_sales.ss_hdemo_sk| |household_demographics.hd_demo_sk|))
                              (<= 1 |date_dim.d_dom|))
                            (<= |date_dim.d_dom| 2))
                          (|| (== |household_demographics.hd_buy_potential| ">10000")
                            (== |household_demographics.hd_buy_potential| "Unknown")))
                        (> |household_demographics.hd_vehicle_count| 0))
                      (> (if
                          (> |household_demographics.hd_vehicle_count| 0)
                          (/ |household_demographics.hd_dep_count| |household_demographics.hd_vehicle_count|)
                          (call qdb_sql_null))
                        1))
                    (|| (|| (== |date_dim.d_year| 1998) (== |date_dim.d_year| (+ 1998 1)))
                      (== |date_dim.d_year| (+ 1998 2))))
                  (|| (|| (|| (== |store.s_county| "Williamson County") (== |store.s_county| "Williamson County"))
                      (== |store.s_county| "Williamson County"))
                    (== |store.s_county| "Williamson County"))))
              (keys ss_ticket_number ss_customer_sk)
              (agg count_0 count))
            (ss_ticket_number ss_ticket_number)
            (ss_customer_sk ss_customer_sk)
            (cnt count_0))
          (|dj.ss_ticket_number| ss_ticket_number)
          (|dj.ss_customer_sk| ss_customer_sk)
          (|dj.cnt| cnt))
        (rel source "customer")
        ()
        (inner))
      (&& (&& (== ss_customer_sk c_customer_sk) (<= 1 cnt)) (<= cnt 5)))
    (c_last_name c_last_name)
    (c_first_name c_first_name)
    (c_salutation c_salutation)
    (c_preferred_cust_flag c_preferred_cust_flag)
    (ss_ticket_number ss_ticket_number)
    (cnt cnt))
  (cnt desc nulls-default)
  (c_last_name asc nulls-default))
