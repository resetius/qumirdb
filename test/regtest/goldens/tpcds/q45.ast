(query
  (select
    (select-list
      (item
        ca_zip
      )
      (item
        ca_county
      )
      (item
        (call sum ws_sales_price)
      )
    )
    (from
      (table web_sales)
      (table customer)
      (table customer_address)
      (table date_dim)
      (table item)
    )
    (where
      (&& (&& (&& (&& (&& (&& (== ws_bill_customer_sk c_customer_sk) (== c_current_addr_sk ca_address_sk)) (== ws_item_sk i_item_sk))
              (|| (|| (|| (|| (|| (|| (|| (|| (|| (== (call substr ca_zip 1 5) (: (cast "85669" <named StringView>) <named StringView>))
                                (== (call substr ca_zip 1 5) (: (cast "86197" <named StringView>) <named StringView>)))
                              (== (call substr ca_zip 1 5) (: (cast "88274" <named StringView>) <named StringView>)))
                            (== (call substr ca_zip 1 5) (: (cast "83405" <named StringView>) <named StringView>)))
                          (== (call substr ca_zip 1 5) (: (cast "86475" <named StringView>) <named StringView>)))
                        (== (call substr ca_zip 1 5) (: (cast "85392" <named StringView>) <named StringView>)))
                      (== (call substr ca_zip 1 5) (: (cast "85460" <named StringView>) <named StringView>)))
                    (== (call substr ca_zip 1 5) (: (cast "80348" <named StringView>) <named StringView>)))
                  (== (call substr ca_zip 1 5) (: (cast "81792" <named StringView>) <named StringView>)))
                (subquery in i_item_id (query
        (select
          (select-list
            (item
              i_item_id
            )
          )
          (from
            (table item)
          )
          (where
            (|| (|| (|| (|| (|| (|| (|| (|| (|| (== i_item_sk 2) (== i_item_sk 3)) (== i_item_sk 5)) (== i_item_sk 7)) (== i_item_sk 11))
                      (== i_item_sk 13))
                    (== i_item_sk 17))
                  (== i_item_sk 19))
                (== i_item_sk 23))
              (== i_item_sk 29))
          )
        )
      )
      )))
            (== ws_sold_date_sk d_date_sk))
          (== d_qoy 2))
        (== d_year 2000))
    )
    (group-by
      ca_zip
      ca_county
    )
  )
  (order-by
    (order asc
      ca_zip
    )
    (order asc
      ca_county
    )
  )
  (limit
    100
  )
)
