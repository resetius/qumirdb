(query
  (with
    (cte year_total
      (query
        (union all
          (select
            (select-list
              (item as customer_id
                c_customer_id
              )
              (item as customer_first_name
                c_first_name
              )
              (item as customer_last_name
                c_last_name
              )
              (item as year
                d_year
              )
              (item as year_total
                (call max ss_net_paid)
              )
              (item as sale_type
                (: (cast "s" <named StringView>) <named StringView>)
              )
            )
            (from
              (table customer)
              (table store_sales)
              (table date_dim)
            )
            (where
              (&& (&& (== c_customer_sk ss_customer_sk) (== ss_sold_date_sk d_date_sk)) (call qdb_in_list d_year 2001 (+ 2001 1)))
            )
            (group-by
              c_customer_id
              c_first_name
              c_last_name
              d_year
            )
          )
          (select
            (select-list
              (item as customer_id
                c_customer_id
              )
              (item as customer_first_name
                c_first_name
              )
              (item as customer_last_name
                c_last_name
              )
              (item as year
                d_year
              )
              (item as year_total
                (call max ws_net_paid)
              )
              (item as sale_type
                (: (cast "w" <named StringView>) <named StringView>)
              )
            )
            (from
              (table customer)
              (table web_sales)
              (table date_dim)
            )
            (where
              (&& (&& (== c_customer_sk ws_bill_customer_sk) (== ws_sold_date_sk d_date_sk))
                (call qdb_in_list d_year 2001 (+ 2001 1)))
            )
            (group-by
              c_customer_id
              c_first_name
              c_last_name
              d_year
            )
          )
        )
      )
    )
  )
  (select
    (select-list
      (item
        |t_s_secyear.customer_id|
      )
      (item
        |t_s_secyear.customer_first_name|
      )
      (item
        |t_s_secyear.customer_last_name|
      )
    )
    (from
      (table year_total as t_s_firstyear)
      (table year_total as t_s_secyear)
      (table year_total as t_w_firstyear)
      (table year_total as t_w_secyear)
    )
    (where
      (&& (&& (&& (&& (&& (&& (&& (&& (&& (&& (&& (&& (&& (== |t_s_secyear.customer_id| |t_s_firstyear.customer_id|)
                                (== |t_s_firstyear.customer_id| |t_w_secyear.customer_id|))
                              (== |t_s_firstyear.customer_id| |t_w_firstyear.customer_id|))
                            (== |t_s_firstyear.sale_type| (: (cast "s" <named StringView>) <named StringView>)))
                          (== |t_w_firstyear.sale_type| (: (cast "w" <named StringView>) <named StringView>)))
                        (== |t_s_secyear.sale_type| (: (cast "s" <named StringView>) <named StringView>)))
                      (== |t_w_secyear.sale_type| (: (cast "w" <named StringView>) <named StringView>)))
                    (== |t_s_firstyear.year| 2001))
                  (== |t_s_secyear.year| (+ 2001 1)))
                (== |t_w_firstyear.year| 2001))
              (== |t_w_secyear.year| (+ 2001 1)))
            (> |t_s_firstyear.year_total| 0))
          (> |t_w_firstyear.year_total| 0))
        (> (if
            (call qdb_is_true (> |t_w_firstyear.year_total| 0))
            (/ |t_w_secyear.year_total| |t_w_firstyear.year_total|)
            (call qdb_sql_null))
          (if
            (call qdb_is_true (> |t_s_firstyear.year_total| 0))
            (/ |t_s_secyear.year_total| |t_s_firstyear.year_total|)
            (call qdb_sql_null))))
    )
  )
  (order-by
    (order asc
      2
    )
    (order asc
      1
    )
    (order asc
      3
    )
  )
  (limit
    100
  )
)
