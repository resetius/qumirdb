(rel sort
  (rel project
    (rel window
      (rel aggregate
        (rel filter
          (rel join
            (rel join (rel source "store_sales") (rel source "item") () (inner))
            (rel source "date_dim")
            ()
            (inner))
          (&& (&& (&& (&& (== ss_item_sk i_item_sk)
                  (|| (|| (== i_category (: (cast "Jewelry" <named StringView>) <named StringView>))
                      (== i_category (: (cast "Sports" <named StringView>) <named StringView>)))
                    (== i_category (: (cast "Books" <named StringView>) <named StringView>))))
                (== ss_sold_date_sk d_date_sk))
              (<= (: (cast (: (cast "2001-01-12" <named StringView>) <named StringView>) <named DATE>) <named DATE>)
                d_date))
            (<= d_date
              (+ (: (cast (: (cast "2001-01-12" <named StringView>) <named StringView>) <named DATE>) <named DATE>)
                (: 30 i32)))))
        (keys i_item_id i_item_desc i_category i_class i_current_price)
        (agg sum_0 sum ss_ext_sales_price)
        (agg sum_1 sum ss_ext_sales_price)
        (agg sum_2 sum ss_ext_sales_price))
      (partition i_class)
      (frame range (start unbounded-preceding) (end unbounded-following))
      (fn w_0 sum sum_2))
    (i_item_id i_item_id)
    (i_item_desc i_item_desc)
    (i_category i_category)
    (i_class i_class)
    (i_current_price i_current_price)
    (itemrevenue sum_0)
    (revenueratio (/ (* sum_1 100) w_0)))
  (i_category asc nulls-default)
  (i_class asc nulls-default)
  (i_item_id asc nulls-default)
  (i_item_desc asc nulls-default)
  (revenueratio asc nulls-default))
