(query
  (with
    (cte customer_total_return
      (query
        (select
          (select-list
            (item as ctr_customer_sk
              sr_customer_sk
            )
            (item as ctr_store_sk
              sr_store_sk
            )
            (item as ctr_total_return
              (call sum sr_fee)
            )
          )
          (from
            (table store_returns)
            (table date_dim)
          )
          (where
            (&& (== sr_returned_date_sk d_date_sk) (== d_year 2000))
          )
          (group-by
            sr_customer_sk
            sr_store_sk
          )
        )
      )
    )
  )
  (select
    (select-list
      (item
        c_customer_id
      )
    )
    (from
      (table customer_total_return as ctr1)
      (table store)
      (table customer)
    )
    (where
      (&& (&& (&& (> |ctr1.ctr_total_return|
              (subquery scalar (query
        (select
          (select-list
            (item
              (* (call avg ctr_total_return) 1.2)
            )
          )
          (from
            (table customer_total_return as ctr2)
          )
          (where
            (== |ctr1.ctr_store_sk| |ctr2.ctr_store_sk|)
          )
        )
      )
      ))
            (== s_store_sk |ctr1.ctr_store_sk|))
          (== s_state (: (cast "TN" <named StringView>) <named StringView>)))
        (== |ctr1.ctr_customer_sk| c_customer_sk))
    )
  )
  (order-by
    (order asc
      c_customer_id
    )
  )
  (limit
    100
  )
)
