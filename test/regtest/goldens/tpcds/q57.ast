(query
  (with
    (cte v1
      (query
        (select
          (select-list
            (item
              i_category
            )
            (item
              i_brand
            )
            (item
              cc_name
            )
            (item
              d_year
            )
            (item
              d_moy
            )
            (item as sum_sales
              (call sum cs_sales_price)
            )
            (item as avg_monthly_sales
              (window (call avg (call sum cs_sales_price)) (over (partition-by (block i_category i_brand cc_name d_year))))
            )
            (item as rn
              (window
                (call rank)
                (over
                  (partition-by
                    (block
                      i_category
                      i_brand
                      cc_name))
                  (order-by
                    (order asc
                      d_year)
                    (order asc
                      d_moy))))
            )
          )
          (from
            (table item)
            (table catalog_sales)
            (table date_dim)
            (table call_center)
          )
          (where
            (&& (&& (&& (== cs_item_sk i_item_sk) (== cs_sold_date_sk d_date_sk)) (== cc_call_center_sk cs_call_center_sk))
              (|| (|| (== d_year 2000) (&& (== d_year (- 2000 1)) (== d_moy 12))) (&& (== d_year (+ 2000 1)) (== d_moy 1))))
          )
          (group-by
            i_category
            i_brand
            cc_name
            d_year
            d_moy
          )
        )
      )
    )
    (cte v2
      (query
        (select
          (select-list
            (item
              |v1.cc_name|
            )
            (item
              |v1.d_year|
            )
            (item
              |v1.d_moy|
            )
            (item
              |v1.avg_monthly_sales|
            )
            (item
              |v1.sum_sales|
            )
            (item as psum
              |v1_lag.sum_sales|
            )
            (item as nsum
              |v1_lead.sum_sales|
            )
          )
          (from
            (table v1)
            (table v1 as v1_lag)
            (table v1 as v1_lead)
          )
          (where
            (&& (&& (&& (&& (&& (&& (&& (== |v1.i_category| |v1_lag.i_category|) (== |v1.i_category| |v1_lead.i_category|))
                        (== |v1.i_brand| |v1_lag.i_brand|))
                      (== |v1.i_brand| |v1_lead.i_brand|))
                    (== |v1.cc_name| |v1_lag.cc_name|))
                  (== |v1.cc_name| |v1_lead.cc_name|))
                (== |v1.rn| (+ |v1_lag.rn| 1)))
              (== |v1.rn| (- |v1_lead.rn| 1)))
          )
        )
      )
    )
  )
  (select
    (select-list
      (star *)
    )
    (from
      (table v2)
    )
    (where
      (&& (&& (== d_year 2000) (> avg_monthly_sales 0))
        (> (if
            (call qdb_is_true (> avg_monthly_sales 0))
            (/ (call abs (- sum_sales avg_monthly_sales)) avg_monthly_sales)
            (call qdb_sql_null))
          0.10000000000000001))
    )
  )
  (order-by
    (order asc
      (- sum_sales avg_monthly_sales)
    )
    (order asc
      nsum
    )
  )
  (limit
    100
  )
)
