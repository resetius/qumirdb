(rel limit
  (rel sort
    (rel project
      (rel aggregate
        (rel filter
          (rel join
            (rel join
              (rel join (rel source "catalog_sales") (rel source "customer") () (inner))
              (rel source "customer_address")
              ()
              (inner))
            (rel source "date_dim")
            ()
            (inner))
          (&& (&& (&& (&& (&& (== cs_bill_customer_sk c_customer_sk) (== c_current_addr_sk ca_address_sk))
                  (|| (|| (call
                        qdb_in_list
                        (call substr ca_zip 1 5)
                        (: (cast "85669" <named StringView>) <named StringView>)
                        (: (cast "86197" <named StringView>) <named StringView>)
                        (: (cast "88274" <named StringView>) <named StringView>)
                        (: (cast "83405" <named StringView>) <named StringView>)
                        (: (cast "86475" <named StringView>) <named StringView>)
                        (: (cast "85392" <named StringView>) <named StringView>)
                        (: (cast "85460" <named StringView>) <named StringView>)
                        (: (cast "80348" <named StringView>) <named StringView>)
                        (: (cast "81792" <named StringView>) <named StringView>))
                      (call
                        qdb_in_list
                        ca_state
                        (: (cast "CA" <named StringView>) <named StringView>)
                        (: (cast "WA" <named StringView>) <named StringView>)
                        (: (cast "GA" <named StringView>) <named StringView>)))
                    (> cs_sales_price 500)))
                (== cs_sold_date_sk d_date_sk))
              (== d_qoy 2))
            (== d_year 2000)))
        (keys ca_zip)
        (agg sum_0 sum cs_sales_price))
      (ca_zip ca_zip)
      (col1 sum_0))
    (ca_zip asc nulls-default))
  (limit 100))
