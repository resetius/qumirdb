(query
  (select
    (select-list
      (item
        i_item_id
      )
      (item
        s_state
      )
      (item as g_state
        (call grouping s_state)
      )
      (item as agg1
        (call avg ss_quantity)
      )
      (item as agg2
        (call avg ss_list_price)
      )
      (item as agg3
        (call avg ss_coupon_amt)
      )
      (item as agg4
        (call avg ss_sales_price)
      )
    )
    (from
      (table store_sales)
      (table customer_demographics)
      (table date_dim)
      (table store)
      (table item)
    )
    (where
      (&& (&& (&& (&& (&& (&& (&& (&& (== ss_sold_date_sk d_date_sk) (== ss_item_sk i_item_sk)) (== ss_store_sk s_store_sk))
                  (== ss_cdemo_sk cd_demo_sk))
                (== cd_gender (cast "F" <named StringView>)))
              (== cd_marital_status (cast "W" <named StringView>)))
            (== cd_education_status (cast "Primary" <named StringView>)))
          (== d_year 1998))
        (call
          qdb_in_list
          s_state
          (cast "TN" <named StringView>)
          (cast "TN" <named StringView>)
          (cast "TN" <named StringView>)
          (cast "TN" <named StringView>)
          (cast "TN" <named StringView>)
          (cast "TN" <named StringView>)))
    )
    (group-by
      (rollup
        (block
          i_item_id
          s_state)
      )
    )
  )
  (order-by
    (order asc
      i_item_id
    )
    (order asc
      s_state
    )
  )
  (limit
    100
  )
)
