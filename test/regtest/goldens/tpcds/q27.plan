(rel limit
  (rel sort
    (rel project
      (rel aggregate
        (rel project
          (rel filter
            (rel join
              (rel join
                (rel join
                  (rel join (rel source "store_sales") (rel source "customer_demographics") () (inner))
                  (rel source "date_dim")
                  ()
                  (inner))
                (rel source "store")
                ()
                (inner))
              (rel source "item")
              ()
              (inner))
            (&& (&& (&& (&& (&& (&& (&& (&& (== ss_sold_date_sk d_date_sk) (== ss_item_sk i_item_sk)) (== ss_store_sk s_store_sk))
                        (== ss_cdemo_sk cd_demo_sk))
                      (== cd_gender "F"))
                    (== cd_marital_status "W"))
                  (== cd_education_status "Primary"))
                (== d_year 1998))
              (|| (|| (|| (|| (|| (== s_state "TN") (== s_state "TN")) (== s_state "TN")) (== s_state "TN"))
                  (== s_state "TN"))
                (== s_state "TN"))))
          (gb_0 (call rollup i_item_id s_state))
          (ss_quantity ss_quantity)
          (ss_list_price ss_list_price)
          (ss_coupon_amt ss_coupon_amt)
          (ss_sales_price ss_sales_price))
        (keys gb_0)
        (agg sum_0 sum ss_quantity)
        (agg count_1 count)
        (agg sum_2 sum ss_list_price)
        (agg count_3 count)
        (agg sum_4 sum ss_coupon_amt)
        (agg count_5 count)
        (agg sum_6 sum ss_sales_price)
        (agg count_7 count))
      (i_item_id i_item_id)
      (s_state s_state)
      (g_state (call grouping s_state))
      (agg1 (/ sum_0 (cast count_1 f64)))
      (agg2 (/ sum_2 (cast count_3 f64)))
      (agg3 (/ sum_4 (cast count_5 f64)))
      (agg4 (/ sum_6 (cast count_7 f64))))
    (i_item_id asc nulls-default)
    (s_state asc nulls-default))
  (limit 100))
