(rel limit
  (rel sort
    (rel project
      (rel aggregate
        (rel project
          (rel filter
            (rel join
              (rel join (rel source "date_dim") (rel source "store_sales") () (inner))
              (rel source "store")
              ()
              (inner))
            (&& (&& (&& (== d_date_sk ss_sold_date_sk) (== s_store_sk ss_store_sk)) (== s_gmt_offset (- 5)))
              (== d_year 1998)))
          (s_store_name s_store_name)
          (s_store_id s_store_id)
          (arg_0 (if (== d_day_name "Sunday") ss_sales_price (call qdb_sql_null)))
          (arg_1 (if (== d_day_name "Monday") ss_sales_price (call qdb_sql_null)))
          (arg_2 (if (== d_day_name "Tuesday") ss_sales_price (call qdb_sql_null)))
          (arg_3 (if (== d_day_name "Wednesday") ss_sales_price (call qdb_sql_null)))
          (arg_4 (if (== d_day_name "Thursday") ss_sales_price (call qdb_sql_null)))
          (arg_5 (if (== d_day_name "Friday") ss_sales_price (call qdb_sql_null)))
          (arg_6 (if (== d_day_name "Saturday") ss_sales_price (call qdb_sql_null))))
        (keys s_store_name s_store_id)
        (agg sum_0 sum arg_0)
        (agg sum_1 sum arg_1)
        (agg sum_2 sum arg_2)
        (agg sum_3 sum arg_3)
        (agg sum_4 sum arg_4)
        (agg sum_5 sum arg_5)
        (agg sum_6 sum arg_6))
      (s_store_name s_store_name)
      (s_store_id s_store_id)
      (sun_sales sum_0)
      (mon_sales sum_1)
      (tue_sales sum_2)
      (wed_sales sum_3)
      (thu_sales sum_4)
      (fri_sales sum_5)
      (sat_sales sum_6))
    (s_store_name asc nulls-default)
    (s_store_id asc nulls-default)
    (sun_sales asc nulls-default)
    (mon_sales asc nulls-default)
    (tue_sales asc nulls-default)
    (wed_sales asc nulls-default)
    (thu_sales asc nulls-default)
    (fri_sales asc nulls-default)
    (sat_sales asc nulls-default))
  (limit 100))
