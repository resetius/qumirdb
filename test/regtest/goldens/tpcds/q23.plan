(rel limit
  (rel project
    (rel aggregate
      (rel project
        (rel union-all
          (rel project
            (rel filter
              (rel join
                (rel join
                  (rel join (rel source "catalog_sales") (rel source "date_dim") () (inner))
                  (rel project
                    (rel project
                      (rel cte-ref 0)
                      (|frequent_ss_items.itemdesc| itemdesc)
                      (|frequent_ss_items.item_sk| item_sk)
                      (|frequent_ss_items.solddate| solddate)
                      (|frequent_ss_items.cnt| cnt))
                    (__qdb_in__item_sk item_sk))
                  ()
                  (left_semi)
                  (== cs_item_sk __qdb_in__item_sk))
                (rel project
                  (rel project
                    (rel cte-ref 2)
                    (|best_ss_customer.c_customer_sk| c_customer_sk)
                    (|best_ss_customer.ssales| ssales))
                  (__qdb_in__c_customer_sk c_customer_sk))
                ()
                (left_semi)
                (== cs_bill_customer_sk __qdb_in__c_customer_sk))
              (&& (&& (== d_year 1999) (== d_moy 1)) (== cs_sold_date_sk d_date_sk)))
            (sales (* cs_quantity cs_list_price)))
          (rel project
            (rel filter
              (rel join
                (rel join
                  (rel join (rel source "web_sales") (rel source "date_dim") () (inner))
                  (rel project
                    (rel project
                      (rel cte-ref 0)
                      (|frequent_ss_items.itemdesc| itemdesc)
                      (|frequent_ss_items.item_sk| item_sk)
                      (|frequent_ss_items.solddate| solddate)
                      (|frequent_ss_items.cnt| cnt))
                    (__qdb_in__item_sk item_sk))
                  ()
                  (left_semi)
                  (== ws_item_sk __qdb_in__item_sk))
                (rel project
                  (rel project
                    (rel cte-ref 2)
                    (|best_ss_customer.c_customer_sk| c_customer_sk)
                    (|best_ss_customer.ssales| ssales))
                  (__qdb_in__c_customer_sk c_customer_sk))
                ()
                (left_semi)
                (== ws_bill_customer_sk __qdb_in__c_customer_sk))
              (&& (&& (== d_year 1999) (== d_moy 1)) (== ws_sold_date_sk d_date_sk)))
            (sales (* ws_quantity ws_list_price))))
        (sales sales)
        (__group__ 1))
      (keys __group__)
      (agg sum_0 sum sales))
    (col0 sum_0))
  (limit 100))
