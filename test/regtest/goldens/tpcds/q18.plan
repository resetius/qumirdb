                  (== ca_state (: (cast "MS" <named StringView>) <named StringView>)))
                (== ca_state (: (cast "TN" <named StringView>) <named StringView>)))))
          (i_item_id i_item_id)
          (ca_country ca_country)
          (ca_state ca_state)
          (ca_county ca_county)
          (arg_0 (: (cast cs_quantity <named DECIMAL [12 2]>) <named DECIMAL [12 2]>))
          (arg_1 (: (cast cs_quantity <named DECIMAL [12 2]>) <named DECIMAL [12 2]>))
          (arg_2 (: (cast cs_list_price <named DECIMAL [12 2]>) <named DECIMAL [12 2]>))
