                            (== cs_bill_customer_sk c_customer_sk))
                          (== |cd1.cd_gender| (: (cast "M" <named StringView>) <named StringView>)))
                        (== |cd1.cd_education_status| (: (cast "College" <named StringView>) <named StringView>)))
                      (== c_current_cdemo_sk |cd2.cd_demo_sk|))
                    (== c_current_addr_sk ca_address_sk))
                  (|| (|| (|| (|| (|| (== c_birth_month 9) (== c_birth_month 5)) (== c_birth_month 12))
