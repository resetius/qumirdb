          (arg_13 (: (cast |cd1.cd_dep_count| <named DECIMAL [12 2]>) <named DECIMAL [12 2]>)))
        (keys i_item_id ca_country ca_state ca_county)
        (set i_item_id ca_country ca_state ca_county)
        (set i_item_id ca_country ca_state)
        (set i_item_id ca_country)
        (set i_item_id)
        (set)
        (agg sum_0 sum arg_0)
