(query
  (select
    (select-list
      (item
        i_item_desc
      )
      (item
        w_warehouse_name
      )
      (item
        |d1.d_week_seq|
      )
      (item as no_promo
        (call sum (if (call qdb_is_true (call qdb_is_null p_promo_sk)) 1 0))
      )
      (item as promo
        (call sum (if (call qdb_is_true (! (call qdb_is_null p_promo_sk))) 1 0))
      )
      (item as total_cnt
        (call count *)
      )
    )
    (from
      (join left
        (join left
          (join inner
            (join inner
              (join inner
                (join inner
                  (join inner
                    (join inner
                      (join inner
                        (join inner
                          (table catalog_sales)
                          (table inventory)
                          (on
                            (== cs_item_sk inv_item_sk)
                          )
                        )
                        (table warehouse)
                        (on
                          (== w_warehouse_sk inv_warehouse_sk)
                        )
                      )
                      (table item)
                      (on
                        (== i_item_sk cs_item_sk)
                      )
                    )
                    (table customer_demographics)
                    (on
                      (== cs_bill_cdemo_sk cd_demo_sk)
                    )
                  )
                  (table household_demographics)
                  (on
                    (== cs_bill_hdemo_sk hd_demo_sk)
                  )
                )
                (table date_dim as d1)
                (on
                  (== cs_sold_date_sk |d1.d_date_sk|)
                )
              )
              (table date_dim as d2)
              (on
                (== inv_date_sk |d2.d_date_sk|)
              )
            )
            (table date_dim as d3)
            (on
              (== cs_ship_date_sk |d3.d_date_sk|)
            )
          )
          (table promotion)
          (on
            (== cs_promo_sk p_promo_sk)
          )
        )
        (table catalog_returns)
        (on
          (&& (== cr_item_sk cs_item_sk) (== cr_order_number cs_order_number))
        )
      )
    )
    (where
      (&& (&& (&& (&& (&& (== |d1.d_week_seq| |d2.d_week_seq|) (< inv_quantity_on_hand cs_quantity))
              (> |d3.d_date| (+ |d1.d_date| 5)))
            (== hd_buy_potential (cast "1001-5000" <named StringView>)))
          (== |d1.d_year| 2001))
        (== cd_marital_status (cast "M" <named StringView>)))
    )
    (group-by
      i_item_desc
      w_warehouse_name
      |d1.d_week_seq|
    )
  )
  (order-by
    (order desc
      total_cnt
    )
    (order asc
      i_item_desc
    )
    (order asc
      w_warehouse_name
    )
    (order asc
      d_week_seq
    )
  )
  (limit
    100
  )
)
