(rel limit
  (rel sort
    (rel project
      (rel filter
        (rel aggregate
          (rel filter
            (rel join
              (rel join
                (rel join
                  (rel join
                    (rel join
                      (rel join (rel source "customer_address" "a") (rel source "customer" "c") () (inner))
                      (rel source "store_sales" "s")
                      ()
                      (inner))
                    (rel source "date_dim" "d")
                    ()
                    (inner))
                  (rel source "item" "i")
                  ()
                  (inner))
                (rel project
                  (rel aggregate
                    (rel project
                      (rel filter (rel source "date_dim") (&& (== d_year 2000) (== d_moy 2)))
                      (d_month_seq d_month_seq))
                    (keys d_month_seq))
                  (__scalar_0__ d_month_seq))
                ()
                (inner))
              (rel project
                (rel aggregate
                  (rel project
                    (rel filter (rel source "item" "j") (== |j.i_category| |i.i_category|))
                    (|j.i_current_price| |j.i_current_price|)
                    (__group__ 1))
                  (keys __group__)
                  (agg sum_0 sum |j.i_current_price|)
                  (agg count_1 count |j.i_current_price|))
                (__scalar_1__ (/ sum_0 (cast count_1 f64))))
              ()
              (inner))
            (&& (&& (&& (&& (&& (== |a.ca_address_sk| |c.c_current_addr_sk|) (== |c.c_customer_sk| |s.ss_customer_sk|))
                    (== |s.ss_sold_date_sk| |d.d_date_sk|))
                  (== |s.ss_item_sk| |i.i_item_sk|))
                (== |d.d_month_seq| __scalar_0__))
              (> |i.i_current_price| (* 1.2 __scalar_1__))))
          (keys |a.ca_state|)
          (agg count_0 count))
        (>= count_0 10))
      (state |a.ca_state|)
      (cnt count_0))
    (cnt asc nulls-default)
    (state asc nulls-default))
  (limit 100))
