(rel sort
  (rel project
    (rel aggregate
      (rel filter
        (rel join
          (rel join
            (rel source "item")
            (rel union-all
              (rel project
                (rel filter
                  (rel join (rel source "web_sales") (rel source "date_dim") () (inner))
                  (&& (&& (== d_date_sk ws_sold_date_sk) (== d_moy 12)) (== d_year 2000)))
                (ext_price ws_ext_sales_price)
                (sold_date_sk ws_sold_date_sk)
                (sold_item_sk ws_item_sk)
                (time_sk ws_sold_time_sk))
              (rel project
                (rel filter
                  (rel join (rel source "catalog_sales") (rel source "date_dim") () (inner))
                  (&& (&& (== d_date_sk cs_sold_date_sk) (== d_moy 12)) (== d_year 2000)))
                (ext_price cs_ext_sales_price)
                (sold_date_sk cs_sold_date_sk)
                (sold_item_sk cs_item_sk)
                (time_sk cs_sold_time_sk))
              (rel project
                (rel filter
                  (rel join (rel source "store_sales") (rel source "date_dim") () (inner))
                  (&& (&& (== d_date_sk ss_sold_date_sk) (== d_moy 12)) (== d_year 2000)))
                (ext_price ss_ext_sales_price)
                (sold_date_sk ss_sold_date_sk)
                (sold_item_sk ss_item_sk)
                (time_sk ss_sold_time_sk)))
            ()
            (inner))
          (rel source "time_dim")
          ()
          (inner))
        (&& (&& (&& (== sold_item_sk i_item_sk) (== i_manager_id 1)) (== time_sk t_time_sk))
          (|| (== t_meal_time "breakfast") (== t_meal_time "dinner"))))
      (keys i_brand i_brand_id t_hour t_minute)
      (agg sum_0 sum ext_price))
    (brand_id i_brand_id)
    (brand i_brand)
    (t_hour t_hour)
    (t_minute t_minute)
    (ext_price sum_0))
  (ext_price desc nulls-default)
  (brand_id asc nulls-default))
