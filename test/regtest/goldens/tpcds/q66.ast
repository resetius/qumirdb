                      (: (cast "," <named StringView>) <named StringView>))
                    (: (cast "AIRBORNE" <named StringView>) <named StringView>))
                )
                (item as year
                  d_year
                )
                (item as jan_sales
                  (call sum (if (call qdb_is_true (== d_moy 1)) (* ws_sales_price ws_quantity) 0))
