                  (call sum (if (call qdb_is_true (== d_moy 12)) (* ws_net_paid_inc_tax ws_quantity) 0))
                )
              )
              (from
                (table web_sales)
                (table warehouse)
                (table date_dim)
                (table time_dim)
                (table ship_mode)
              )
              (where
                (&& (&& (&& (&& (&& (&& (== ws_warehouse_sk w_warehouse_sk) (== ws_sold_date_sk d_date_sk)) (== ws_sold_time_sk t_time_sk))
                        (== ws_ship_mode_sk sm_ship_mode_sk))
                      (== d_year 2002))
                    (&& (<= 49530 t_time) (<= t_time (+ 49530 28800))))
                  (call
                    qdb_in_list
                    sm_carrier
                    (: (cast "DIAMOND" <named StringView>) <named StringView>)
                    (: (cast "AIRBORNE" <named StringView>) <named StringView>)))
              )
              (group-by
