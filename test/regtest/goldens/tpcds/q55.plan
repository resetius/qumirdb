(rel limit
  (rel sort
    (rel project
      (rel aggregate
        (rel filter
          (rel join
            (rel join (rel source "date_dim") (rel source "store_sales") () (inner))
            (rel source "item")
            ()
            (inner))
          (&& (&& (&& (&& (== d_date_sk ss_sold_date_sk) (== ss_item_sk i_item_sk)) (== i_manager_id 36)) (== d_moy 12))
            (== d_year 2001)))
        (keys i_brand i_brand_id)
        (agg sum_0 sum ss_ext_sales_price))
      (brand_id i_brand_id)
      (brand i_brand)
      (ext_price sum_0))
    (ext_price desc nulls-default)
    (brand_id asc nulls-default))
  (limit 100))
