(query
  (select
    (select-list
      (item
        c_last_name
      )
      (item
        c_first_name
      )
      (item
        c_salutation
      )
      (item
        c_preferred_cust_flag
      )
      (item
        ss_ticket_number
      )
      (item
        cnt
      )
    )
    (from
      (subquery-table as dn
        (query
          (select
            (select-list
              (item
                ss_ticket_number
              )
              (item
                ss_customer_sk
              )
              (item as cnt
                (call count *)
              )
            )
            (from
              (table store_sales)
              (table date_dim)
              (table store)
              (table household_demographics)
            )
            (where
              (&& (&& (&& (&& (&& (&& (&& (&& (== |store_sales.ss_sold_date_sk| |date_dim.d_date_sk|)
                              (== |store_sales.ss_store_sk| |store.s_store_sk|))
                            (== |store_sales.ss_hdemo_sk| |household_demographics.hd_demo_sk|))
                          (|| (&& (<= 1 |date_dim.d_dom|) (<= |date_dim.d_dom| 3))
                            (&& (<= 25 |date_dim.d_dom|) (<= |date_dim.d_dom| 28))))
                        (|| (== |household_demographics.hd_buy_potential| ">10000")
                          (== |household_demographics.hd_buy_potential| "Unknown")))
                      (> |household_demographics.hd_vehicle_count| 0))
                    (> (if
                        (> |household_demographics.hd_vehicle_count| 0)
                        (/ |household_demographics.hd_dep_count| |household_demographics.hd_vehicle_count|)
                        (call qdb_sql_null))
                      1.2))
                  (|| (|| (== |date_dim.d_year| 1998) (== |date_dim.d_year| (+ 1998 1))) (== |date_dim.d_year| (+ 1998 2))))
                (|| (|| (|| (|| (|| (|| (|| (== |store.s_county| "Williamson County") (== |store.s_county| "Williamson County"))
                            (== |store.s_county| "Williamson County"))
                          (== |store.s_county| "Williamson County"))
                        (== |store.s_county| "Williamson County"))
                      (== |store.s_county| "Williamson County"))
                    (== |store.s_county| "Williamson County"))
                  (== |store.s_county| "Williamson County")))
            )
            (group-by
              ss_ticket_number
              ss_customer_sk
            )
          )
        )
      )
      (table customer)
    )
    (where
      (&& (== ss_customer_sk c_customer_sk) (&& (<= 15 cnt) (<= cnt 20)))
    )
  )
  (order-by
    (order asc
      c_last_name
    )
    (order asc
      c_first_name
    )
    (order asc
      c_salutation
    )
    (order desc
      c_preferred_cust_flag
    )
    (order asc
      ss_ticket_number
    )
  )
)
