(rel limit
  (rel sort
    (rel project
      (rel filter
        (rel project
          (rel project
            (rel window
              (rel project
                (rel project
                  (rel join
                    (rel project
                      (rel cte-ref 0)
                      (|web.item_sk| item_sk)
                      (|web.d_date| d_date)
                      (|web.cume_sales| cume_sales))
                    (rel project
                      (rel cte-ref 1)
                      (|store.item_sk| item_sk)
                      (|store.d_date| d_date)
                      (|store.cume_sales| cume_sales))
                    ()
                    (full)
                    (&& (== |web.item_sk| |store.item_sk|) (== |web.d_date| |store.d_date|)))
                  (item_sk (if (call qdb_is_true (! (call qdb_is_null |web.item_sk|))) |web.item_sk| |store.item_sk|))
                  (d_date (if (call qdb_is_true (! (call qdb_is_null |web.d_date|))) |web.d_date| |store.d_date|))
                  (web_sales |web.cume_sales|)
                  (store_sales |store.cume_sales|))
                (|x.item_sk| item_sk)
                (|x.d_date| d_date)
                (|x.web_sales| web_sales)
                (|x.store_sales| store_sales))
              (partition item_sk)
              (order (d_date asc nulls-default))
              (frame rows (start unbounded-preceding) (end current-row))
              (fn w_0 max web_sales)
              (fn w_1 max store_sales))
            (item_sk item_sk)
            (d_date d_date)
            (web_sales web_sales)
            (store_sales store_sales)
            (web_cumulative w_0)
            (store_cumulative w_1))
          (|y.item_sk| item_sk)
          (|y.d_date| d_date)
          (|y.web_sales| web_sales)
          (|y.store_sales| store_sales)
          (|y.web_cumulative| web_cumulative)
          (|y.store_cumulative| store_cumulative))
        (> web_cumulative store_cumulative))
      (item_sk |y.item_sk|)
      (d_date |y.d_date|)
      (web_sales |y.web_sales|)
      (store_sales |y.store_sales|)
      (web_cumulative |y.web_cumulative|)
      (store_cumulative |y.store_cumulative|))
    (item_sk asc nulls-default)
    (d_date asc nulls-default))
  (limit 100))
