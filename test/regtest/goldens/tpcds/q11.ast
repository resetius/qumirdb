(query
  (with
    (cte year_total
      (query
        (unknown-body)
      )
    )
  )
  (select
    (select-list
      (item
        |t_s_secyear.customer_id|
      )
      (item
        |t_s_secyear.customer_first_name|
      )
      (item
        |t_s_secyear.customer_last_name|
      )
      (item
        |t_s_secyear.customer_email_address|
      )
    )
    (from
      (table year_total as t_s_firstyear)
      (table year_total as t_s_secyear)
      (table year_total as t_w_firstyear)
      (table year_total as t_w_secyear)
    )
    (where
      (&& (&& (&& (&& (&& (&& (&& (&& (&& (&& (&& (&& (&& (== |t_s_secyear.customer_id| |t_s_firstyear.customer_id|)
                                (== |t_s_firstyear.customer_id| |t_w_secyear.customer_id|))
                              (== |t_s_firstyear.customer_id| |t_w_firstyear.customer_id|))
                            (== |t_s_firstyear.sale_type| "s"))
                          (== |t_w_firstyear.sale_type| "w"))
                        (== |t_s_secyear.sale_type| "s"))
                      (== |t_w_secyear.sale_type| "w"))
                    (== |t_s_firstyear.dyear| 2001))
                  (== |t_s_secyear.dyear| (+ 2001 1)))
                (== |t_w_firstyear.dyear| 2001))
              (== |t_w_secyear.dyear| (+ 2001 1)))
            (> |t_s_firstyear.year_total| 0))
          (> |t_w_firstyear.year_total| 0))
        (> (if (> |t_w_firstyear.year_total| 0) (/ |t_w_secyear.year_total| |t_w_firstyear.year_total|) 0)
          (if (> |t_s_firstyear.year_total| 0) (/ |t_s_secyear.year_total| |t_s_firstyear.year_total|) 0)))
    )
  )
  (order-by
    (order asc
      |t_s_secyear.customer_id|
    )
    (order asc
      |t_s_secyear.customer_first_name|
    )
    (order asc
      |t_s_secyear.customer_last_name|
    )
    (order asc
      |t_s_secyear.customer_email_address|
    )
  )
  (limit
    100
  )
)
