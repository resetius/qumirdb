(query
  (select
    (select-list
      (item
        i_item_id
      )
      (item as agg1
        (call avg ss_quantity)
      )
      (item as agg2
        (call avg ss_list_price)
      )
      (item as agg3
        (call avg ss_coupon_amt)
      )
      (item as agg4
        (call avg ss_sales_price)
      )
    )
    (from
      (table store_sales)
      (table customer_demographics)
      (table date_dim)
      (table item)
      (table promotion)
    )
    (where
      (&& (&& (&& (&& (&& (&& (&& (&& (== ss_sold_date_sk d_date_sk) (== ss_item_sk i_item_sk)) (== ss_cdemo_sk cd_demo_sk))
                  (== ss_promo_sk p_promo_sk))
                (== cd_gender "F"))
              (== cd_marital_status "W"))
            (== cd_education_status "Primary"))
          (|| (== p_channel_email "N") (== p_channel_event "N")))
        (== d_year 1998))
    )
    (group-by
      i_item_id
    )
  )
  (order-by
    (order asc
      i_item_id
    )
  )
  (limit
    100
  )
)
