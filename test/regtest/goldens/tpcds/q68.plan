(rel limit
  (rel sort
    (rel project
      (rel filter
        (rel join
          (rel join
            (rel project
              (rel project
                (rel aggregate
                  (rel filter
                    (rel join
                      (rel join
                        (rel join
                          (rel join (rel source "store_sales") (rel source "date_dim") () (inner))
                          (rel source "store")
                          ()
                          (inner))
                        (rel source "household_demographics")
                        ()
                        (inner))
                      (rel source "customer_address")
                      ()
                      (inner))
                    (&& (&& (&& (&& (&& (&& (&& (&& (== |store_sales.ss_sold_date_sk| |date_dim.d_date_sk|)
                                    (== |store_sales.ss_store_sk| |store.s_store_sk|))
                                  (== |store_sales.ss_hdemo_sk| |household_demographics.hd_demo_sk|))
                                (== |store_sales.ss_addr_sk| |customer_address.ca_address_sk|))
                              (<= 1 |date_dim.d_dom|))
                            (<= |date_dim.d_dom| 2))
                          (|| (== |household_demographics.hd_dep_count| 5)
                            (== |household_demographics.hd_vehicle_count| 3)))
                        (call qdb_in_list |date_dim.d_year| 1999 (+ 1999 1) (+ 1999 2)))
                      (call
                        qdb_in_list
                        |store.s_city|
                        (: (cast "Midway" <named StringView>) <named StringView>)
                        (: (cast "Fairview" <named StringView>) <named StringView>))))
                  (keys ss_ticket_number ss_customer_sk ss_addr_sk ca_city)
                  (agg sum_0 sum ss_ext_sales_price)
                  (agg sum_1 sum ss_ext_list_price)
                  (agg sum_2 sum ss_ext_tax))
                (ss_ticket_number ss_ticket_number)
                (ss_customer_sk ss_customer_sk)
                (bought_city ca_city)
                (extended_price sum_0)
                (list_price sum_1)
                (extended_tax sum_2))
              (|dn.ss_ticket_number| ss_ticket_number)
              (|dn.ss_customer_sk| ss_customer_sk)
              (|dn.bought_city| bought_city)
              (|dn.extended_price| extended_price)
              (|dn.list_price| list_price)
              (|dn.extended_tax| extended_tax))
            (rel source "customer")
            ()
            (inner))
          (rel source "customer_address" "current_addr")
          ()
          (inner))
        (&& (&& (== ss_customer_sk c_customer_sk) (== |customer.c_current_addr_sk| |current_addr.ca_address_sk|))
          (!= |current_addr.ca_city| bought_city)))
      (c_last_name c_last_name)
      (c_first_name c_first_name)
      (ca_city ca_city)
      (bought_city bought_city)
      (ss_ticket_number ss_ticket_number)
      (extended_price extended_price)
      (extended_tax extended_tax)
      (list_price list_price))
    (c_last_name asc nulls-default)
    (ss_ticket_number asc nulls-default))
  (limit 100))
