(query
  (select distinct
    (select-list
      (item
        i_product_name
      )
    )
    (from
      (table item as i1)
    )
    (where
      (&& (&& (<= 742 i_manufact_id) (<= i_manufact_id (+ 742 40)))
        (> (subquery scalar (query
        (select
          (select-list
            (item as item_cnt
              (call count *)
            )
          )
          (from
            (table item)
          )
          (where
            (|| (&& (== i_manufact |i1.i_manufact|)
                (|| (|| (|| (&& (&& (&& (== i_category (cast "Women" <named StringView>))
                            (|| (== i_color (cast "orchid" <named StringView>)) (== i_color (cast "papaya" <named StringView>))))
                          (|| (== i_units (cast "Pound" <named StringView>)) (== i_units (cast "Lb" <named StringView>))))
                        (|| (== i_size (cast "petite" <named StringView>)) (== i_size (cast "medium" <named StringView>))))
                      (&& (&& (&& (== i_category (cast "Women" <named StringView>))
                            (|| (== i_color (cast "burlywood" <named StringView>)) (== i_color (cast "navy" <named StringView>))))
                          (|| (== i_units (cast "Bundle" <named StringView>)) (== i_units (cast "Each" <named StringView>))))
                        (|| (== i_size (cast "N/A" <named StringView>)) (== i_size (cast "extra large" <named StringView>)))))
                    (&& (&& (&& (== i_category (cast "Men" <named StringView>))
                          (|| (== i_color (cast "bisque" <named StringView>)) (== i_color (cast "azure" <named StringView>))))
                        (|| (== i_units (cast "N/A" <named StringView>)) (== i_units (cast "Tsp" <named StringView>))))
                      (|| (== i_size (cast "small" <named StringView>)) (== i_size (cast "large" <named StringView>)))))
                  (&& (&& (&& (== i_category (cast "Men" <named StringView>))
                        (|| (== i_color (cast "chocolate" <named StringView>)) (== i_color (cast "cornflower" <named StringView>))))
                      (|| (== i_units (cast "Bunch" <named StringView>)) (== i_units (cast "Gross" <named StringView>))))
                    (|| (== i_size (cast "petite" <named StringView>)) (== i_size (cast "medium" <named StringView>))))))
              (&& (== i_manufact |i1.i_manufact|)
                (|| (|| (|| (&& (&& (&& (== i_category (cast "Women" <named StringView>))
                            (|| (== i_color (cast "salmon" <named StringView>)) (== i_color (cast "midnight" <named StringView>))))
                          (|| (== i_units (cast "Oz" <named StringView>)) (== i_units (cast "Box" <named StringView>))))
                        (|| (== i_size (cast "petite" <named StringView>)) (== i_size (cast "medium" <named StringView>))))
                      (&& (&& (&& (== i_category (cast "Women" <named StringView>))
                            (|| (== i_color (cast "snow" <named StringView>)) (== i_color (cast "steel" <named StringView>))))
                          (|| (== i_units (cast "Carton" <named StringView>)) (== i_units (cast "Tbl" <named StringView>))))
                        (|| (== i_size (cast "N/A" <named StringView>)) (== i_size (cast "extra large" <named StringView>)))))
                    (&& (&& (&& (== i_category (cast "Men" <named StringView>))
                          (|| (== i_color (cast "purple" <named StringView>)) (== i_color (cast "gainsboro" <named StringView>))))
                        (|| (== i_units (cast "Dram" <named StringView>)) (== i_units (cast "Unknown" <named StringView>))))
                      (|| (== i_size (cast "small" <named StringView>)) (== i_size (cast "large" <named StringView>)))))
                  (&& (&& (&& (== i_category (cast "Men" <named StringView>))
                        (|| (== i_color (cast "metallic" <named StringView>)) (== i_color (cast "forest" <named StringView>))))
                      (|| (== i_units (cast "Gram" <named StringView>)) (== i_units (cast "Ounce" <named StringView>))))
                    (|| (== i_size (cast "petite" <named StringView>)) (== i_size (cast "medium" <named StringView>)))))))
          )
        )
      )
      )
          0))
    )
  )
  (order-by
    (order asc
      i_product_name
    )
  )
  (limit
    100
  )
)
