(query
  (select
    (select-list
      (item as brand_id
        i_brand_id
      )
      (item as brand
        i_brand
      )
      (item
        t_hour
      )
      (item
        t_minute
      )
      (item as ext_price
        (call sum ext_price)
      )
    )
    (from
      (table item)
      (subquery-table as tmp
        (query
          (unknown-body)
        )
      )
      (table time_dim)
    )
    (where
      (&& (&& (&& (== sold_item_sk i_item_sk) (== i_manager_id 1)) (== time_sk t_time_sk))
        (|| (== t_meal_time (: (cast "breakfast" <named StringView>) <named StringView>))
          (== t_meal_time (: (cast "dinner" <named StringView>) <named StringView>))))
    )
    (group-by
      i_brand
      i_brand_id
      t_hour
      t_minute
    )
  )
  (order-by
    (order desc
      ext_price
    )
    (order asc
      i_brand_id
    )
  )
)
