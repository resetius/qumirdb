(query
  (except distinct
    (select
      (select-list
        (item
          a
        )
      )
      (from
        (table t)
      )
    )
    (intersect distinct
      (select
        (select-list
          (item
            a
          )
        )
        (from
          (table s)
        )
      )
      (select
        (select-list
          (item
            a
          )
        )
        (from
          (table u)
        )
      )
    )
  )
)
