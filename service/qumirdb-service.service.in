[Unit]
Description=QumirDB workbench web service
After=network.target

[Service]
ExecStart=@CMAKE_INSTALL_PREFIX@/bin/qumirdb-service \
    --port 8081 \
    --static-dir @CMAKE_INSTALL_PREFIX@/share/qumirdb-service/static \
    --binary-dir @CMAKE_INSTALL_PREFIX@/@QDB_PRIVATE_BINDIR@ \
    --cache @QDB_DATA_DIR@/cache \
    --shared-links-dir @QDB_DATA_DIR@/shared \
    --data-dir @QDB_DATA_DIR@
User=qumirdb
Group=qumirdb
Restart=on-failure

[Install]
WantedBy=multi-user.target
