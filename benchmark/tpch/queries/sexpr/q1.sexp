(rel sort
  (rel project
    (rel aggregate
      (rel project
        (rel filter
          (rel source "__LINEITEM__")
          (: (<= l_shipdate (: __Q1_SHIPDATE_MAX__ i32)) u8))
        (l_returnflag    l_returnflag)
        (l_linestatus    l_linestatus)
        (l_quantity      l_quantity)
        (l_extendedprice l_extendedprice)
        (l_discount      l_discount)
        (disc_price (* l_extendedprice (- (: 1.0 f64) l_discount)))
        (charge     (* (* l_extendedprice (- (: 1.0 f64) l_discount))
                       (+ (: 1.0 f64) l_tax))))
      (keys l_returnflag l_linestatus)
      (agg sum_qty        sum l_quantity)
      (agg sum_base_price sum l_extendedprice)
      (agg sum_disc_price sum disc_price)
      (agg sum_charge     sum charge)
      (agg sum_disc       sum l_discount)
      (agg count_order    count))
    (l_returnflag    l_returnflag)
    (l_linestatus    l_linestatus)
    (sum_qty         sum_qty)
    (sum_base_price  sum_base_price)
    (sum_disc_price  sum_disc_price)
    (sum_charge      sum_charge)
    (avg_qty         (/ sum_qty        (cast count_order f64)))
    (avg_price       (/ sum_base_price (cast count_order f64)))
    (avg_disc        (/ sum_disc       (cast count_order f64)))
    (count_order     count_order))
  (l_returnflag asc nulls-default) (l_linestatus asc nulls-default))
